---
import Layout from '../layouts/Layout.astro';
import { BUSINESS_INFO } from '../data/business';

const title = "Wedding Car Rental Lahore - Luxury Cars & Guest Transport | 4WHEELS";
const description = "Book luxury wedding cars, groom cars, and guest transport coasters in Lahore with 4WHEELS. Audi A6, Fortuner, Civic, Corolla, and Toyota Coaster mini-buses.";
const canonicalPath = "/wedding-car-rental-lahore/";
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">
        Wedding & Event Fleet
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">
        Wedding Car Rental in Lahore
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-3xl mx-auto mb-6">
        Make your special day seamless and memorable. From executive groom sedans and decorated luxury cars to multi-vehicle guest transport coasters and venue shuttles.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={BUSINESS_INFO.whatsappLink} target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl transition-colors text-sm shadow-md">
          💬 Check Wedding Fleet Availability
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 space-y-10">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Wedding Fleet Solutions</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
          <div class="bg-white p-6 rounded-xl border border-slate-200">
            <h3 class="font-bold text-slate-900 text-base mb-1">🚘 Groom & Bridal Cars</h3>
            <p class="text-slate-600">Sleek executive sedans including Honda Civic, Toyota Corolla Grandi, and Audi A6 luxury options with professional chauffeurs.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-slate-200">
            <h3 class="font-bold text-slate-900 text-base mb-1">🚙 Family Motorcade SUVs</h3>
            <p class="text-slate-600">Commanding Toyota Fortuner SUVs for family processions, VIP guests, and baraat transport.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-slate-200">
            <h3 class="font-bold text-slate-900 text-base mb-1">🚌 Guest Coasters & Vans</h3>
            <p class="text-slate-600">22-29 seater Toyota Coaster buses and 13-seater HiAce vans to transport guests safely between venue, hotel, and home.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
