---
import Layout from '../../layouts/Layout.astro';
import { PAKISTAN_BRANDS } from '../../data/brands';
import { ALL_FLEET_VEHICLES, type UnifiedVehicle } from '../../data/unifiedFleet';
import { FUEL_DISCLAIMER_TEXT } from '../../data/rates';

const title = `4WHEELS Vehicle Fleet Directory - All ${ALL_FLEET_VEHICLES.length} Executive Cars, SUVs & Buses in Pakistan`;
const description = `Explore 4WHEELS Rent a Car complete vehicle fleet in Lahore. Browse all ${ALL_FLEET_VEHICLES.length} models across ${PAKISTAN_BRANDS.length} brands including Toyota, Honda, Kia, Hyundai, Mitsubishi, BYD, Haval, Suzuki, Changan, Audi, and luxury buses. Filter by color, fuel, seats, and book online.`;
const canonicalPath = "/fleet/";

const categories = [
  { key: 'all', label: `All Fleet (${ALL_FLEET_VEHICLES.length})` },
  { key: 'core', label: '4WHEELS Core Fleet' },
  { key: 'sedan', label: 'Sedans' },
  { key: 'suv', label: 'SUVs & 4x4' },
  { key: 'crossover', label: 'Crossovers' },
  { key: 'ev', label: 'Electric & Hybrid' },
  { key: 'hatchback', label: 'Hatchbacks' },
  { key: 'van', label: 'Vans & MPVs' },
  { key: 'bus', label: 'Coasters & Buses' },
  { key: 'luxury', label: 'Luxury VIP' }
];

const fuelTypes = ['All', 'Petrol', 'Diesel', 'Hybrid', 'Electric', 'PHEV'];
const transmissions = ['All', 'Automatic', 'Manual', 'Dual / CVT'];
const brandsList = ['All', ...PAKISTAN_BRANDS.map(b => b.name)];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Configurator Hero Header -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100/70 text-slate-900 py-12 md:py-16 border-b border-slate-200 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#0f172a_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block bg-red-600 text-white text-[11px] font-black px-3.5 py-1 rounded-full uppercase tracking-widest mb-3 shadow-xs">
        Pakistan's Premier Automotive Rental Directory
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-950 tracking-tight mb-3">
        4WHEELS Fleet & All Vehicle Models
      </h1>
      <p class="text-slate-600 text-sm md:text-base max-w-3xl mx-auto leading-relaxed mb-6 font-medium">
        Browse our comprehensive lineup of {ALL_FLEET_VEHICLES.length} verified executive sedans, luxury SUVs, hybrid crossovers, electric vehicles, and group coaches. Select your preferred color, transmission, and seating layout.
      </p>

      <div class="flex flex-wrap justify-center gap-3 md:gap-4 text-xs font-bold text-slate-700 mb-6">
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs">
          ⚡ <strong class="text-slate-900">{ALL_FLEET_VEHICLES.length} Models</strong> Available
        </span>
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs">
          🚗 <strong class="text-slate-900">{PAKISTAN_BRANDS.length} Official Brands</strong>
        </span>
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs">
          🎨 <strong class="text-slate-900">Multi-Color Variants</strong>
        </span>
        <span class="flex items-center gap-1.5 bg-white px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs">
          ✅ <strong class="text-slate-900">Self Drive & Chauffeur</strong>
        </span>
      </div>

      <!-- Fuel Fluctuation & Locked Rate Notice Banner -->
      <div class="max-w-3xl mx-auto bg-white border border-amber-300 rounded-2xl p-4 text-left flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-sm">
        <div class="flex items-start gap-3">
          <span class="text-xl">⛽</span>
          <div class="text-xs">
            <span class="font-black text-amber-700 uppercase tracking-wide block">Notice: Fuel & Petrol Rates Fluctuate Regularly</span>
            <p class="text-slate-600 mt-0.5 leading-relaxed font-medium">
              Rental rates shown are approximate base guidelines. Daily rental tariffs adjust with ongoing fuel market revisions. For today's exact locked quote, message customer care directly.
            </p>
          </div>
        </div>
        <a
          href="https://wa.me/923216616644?text=Assalam%20o%20Alaikum%204WHEELS,%20please%20send%20me%20today's%20latest%20exact%20locked%20rates%20for%20rental%20vehicles."
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs px-4 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-1.5 whitespace-nowrap active:scale-98"
        >
          <span>💬 Get Latest Rate on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <!-- STEP 1: BROWSE BY BRAND ACCORDION/GRID -->
  <section class="py-10 bg-white text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-slate-200 pb-4 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black text-red-600 uppercase tracking-widest block mb-1">Step 1 — Choose a Brand</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">Explore by Brand ({PAKISTAN_BRANDS.length} Brands in Pakistan)</h2>
        </div>
        <a href="#fleet-catalog-section" class="text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3.5 py-1.5 rounded-lg border border-slate-200 transition-colors">
          ↓ Skip to All Models Grid
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
        {PAKISTAN_BRANDS.map(brand => {
          const brandVehicles = ALL_FLEET_VEHICLES.filter(v => v.brandSlug.toLowerCase() === brand.slug.toLowerCase());
          return (
            <a
              href={`/vehicles/${brand.slug}/`}
              class="bg-slate-50/80 hover:bg-white rounded-xl p-3 border border-slate-200 hover:border-red-500 hover:shadow-md transition-all text-center flex flex-col items-center justify-center group hover:-translate-y-0.5"
            >
              <span class="text-xs font-black text-slate-900 group-hover:text-red-600 transition-colors block">
                {brand.name}
              </span>
              <span class="text-[10px] text-slate-500 font-medium mt-0.5 block">
                {brandVehicles.length} {brandVehicles.length === 1 ? 'Model' : 'Models'}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- STEP 2: MASTER CONFIGURATOR & ALL 39 VEHICLES GRID -->
  <section class="py-10 bg-slate-50/60 text-slate-900 min-h-screen" id="fleet-catalog-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Interactive Configurator Control Center -->
      <div class="bg-white rounded-3xl p-6 md:p-7 border border-slate-200/90 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.05)] mb-10 space-y-5">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between border-b border-slate-100 pb-4 gap-3">
          <div>
            <span class="text-xs font-black text-red-600 uppercase tracking-widest block mb-0.5">Step 2 — Filter & Configure</span>
            <h2 class="text-xl md:text-2xl font-black text-slate-950 flex items-center gap-2 tracking-tight">
              <span>All 39 Vehicle Models & Color Options</span>
            </h2>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg border border-emerald-200 shadow-xs" id="vehicle-count-display">
              39 of 39 Vehicles Displayed
            </span>
            <button
              type="button"
              id="reset-filters-btn"
              class="text-xs text-slate-500 hover:text-red-600 underline hidden font-bold"
            >
              Reset Filters
            </button>
          </div>
        </div>

        <!-- Live Instant Search Bar -->
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            🔍
          </span>
          <input
            type="text"
            id="fleet-search-input"
            placeholder="Search 39 models, brands, colors, or features (e.g., Prado, Fortuner, BYD Seal, Haval, White, Black, Hybrid, 7-seater)..."
            class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 pl-11 pr-4 text-sm text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-all font-semibold"
          />
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2" id="category-pills">
          {categories.map(cat => (
            <button
              type="button"
              class={`filter-cat-btn text-xs font-bold px-3.5 py-2 rounded-xl transition-all duration-200 border ${
                cat.key === 'all'
                  ? 'bg-red-600 text-white border-red-500 shadow-md font-black scale-105'
                  : 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200 hover:text-slate-900'
              }`}
              data-cat={cat.key}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Secondary Specs & Attributes Filters Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 pt-2 text-xs">
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Brand</label>
            <select id="filter-brand" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 font-bold focus:ring-1 focus:ring-red-500 focus:outline-none">
              {brandsList.map(b => <option value={b}>{b === 'All' ? 'All Brands (21)' : b}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Fuel / Powertrain</label>
            <select id="filter-fuel" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 font-bold focus:ring-1 focus:ring-red-500 focus:outline-none">
              {fuelTypes.map(f => <option value={f}>{f === 'All' ? 'All Fuel Types' : f}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Transmission</label>
            <select id="filter-transmission" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 font-bold focus:ring-1 focus:ring-red-500 focus:outline-none">
              {transmissions.map(t => <option value={t}>{t === 'All' ? 'All Transmissions' : t}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Rental Mode</label>
            <select id="filter-mode" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 font-bold focus:ring-1 focus:ring-red-500 focus:outline-none">
              <option value="All">All Rental Modes</option>
              <option value="Self Drive">Self Drive Available</option>
              <option value="With Driver">With Chauffeur Only</option>
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Passenger Capacity</label>
            <select id="filter-capacity" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 font-bold focus:ring-1 focus:ring-red-500 focus:outline-none">
              <option value="All">Any Seating Capacity</option>
              <option value="4">4-5 Seats (Sedan / Hatch)</option>
              <option value="7">7 Seats (SUV / MPV)</option>
              <option value="13">11-14 Seats (Van)</option>
              <option value="22">22-50 Seats (Bus / Coaster)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- MASTER VEHICLE CARDS GRID (ALL 39 VEHICLES) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fleet-grid">
        {ALL_FLEET_VEHICLES.map((vehicle, index) => {
          const isCoaster = vehicle.slug.includes('coaster') || vehicle.slug.includes('bus');
          const defaultColor = vehicle.colors[0]?.name || 'Standard';

          return (
            <div
              class={`vehicle-card bg-white rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl overflow-hidden flex flex-col justify-between relative ${
                vehicle.isCoreFleet ? 'border-slate-200/90 hover:border-red-500 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)]' : 'border-slate-200/90 hover:border-slate-400 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)]'
              }`}
              data-id={vehicle.id}
              data-slug={vehicle.slug}
              data-brand={vehicle.brand}
              data-brand-slug={vehicle.brandSlug}
              data-model={vehicle.model}
              data-variant={vehicle.variant}
              data-category={vehicle.category}
              data-is-core={vehicle.isCoreFleet ? 'true' : 'false'}
              data-fuel={vehicle.fuelType}
              data-transmission={vehicle.transmission}
              data-selfdrive={vehicle.selfDrive ? 'true' : 'false'}
              data-withdriver={vehicle.withDriver ? 'true' : 'false'}
              data-seats={vehicle.seats}
              data-price={vehicle.startingPricePkr}
              data-colors={vehicle.colors.map(c => c.name).join(',')}
            >
              <div>
                <!-- Vehicle Image Stage with Color Photo Switcher -->
                <div class="relative bg-gradient-to-b from-slate-50 via-white to-slate-100/60 border-b border-slate-200/80 aspect-[16/9] flex items-center justify-center p-3 overflow-hidden group">
                  <!-- Stage Floor Shadow -->
                  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[75%] h-3.5 bg-slate-900/10 blur-sm rounded-full pointer-events-none"></div>

                  <a href={vehicle.detailUrl} class="w-full h-full flex items-center justify-center">
                    <img
                      src={vehicle.heroImage}
                      alt={`${vehicle.brand} ${vehicle.model} ${vehicle.variant} - 4WHEELS Rent a Car Lahore`}
                      loading={index < 6 ? 'eager' : 'lazy'}
                      class="vehicle-main-img w-[88%] max-h-[85%] object-contain drop-shadow-[0_8px_16px_rgba(0,0,0,0.12)] transition-all duration-300 group-hover:scale-[1.03]"
                      data-default-src={vehicle.heroImage}
                    />
                  </a>

                  <!-- Top Left Badges -->
                  <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap z-20 pointer-events-none">
                    <span class="bg-white/95 border border-slate-200 text-slate-800 text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-wider backdrop-blur-sm shadow-xs">
                      {vehicle.category}
                    </span>
                    {vehicle.engineCc && (
                      <span class="bg-red-600 text-white text-[10px] font-black px-2 py-0.5 rounded tracking-wider shadow-xs">
                        {vehicle.engineCc}
                      </span>
                    )}
                  </div>

                  <!-- Top Right Dispatch Badge -->
                  <div class="absolute top-3 right-3 flex flex-col gap-1 items-end z-20 pointer-events-none">
                    {vehicle.isCoreFleet ? (
                      <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-xs flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-ping"></span>
                        Active Core Fleet
                      </span>
                    ) : (
                      <span class="bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
                        Catalog Model
                      </span>
                    )}
                  </div>

                  <!-- Quick Zoom/Click Tip -->
                  <div class="absolute bottom-1 right-2 z-20 pointer-events-none text-[9px] text-slate-400 bg-white/90 border border-slate-200 px-1.5 py-0.5 rounded">
                    Tap to view details
                  </div>
                </div>

                <!-- Card Body & Color Selector -->
                <div class="p-5 space-y-4">
                  <!-- Title Hierarchy -->
                  <div>
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-black text-red-600 uppercase tracking-widest">{vehicle.brand}</span>
                      <span class="text-[10px] font-semibold text-slate-500">{vehicle.modelYear}</span>
                    </div>
                    <a href={vehicle.detailUrl} class="hover:text-red-600 transition-colors block">
                      <h3 class="text-xl font-black text-slate-900 tracking-tight leading-snug">
                        {vehicle.model}
                      </h3>
                    </a>
                    <p class="text-xs font-semibold text-slate-500 mt-0.5 line-clamp-1">
                      {vehicle.variant}
                    </p>
                  </div>

                  <!-- INTERACTIVE COLOR SWATCHES SELECTOR -->
                  <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5 space-y-1.5">
                    <div class="flex items-center justify-between text-[11px]">
                      <span class="text-slate-500 font-bold uppercase tracking-wider text-[9px]">Verified Colors:</span>
                      <span class="text-slate-900 font-bold truncate max-w-[170px] color-indicator-label">
                        {defaultColor}
                      </span>
                    </div>

                    <div class="flex items-center gap-1.5 flex-wrap color-swatches-container">
                      {vehicle.colors.map((c, cIdx) => (
                        <button
                          type="button"
                          class={`color-swatch-btn w-6 h-6 rounded-full border transition-all duration-200 relative group/swatch ${
                            cIdx === 0
                              ? 'ring-2 ring-red-500 ring-offset-2 ring-offset-white scale-110'
                              : 'hover:scale-110 opacity-80 hover:opacity-100'
                          }`}
                          style={`background-color: ${c.hex}; border-color: ${c.border || '#cbd5e1'};`}
                          data-color-name={c.name}
                          data-color-image={c.imageUrl || vehicle.heroImage}
                          title={c.name}
                          aria-label={`Select ${c.name} color for ${vehicle.brand} ${vehicle.model}`}
                        >
                          <span class="sr-only">{c.name}</span>
                        </button>
                      ))}
                    </div>
                  </div>

                  <!-- Technical Specs Grid (Cockpit Instrument Cluster Style) -->
                  <div class="grid grid-cols-2 gap-2 text-xs font-semibold text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <div>
                      <span class="text-[10px] text-slate-400 uppercase font-bold block">Capacity</span>
                      <span class="text-slate-900 font-bold flex items-center gap-1">
                        👥 {vehicle.seats} Seats
                      </span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-400 uppercase font-bold block">Luggage</span>
                      <span class="text-slate-900 font-bold flex items-center gap-1">
                        🧳 {typeof vehicle.luggage === 'number' ? `${vehicle.luggage} Bags` : vehicle.luggage}
                      </span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-400 uppercase font-bold block">Transmission</span>
                      <span class="text-slate-900 font-bold truncate block">{vehicle.transmission}</span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-400 uppercase font-bold block">Powertrain</span>
                      <span class="text-slate-900 font-bold truncate block">{vehicle.fuelType}</span>
                    </div>
                  </div>

                </div>
              </div>

              <!-- Pricing & Action Buttons -->
              <div class="p-5 pt-0 border-t border-slate-100 mt-2 space-y-2">
                <!-- Starting Rate Badge with Fuel Volatility Indicator -->
                <div class="py-2 px-3 rounded-xl bg-emerald-50/70 border border-emerald-200 text-xs space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-slate-600 font-medium text-[11px]">Approx. Daily Rate:</span>
                    <span class="text-emerald-700 font-black text-sm">
                      PKR {vehicle.startingPricePkr.toLocaleString()}<span class="text-[10px] text-slate-500 font-normal">/day</span>
                    </span>
                  </div>
                  <div class="flex items-center justify-between text-[10px] text-amber-700 pt-0.5 border-t border-emerald-200/50">
                    <span class="truncate">⛽ Rates adjust with fuel</span>
                    <a
                      href={`https://wa.me/923216616644?text=${encodeURIComponent(`Assalam o Alaikum 4WHEELS, please share today's exact fuel-locked rate for ${vehicle.brand} ${vehicle.model} (${vehicle.modelYear}).`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-emerald-700 hover:text-emerald-800 font-bold underline shrink-0 ml-1"
                    >
                      Lock Rate on WA →
                    </a>
                  </div>
                </div>

                <!-- Book Your Trip CTA with Dynamic Color Query Param -->
                <a
                  href={`${vehicle.bookingUrl}&color=${encodeURIComponent(defaultColor)}`}
                  class="vehicle-booking-cta w-full bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm py-3 rounded-xl block text-center shadow-md transition-all flex items-center justify-center gap-2 active:scale-98"
                >
                  <span>BOOK YOUR TRIP</span>
                  <span>→</span>
                </a>

                <div class="grid grid-cols-2 gap-2">
                  <a
                    href={vehicle.detailUrl}
                    class="bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs py-2 rounded-xl text-center border border-slate-200 transition-colors block"
                  >
                    Specifications
                  </a>

                  <a
                    href="tel:+923216616644"
                    class="bg-slate-50 hover:bg-slate-100 text-emerald-700 font-bold text-xs py-2 rounded-xl text-center border border-slate-200 transition-colors block"
                  >
                    📞 0321 6616644
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- No Results State -->
      <div id="no-results-message" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 max-w-xl mx-auto my-8 p-8 space-y-4 shadow-sm">
        <div class="text-4xl">🔍</div>
        <h3 class="text-xl font-black text-slate-900">No Vehicles Match Your Filter</h3>
        <p class="text-xs text-slate-500 leading-relaxed font-medium">
          Try adjusting your search keywords, clear category pills, or reset the fuel/capacity filters to browse all vehicles.
        </p>
        <button
          type="button"
          id="clear-all-filters-btn"
          class="bg-red-600 hover:bg-red-700 text-white text-xs font-black px-5 py-2.5 rounded-xl shadow-md transition-all inline-block active:scale-98 uppercase"
        >
          Reset All Filters
        </button>
      </div>

      <!-- Live Johar Town Fleet Yard Gallery (Automotive White Theme) -->
      <div class="mt-16 bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.05)] space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-100 pb-5 gap-3">
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200 text-red-600 text-xs font-black mb-2">
              <span>📍 Physical Fleet & Showroom Verification</span>
            </div>
            <h3 class="text-2xl font-black text-slate-950 tracking-tight">
              Live From Our Johar Town Headquarters & Fleet Yard
            </h3>
