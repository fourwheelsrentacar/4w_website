<script>
  // Elements
  const catButtons = document.querySelectorAll('.filter-cat-btn');
  const searchInput = document.getElementById('fleet-search-input') as HTMLInputElement;
  const brandSelect = document.getElementById('filter-brand') as HTMLSelectElement;
  const fuelSelect = document.getElementById('filter-fuel') as HTMLSelectElement;
  const transSelect = document.getElementById('filter-transmission') as HTMLSelectElement;
  const modeSelect = document.getElementById('filter-mode') as HTMLSelectElement;
  const capacitySelect = document.getElementById('filter-capacity') as HTMLSelectElement;
  const vehicleCards = document.querySelectorAll('.vehicle-card');
  const countDisplay = document.getElementById('vehicle-count-display');
  const noResultsMsg = document.getElementById('no-results-message');
  const resetBtn = document.getElementById('reset-filters-btn');
  const clearAllBtn = document.getElementById('clear-all-filters-btn');

  let activeCat = 'all';

  const applyFilters = () => {
    const query = (searchInput?.value || '').trim().toLowerCase();
    const selectedBrand = brandSelect?.value || 'All';
    const selectedFuel = fuelSelect?.value || 'All';
    const selectedTrans = transSelect?.value || 'All';
    const selectedMode = modeSelect?.value || 'All';
    const selectedCapacity = capacitySelect?.value || 'All';

    let visibleCount = 0;

    vehicleCards.forEach(card => {
      const cardBrand = card.getAttribute('data-brand') || '';
      const cardModel = card.getAttribute('data-model') || '';
      const cardVariant = card.getAttribute('data-variant') || '';
      const cardCat = card.getAttribute('data-category') || '';
      const cardIsCore = card.getAttribute('data-is-core') === 'true';
      const cardFuel = card.getAttribute('data-fuel') || '';
      const cardTrans = card.getAttribute('data-transmission') || '';
      const cardSelfDrive = card.getAttribute('data-selfdrive') === 'true';
      const cardWithDriver = card.getAttribute('data-withdriver') === 'true';
      const cardSeats = parseInt(card.getAttribute('data-seats') || '5', 10);
      const cardColors = card.getAttribute('data-colors') || '';

      // 1. Text Search Filter (Model, Brand, Variant, Colors, Category)
      const searchableText = `${cardBrand} ${cardModel} ${cardVariant} ${cardCat} ${cardFuel} ${cardColors}`.toLowerCase();
      const matchesQuery = !query || searchableText.includes(query);

      // 2. Category Filter
      let matchesCat = true;
      if (activeCat === 'core') {
        matchesCat = cardIsCore;
      } else if (activeCat === 'ev') {
        matchesCat = ['ev', 'hybrid', 'phev'].includes(cardCat) || cardFuel.toLowerCase().includes('electric') || cardFuel.toLowerCase().includes('hybrid');
      } else if (activeCat === 'bus') {
        matchesCat = ['bus', 'coaster'].includes(cardCat);
      } else if (activeCat === 'luxury') {
        matchesCat = cardCat === 'luxury' || parseInt(card.getAttribute('data-price') || '0', 10) >= 25000;
      } else if (activeCat !== 'all') {
        matchesCat = cardCat === activeCat;
      }

      // 3. Brand Dropdown
      const matchesBrand = selectedBrand === 'All' || cardBrand.toLowerCase() === selectedBrand.toLowerCase();

      // 4. Fuel Dropdown
      const matchesFuel = selectedFuel === 'All' || cardFuel.toLowerCase().includes(selectedFuel.toLowerCase());

      // 5. Transmission Dropdown
      const matchesTrans = selectedTrans === 'All' || cardTrans.toLowerCase().includes(selectedTrans.toLowerCase());

      // 6. Rental Mode Dropdown
      let matchesMode = true;
      if (selectedMode === 'Self Drive') matchesMode = cardSelfDrive;
      if (selectedMode === 'With Driver') matchesMode = cardWithDriver;

      // 7. Capacity Dropdown
      let matchesCapacity = true;
      if (selectedCapacity === '4') matchesCapacity = cardSeats <= 5;
      if (selectedCapacity === '7') matchesCapacity = cardSeats === 7;
      if (selectedCapacity === '13') matchesCapacity = cardSeats >= 10 && cardSeats <= 15;
      if (selectedCapacity === '22') matchesCapacity = cardSeats >= 20;

      if (matchesQuery && matchesCat && matchesBrand && matchesFuel && matchesTrans && matchesMode && matchesCapacity) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    // Update Counter
    if (countDisplay) {
      countDisplay.textContent = `${visibleCount} of ${vehicleCards.length} Vehicles Displayed`;
    }

    // Toggle No Results Message
    if (noResultsMsg) {
      if (visibleCount === 0) {
        noResultsMsg.classList.remove('hidden');
      } else {
        noResultsMsg.classList.add('hidden');
      }
    }

    // Toggle Reset Button Visibility
    const isFiltered = query !== '' || activeCat !== 'all' || selectedBrand !== 'All' || selectedFuel !== 'All' || selectedTrans !== 'All' || selectedMode !== 'All' || selectedCapacity !== 'All';
    if (resetBtn) {
      if (isFiltered) {
        resetBtn.classList.remove('hidden');
      } else {
        resetBtn.classList.add('hidden');
      }
    }
  };

  // Reset Filters Function
  const resetAllFilters = () => {
    activeCat = 'all';
    if (searchInput) searchInput.value = '';
    if (brandSelect) brandSelect.value = 'All';
    if (fuelSelect) fuelSelect.value = 'All';
    if (transSelect) transSelect.value = 'All';
    if (modeSelect) modeSelect.value = 'All';
    if (capacitySelect) capacitySelect.value = 'All';

    catButtons.forEach(b => {
      b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
      b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      if (b.getAttribute('data-cat') === 'all') {
        b.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
        b.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
      }
    });

    applyFilters();
  };

  resetBtn?.addEventListener('click', resetAllFilters);
  clearAllBtn?.addEventListener('click', resetAllFilters);

  // Category Pill Buttons Event Listeners
  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat') || 'all';
      activeCat = cat;

      catButtons.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
        b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      });

      btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btn.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');

      applyFilters();
    });
  });

  // Event Listeners for Input & Select Controls
  searchInput?.addEventListener('input', applyFilters);
  brandSelect?.addEventListener('change', applyFilters);
  fuelSelect?.addEventListener('change', applyFilters);
  transSelect?.addEventListener('change', applyFilters);
  modeSelect?.addEventListener('change', applyFilters);
  capacitySelect?.addEventListener('change', applyFilters);

  // INTERACTIVE COLOR SWATCH PICKER LOGIC
  document.querySelectorAll('.vehicle-card').forEach(card => {
    const swatches = card.querySelectorAll('.color-swatch-btn');
    const label = card.querySelector('.color-indicator-label');
    const mainImg = card.querySelector('.vehicle-main-img') as HTMLImageElement;
    const cta = card.querySelector('.vehicle-booking-cta') as HTMLAnchorElement;

    swatches.forEach(swatch => {
      swatch.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const colorName = swatch.getAttribute('data-color-name') || '';
        const colorImg = swatch.getAttribute('data-color-image') || '';

        // 1. Update Active Ring Styling
        swatches.forEach(s => {
          s.classList.remove('ring-2', 'ring-red-500', 'ring-offset-2', 'ring-offset-slate-900', 'scale-110');
          s.classList.add('opacity-80');
        });
        swatch.classList.remove('opacity-80');
        swatch.classList.add('ring-2', 'ring-red-500', 'ring-offset-2', 'ring-offset-slate-900', 'scale-110');

        // 2. Update Color Name Display
        if (label) {
          label.textContent = colorName;
        }

        // 3. Update Vehicle Image if Dedicated Color Picture Exists
        if (mainImg && colorImg) {
          mainImg.style.opacity = '0.5';
          setTimeout(() => {
            mainImg.src = colorImg;
            mainImg.style.opacity = '1';
          }, 150);
        }

        // 4. Update Booking URL with Selected Color
        if (cta) {
          try {
            const currentUrl = new URL(cta.href, window.location.origin);
            currentUrl.searchParams.set('color', colorName);
            cta.href = currentUrl.pathname + currentUrl.search;
          } catch (err) {
            // fallback simple replace
            cta.href = cta.href.replace(/&color=[^&]*/, '') + `&color=${encodeURIComponent(colorName)}`;
          }
        }
      });
    });
  });

  // Auto-apply filters from URL Query (e.g. /fleet/?category=suv or /fleet/?brand=toyota)
  const urlParams = new URLSearchParams(window.location.search);
  const requestedCat = urlParams.get('category') || urlParams.get('cat');
  const requestedBrand = urlParams.get('brand');

  if (requestedCat) {
    const targetCat = requestedCat.toLowerCase();
    const matchingBtn = document.querySelector(`.filter-cat-btn[data-cat="${targetCat}"]`);
    if (matchingBtn) {
      activeCat = targetCat;
      catButtons.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
        b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      });
      matchingBtn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      matchingBtn.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
    }
  }

  if (requestedBrand && brandSelect) {
    brandSelect.value = requestedBrand;
  }

  applyFilters();
</script>
