---
import Layout from '../../layouts/Layout.astro';
import { FLEET_VEHICLES } from '../../data/fleet';
import { PAKISTAN_BRANDS } from '../../data/brands';
import { PAKISTAN_VEHICLE_CATALOG } from '../../data/pakistanVehicles';
import { FUEL_DISCLAIMER_TEXT } from '../../data/rates';
import VehicleImage from '../../components/VehicleImage.astro';

const title = "4WHEELS Vehicle Fleet Directory - Executive Cars, SUVs & Buses by Brand";
const description = "Explore 4WHEELS Rent a Car vehicle fleet in Lahore by brand. Browse Toyota, Honda, Kia, Hyundai, BYD, Suzuki, Changan, Audi, and more. Select a brand to view all models, seating, and luggage capacities.";
const canonicalPath = "/fleet/";

const categories = [
  { key: 'all', label: 'All Fleet' },
  { key: 'sedan', label: 'Sedans' },
  { key: 'suv', label: 'SUVs & 4x4' },
  { key: 'hatchback', label: 'Hatchbacks' },
  { key: 'van', label: 'Vans (13-Seater)' },
  { key: 'coaster', label: 'Coasters & Buses' },
  { key: 'luxury', label: 'Luxury Cars' }
];

const fuelTypes = ['All', 'Petrol', 'Diesel', 'Hybrid', 'Electric'];
const transmissions = ['All', 'Automatic', 'Manual'];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Configurator Hero Header -->
  <section class="bg-slate-900 text-white py-10 md:py-14 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e0121a_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block bg-red-600 text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-widest mb-3">
        Automotive Fleet & Brand Directory
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-3">
        4WHEELS Fleet & Vehicle Catalog
      </h1>
      <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto leading-relaxed mb-6">
        Select an official automobile brand below to explore all available rental models, seating diagrams, luggage fit specifications, and colors.
      </p>

      <div class="flex flex-wrap justify-center gap-4 text-xs font-bold text-slate-300">
        <span class="flex items-center gap-1.5 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">✅ Self Drive Available</span>
        <span class="flex items-center gap-1.5 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">✅ Professional Chauffeur Fleet</span>
        <span class="flex items-center gap-1.5 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">✅ 21 Verified Pakistan Brands</span>
      </div>
    </div>
  </section>

  <!-- BROWSE BY BRAND FIRST SECTION -->
  <section class="py-12 bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-slate-800 pb-4 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-extrabold text-red-500 uppercase tracking-widest block mb-1">Step 1 — Choose a Brand</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white">Explore Fleet by Brand ({PAKISTAN_BRANDS.length} Brands)</h2>
        </div>
        <span class="text-xs font-bold text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
          Click any brand to see all present models
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {PAKISTAN_BRANDS.map(brand => {
          const brandVehicles = PAKISTAN_VEHICLE_CATALOG.filter(v => v.brandSlug.toLowerCase() === brand.slug.toLowerCase());
          let sampleCar = brandVehicles[0];
          if (brand.slug === 'changan') {
            sampleCar = brandVehicles.find(v => v.slug === 'changan-karvaan') || brandVehicles[0];
          }
          if (!sampleCar) {
            sampleCar = FLEET_VEHICLES.find(v => v.manufacturer.toLowerCase() === brand.name.toLowerCase()) as any;
          }

          return (
            <a
              href={`/vehicles/${brand.slug}/`}
              class="bg-slate-900 rounded-2xl border border-slate-800 hover:border-red-600/80 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl overflow-hidden flex flex-col justify-between group"
            >
              <div>
                <!-- Brand Sample Car Visual Stage -->
                <div class="relative bg-slate-950 overflow-hidden">
                  {sampleCar ? (
                    <VehicleImage vehicle={sampleCar} showLabel={false} className="h-44 group-hover:scale-105 transition-transform duration-300" />
                  ) : (
                    <div class="h-44 flex items-center justify-center bg-slate-900 text-slate-500 text-xs font-bold">
                      {brand.name} Vehicle Fleet
                    </div>
                  )}

                  <div class="absolute top-3 left-3 bg-slate-950/90 border border-slate-800 text-slate-300 text-[10px] font-black px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm">
                    {brand.country}
                  </div>
                </div>

                <!-- Brand Card Body -->
                <div class="p-5 space-y-2">
                  <div class="flex items-center justify-between">
                    <h3 class="text-xl font-black text-white group-hover:text-red-500 transition-colors">
                      {brand.name}
                    </h3>
                    <span class="text-xs font-bold text-emerald-400 bg-emerald-950 border border-emerald-800 px-2 py-0.5 rounded">
                      {brandVehicles.length || 1} {brandVehicles.length === 1 ? 'Model' : 'Models'}
                    </span>
                  </div>
                  <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                    {brand.description || `Browse ${brand.name} models available through 4WHEELS Rent a Car Lahore.`}
                  </p>
                </div>
              </div>

              <div class="p-5 pt-0 border-t border-slate-800/80 mt-2 flex items-center justify-between text-xs font-bold text-red-500 group-hover:text-red-400">
                <span>View All {brand.name} Models</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Interactive Filter Bar & Grid -->
  <section class="py-10 bg-slate-950 text-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Filter Configurator Dashboard -->
      <div class="bg-slate-900 rounded-2xl p-5 border border-slate-800 shadow-xl mb-10 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h2 class="text-xs font-extrabold text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <span>⚡ Configurator Filters</span>
          </h2>
          <span class="text-xs text-slate-500" id="vehicle-count-display">{FLEET_VEHICLES.length} Vehicles Displayed</span>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2" id="category-pills">
          {categories.map(cat => (
            <button
              type="button"
              class={`filter-cat-btn text-xs font-bold px-4 py-2 rounded-xl transition-all duration-200 border ${
                cat.key === 'all'
                  ? 'bg-red-600 text-white border-red-500 shadow-md scale-105'
                  : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750 hover:text-white'
              }`}
              data-cat={cat.key}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Secondary Specs Filters -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 pt-2 text-xs">
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Fuel Type</label>
            <select id="filter-fuel" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-semibold focus:ring-1 focus:ring-red-500 focus:outline-none">
              {fuelTypes.map(f => <option value={f}>{f}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Transmission</label>
            <select id="filter-transmission" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-semibold focus:ring-1 focus:ring-red-500 focus:outline-none">
              {transmissions.map(t => <option value={t}>{t}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Rental Mode</label>
            <select id="filter-mode" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-semibold focus:ring-1 focus:ring-red-500 focus:outline-none">
              <option value="All">All Modes</option>
              <option value="Self Drive">Self Drive</option>
              <option value="With Driver">With Driver</option>
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Passenger Capacity</label>
            <select id="filter-capacity" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white font-semibold focus:ring-1 focus:ring-red-500 focus:outline-none">
              <option value="All">Any Capacity</option>
              <option value="4">Up to 4 Occupants</option>
              <option value="5">5 Passengers</option>
              <option value="7">7 Occupants (SUV)</option>
              <option value="13">13+ Group Transport</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Vehicle Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fleet-grid">
        {FLEET_VEHICLES.map(vehicle => {
          const isCoaster = vehicle.slug === 'toyota-coaster';

          return (
            <div
              class={`vehicle-card bg-slate-900 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-red-950/30 overflow-hidden flex flex-col justify-between relative cursor-pointer ${
                isCoaster ? 'border-amber-500/60 ring-1 ring-amber-500/30' : 'border-slate-800 hover:border-red-600/80'
              }`}
              data-category={vehicle.category}
              data-fuel={vehicle.fuelType || 'Petrol'}
              data-transmission={vehicle.transmission || 'Automatic'}
              data-selfdrive={vehicle.selfDrive ? 'true' : 'false'}
              data-withdriver={vehicle.withDriver ? 'true' : 'false'}
              data-seats={vehicle.seats || 5}
              onclick={`if (!event.target.closest('a')) window.location.href='/fleet/${vehicle.slug}/'`}
            >
              <div>
                <!-- Vehicle Stage using Reusable VehicleImage -->
                <a href={`/fleet/${vehicle.slug}/`} class="block relative group">
                  <VehicleImage vehicle={vehicle} showLabel={true} />

                  <!-- Badges Top Bar Overlay -->
                  <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap z-20">
                    <span class="bg-slate-900/90 border border-slate-700 text-white text-[10px] font-black px-2.5 py-1 rounded-md uppercase tracking-wider backdrop-blur-sm shadow-md">
                      {vehicle.category}
                    </span>
                    {vehicle.engineCc && (
                      <span class="bg-red-600/90 text-white text-[10px] font-black px-2.5 py-1 rounded-md tracking-wider backdrop-blur-sm shadow-md">
                        {vehicle.engineCc}
                      </span>
                    )}
                  </div>

                  <div class="absolute top-3 right-3 flex flex-col gap-1.5 items-end z-20">
                    {vehicle.featured && (
                      <span class="bg-amber-500 text-slate-950 text-[10px] font-extrabold px-2.5 py-1 rounded-md uppercase tracking-wider shadow-md">
                        POPULAR
                      </span>
                    )}
                  </div>

                  {isCoaster && (
                    <div class="absolute top-10 right-3 bg-amber-500/90 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded text-center uppercase tracking-wider z-20 shadow-md">
                      Customized 22-Seat Executive
                    </div>
                  )}
                </a>

                <!-- Card Content Details -->
                <div class="p-5 space-y-4">
                  <!-- Title & Variant Hierarchy -->
                  <div>
                    <div class="text-[10px] font-bold text-red-500 uppercase tracking-widest">{vehicle.manufacturer}</div>
                    <a href={`/fleet/${vehicle.slug}/`} class="hover:text-red-400 transition-colors">
                      <h3 class="text-xl font-extrabold text-white tracking-tight leading-snug">
                        {vehicle.model}
                      </h3>
                    </a>
                    {vehicle.variant && (
                      <p class="text-xs font-semibold text-slate-400 mt-0.5">
                        {vehicle.variant}
                      </p>
                    )}
                  </div>

                  <!-- Technical Specs Grid -->
                  <div class="grid grid-cols-2 gap-2 text-xs font-medium text-slate-300 bg-slate-950/70 p-3 rounded-xl border border-slate-800">
                    <div>
                      <span class="text-[10px] text-slate-500 uppercase font-bold block">Capacity</span>
                      <span class="text-white font-bold flex items-center gap-1">
                        👥 {vehicle.seats} Seats
                      </span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-500 uppercase font-bold block">Luggage</span>
                      <span class="text-white font-bold flex items-center gap-1">
                        🧳 {vehicle.luggage ? `Approx. ${vehicle.luggage} Bags` : 'Flexible'}
                      </span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-500 uppercase font-bold block">Transmission</span>
                      <span class="text-white font-bold">{vehicle.transmission || 'Automatic'}</span>
                    </div>

                    <div>
                      <span class="text-[10px] text-slate-500 uppercase font-bold block">Fuel System</span>
                      <span class="text-white font-bold">{vehicle.fuelType || 'Petrol'}</span>
                    </div>

                    {vehicle.fuelTankCapacity && (
                      <div>
                        <span class="text-[10px] text-slate-500 uppercase font-bold block">Fuel Tank</span>
                        <span class="text-white font-semibold">⛽ {vehicle.fuelTankCapacity}</span>
                      </div>
                    )}

                    {vehicle.batteryCapacity && (
                      <div>
                        <span class="text-[10px] text-slate-500 uppercase font-bold block">Battery</span>
                        <span class="text-white font-semibold">🔋 {vehicle.batteryCapacity}</span>
                      </div>
                    )}

                    {vehicle.fuelEconomyRealWorld && (
                      <div class="col-span-2 pt-1 border-t border-slate-800">
                        <span class="text-[10px] text-slate-500 uppercase font-bold block">Approx. Fuel Economy</span>
                        <span class="text-emerald-400 font-bold">{vehicle.fuelEconomyRealWorld}</span>
                      </div>
                    )}
                  </div>

                </div>
              </div>

              <!-- Pricing & Action Buttons -->
              <div class="p-5 pt-0 border-t border-slate-800/80 mt-2 space-y-2">
                {vehicle.startingPricePkr && (
                  <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-emerald-950/40 border border-emerald-900/50 text-xs">
                    <span class="text-slate-400 font-medium">Daily Rental From:</span>
                    <span class="text-emerald-400 font-black text-sm">PKR {vehicle.startingPricePkr.toLocaleString()}<span class="text-[10px] text-slate-400 font-normal">/day</span></span>
                  </div>
                )}
                <a
                  href={`/booking/?vehicle=${vehicle.slug}&brand=${encodeURIComponent(vehicle.manufacturer)}&model=${encodeURIComponent(vehicle.model)}&category=${vehicle.category}`}
                  class="w-full bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm py-3 rounded-xl block text-center shadow-lg transition-all flex items-center justify-center gap-2"
                >
                  <span>BOOK YOUR TRIP</span>
                  <span>→</span>
                </a>

                <a
                  href="tel:+923216616644"
                  class="w-full bg-slate-800 hover:bg-slate-750 text-slate-200 font-bold text-xs py-2.5 rounded-xl block text-center border border-slate-700 transition-colors flex items-center justify-center gap-1.5"
                >
                  <span>📞 CALL: 0321 6616644</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Fuel Disclaimer -->
      <div class="mt-12 bg-slate-900 border border-slate-800 rounded-2xl p-4 text-center text-slate-400 text-xs leading-relaxed max-w-3xl mx-auto">
        <p class="font-semibold text-slate-300 mb-1">ℹ️ Automotive Fuel Economy Disclaimer:</p>
        <p>{FUEL_DISCLAIMER_TEXT}</p>
        <p class="text-[11px] text-slate-500 mt-1">Illustrative vehicle visuals shown. Actual rental vehicle color and trim details may vary based on verified fleet inventory.</p>
      </div>

    </div>
  </section>
</Layout>

<script>
  const catButtons = document.querySelectorAll('.filter-cat-btn');
  const fuelSelect = document.getElementById('filter-fuel') as HTMLSelectElement;
  const transSelect = document.getElementById('filter-transmission') as HTMLSelectElement;
  const modeSelect = document.getElementById('filter-mode') as HTMLSelectElement;
  const capacitySelect = document.getElementById('filter-capacity') as HTMLSelectElement;
  const vehicleCards = document.querySelectorAll('.vehicle-card');
  const countDisplay = document.getElementById('vehicle-count-display');

  let activeCat = 'all';

  const applyFilters = () => {
    const selectedFuel = fuelSelect?.value || 'All';
    const selectedTrans = transSelect?.value || 'All';
    const selectedMode = modeSelect?.value || 'All';
    const selectedCapacity = capacitySelect?.value || 'All';

    let visibleCount = 0;

    vehicleCards.forEach(card => {
      const cardCat = card.getAttribute('data-category') || '';
      const cardFuel = card.getAttribute('data-fuel') || '';
      const cardTrans = card.getAttribute('data-transmission') || '';
      const cardSelfDrive = card.getAttribute('data-selfdrive') === 'true';
      const cardWithDriver = card.getAttribute('data-withdriver') === 'true';
      const cardSeats = parseInt(card.getAttribute('data-seats') || '5', 10);

      const matchesCat = activeCat === 'all' || cardCat === activeCat;
      const matchesFuel = selectedFuel === 'All' || cardFuel.toLowerCase() === selectedFuel.toLowerCase();
      const matchesTrans = selectedTrans === 'All' || cardTrans.toLowerCase().includes(selectedTrans.toLowerCase());

      let matchesMode = true;
      if (selectedMode === 'Self Drive') matchesMode = cardSelfDrive;
      if (selectedMode === 'With Driver') matchesMode = cardWithDriver;

      let matchesCapacity = true;
      if (selectedCapacity === '4') matchesCapacity = cardSeats <= 4;
      if (selectedCapacity === '5') matchesCapacity = cardSeats === 5;
      if (selectedCapacity === '7') matchesCapacity = cardSeats === 7;
      if (selectedCapacity === '13') matchesCapacity = cardSeats >= 13;

      if (matchesCat && matchesFuel && matchesTrans && matchesMode && matchesCapacity) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = `${visibleCount} Vehicle${visibleCount === 1 ? '' : 's'} Displayed`;
    }
  };

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat') || 'all';
      activeCat = cat;

      catButtons.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
        b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      });

      btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      btn.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');

      applyFilters();
    });
  });

  fuelSelect?.addEventListener('change', applyFilters);
  transSelect?.addEventListener('change', applyFilters);
  modeSelect?.addEventListener('change', applyFilters);
  capacitySelect?.addEventListener('change', applyFilters);

  // Auto-apply category filter from URL query params (e.g. /fleet/?category=sedan)
  const urlParams = new URLSearchParams(window.location.search);
  const requestedCat = urlParams.get('category') || urlParams.get('cat');
  if (requestedCat) {
    const targetCat = requestedCat.toLowerCase();
    const matchingBtn = document.querySelector(`.filter-cat-btn[data-cat="${targetCat}"]`);
    if (matchingBtn) {
      activeCat = targetCat;
      catButtons.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
        b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      });
      matchingBtn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
      matchingBtn.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
      applyFilters();
    }
  }
</script>
