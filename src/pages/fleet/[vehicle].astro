---
import Layout from '../../layouts/Layout.astro';
import { FLEET_VEHICLES, getVehicleBySlug } from '../../data/fleet';
import { BUSINESS_INFO } from '../../data/business';
import { FUEL_DISCLAIMER_TEXT } from '../../data/rates';
import VehicleImage from '../../components/VehicleImage.astro';
import VehicleSeatingDiagram from '../../components/VehicleSeatingDiagram.astro';
import InteractiveCoasterMap from '../../components/InteractiveCoasterMap.astro';

export function getStaticPaths() {
  return FLEET_VEHICLES.map(vehicle => ({
    params: { vehicle: vehicle.slug },
    props: { vehicle },
  }));
}

const { vehicle } = Astro.props;

if (!vehicle) {
  return Astro.redirect('/404');
}

const title = `${vehicle.manufacturer} ${vehicle.model} ${vehicle.variant ? vehicle.variant : ''} Rent in Lahore - 4WHEELS`;
const description = `Rent ${vehicle.manufacturer} ${vehicle.model} (${vehicle.engineCc || vehicle.engine}) in Lahore with 4WHEELS. Available with driver or self-drive. Seats: ${vehicle.seats || 'N/A'}, Luggage: ${vehicle.luggage || 'N/A'} bags. Contact via WhatsApp or call.`;
const canonicalPath = `/fleet/${vehicle.slug}/`;

const isCoaster = vehicle.slug === 'toyota-coaster';
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Breadcrumb -->
  <nav class="bg-slate-900 border-b border-slate-800 py-3 text-xs font-semibold text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-red-500">Home</a>
      <span>/</span>
      <a href="/fleet/" class="hover:text-red-500">Fleet</a>
      <span>/</span>
      <span class="text-white font-bold">{vehicle.manufacturer} {vehicle.model}</span>
    </div>
  </nav>

  <!-- Main Vehicle Detail Section -->
  <section class="py-10 bg-slate-950 text-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Left Column: Visual Stage & Detailed Specs -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Large Visual Display Stage -->
          <div class="relative group">
            <VehicleImage vehicle={vehicle} loading="eager" showLabel={true} className="h-80 sm:h-[420px]" />

            <div class="absolute top-4 left-4 flex gap-2 z-20">
              <span class="bg-slate-950/90 text-white border border-slate-700 text-xs font-black px-3 py-1.5 rounded-lg uppercase tracking-wider backdrop-blur-sm shadow-md">
                {vehicle.category}
              </span>
              {vehicle.engineCc && (
                <span class="bg-red-600 text-white text-xs font-black px-3 py-1.5 rounded-lg tracking-wider shadow-md">
                  {vehicle.engineCc}
                </span>
              )}
            </div>

            {isCoaster && (
              <div class="absolute top-4 right-4 bg-amber-500 text-slate-950 text-xs font-black px-3 py-1.5 rounded-lg text-center uppercase tracking-wider shadow-lg z-20">
                Customized 22-Seat Executive Configuration
              </div>
            )}
          </div>

          <!-- PASSENGERS & LUGGAGE DIAGRAM (Part B Visual System) -->
          {isCoaster ? (
            <InteractiveCoasterMap />
          ) : (
            <VehicleSeatingDiagram vehicleSlug={vehicle.slug} vehicleName={`${vehicle.manufacturer} ${vehicle.model}`} />
          )}

          <!-- Vehicle Overview & Description -->
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
            <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-3">Vehicle Overview</h2>
            <p class="text-slate-300 text-sm leading-relaxed">
              {vehicle.description}
            </p>

            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Suitable Trip Purpose</h3>
              <div class="flex flex-wrap gap-2">
                {vehicle.suitableFor.map(use => (
                  <span class="bg-slate-800 text-slate-200 border border-slate-700 text-xs font-semibold px-3 py-1 rounded-lg">
                    🎯 {use}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Official Manufacturer Reference Box -->
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <h3 class="text-sm font-extrabold text-white uppercase tracking-wider flex items-center gap-2">
                <span>⚙️ Official Manufacturer Technical Reference</span>
              </h3>
              <span class="text-[10px] font-bold bg-slate-800 text-slate-300 px-2.5 py-1 rounded border border-slate-700">
                Verified: {vehicle.lastVerifiedDate}
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1">
              <div>
                <span class="text-slate-400 font-medium block">Technical Reference Source:</span>
                <span class="font-bold text-white">{vehicle.officialSpecSource || `${vehicle.manufacturer} Pakistan`}</span>
              </div>
              <div>
                <span class="text-slate-400 font-medium block">Official Manufacturer Domain:</span>
                <span class="font-bold text-slate-200">{vehicle.manufacturer} Official Pakistan Distributor</span>
              </div>
            </div>

            {vehicle.officialManufacturerUrl && (
              <div class="pt-3">
                <a
                  href={vehicle.officialManufacturerUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-red-400 font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-700 transition-colors"
                >
                  <span>VIEW OFFICIAL {vehicle.manufacturer.toUpperCase()} MODEL DETAILS</span>
                  <span>↗</span>
                </a>
              </div>
            )}

            <p class="text-[11px] text-slate-500 pt-1 leading-relaxed italic border-t border-slate-800/80">
              "Manufacturer links are provided for technical reference. Vehicle availability through 4WHEELS is confirmed separately."
            </p>
          </div>
        </div>

        <!-- Right Column: Verification Specs & Primary CTAs -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 sticky top-24 space-y-6 shadow-xl">

            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-red-500">{vehicle.manufacturer}</span>
              <h1 class="text-3xl font-black text-white tracking-tight mt-0.5">
                {vehicle.model}
              </h1>
              {vehicle.variant && (
                <p class="text-xs font-bold text-slate-400 mt-1">{vehicle.variant}</p>
              )}
            </div>

            <!-- Detailed Specifications Grid -->
            <div class="space-y-3 bg-slate-950/80 p-4 rounded-xl border border-slate-800 text-xs">
              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Engine Displacement</span>
                <span class="font-extrabold text-white text-sm">{vehicle.engineCc || vehicle.engine || 'Verified Engine'}</span>
              </div>

              {vehicle.engineDescription && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Engine Type</span>
                  <span class="font-semibold text-slate-200 text-right max-w-[200px]">{vehicle.engineDescription}</span>
                </div>
              )}

              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Fuel Type</span>
                <span class="font-extrabold text-white">{vehicle.fuelType || 'Petrol'}</span>
              </div>

              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Transmission</span>
                <span class="font-extrabold text-white">{vehicle.transmission || 'Automatic'}</span>
              </div>

              {vehicle.fuelTankCapacity && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Fuel Tank Capacity</span>
                  <span class="font-bold text-emerald-400">⛽ {vehicle.fuelTankCapacity}</span>
                </div>
              )}

              {vehicle.batteryCapacity && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Battery Capacity</span>
                  <span class="font-bold text-sky-400">🔋 {vehicle.batteryCapacity}</span>
                </div>
              )}

              {vehicle.fuelEconomyRealWorld && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Approx. Real Fuel Economy</span>
                  <span class="font-bold text-emerald-400">{vehicle.fuelEconomyRealWorld}</span>
                </div>
              )}

              <!-- Passenger Visualization -->
              <div class="py-2 border-b border-slate-800/60">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-slate-400 font-medium">Passenger Occupancy</span>
                  <span class="font-extrabold text-white">Up to {vehicle.seats} Occupants</span>
                </div>
                <div class="text-base tracking-wider text-right">
                  {'👤 '.repeat(Math.min(vehicle.seats || 5, 10))}
                </div>
              </div>

              <!-- Luggage Visualization -->
              <div class="py-2">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-slate-400 font-medium">Luggage Baggage Fit</span>
                  <span class="font-extrabold text-white">Approx. {vehicle.luggage || 3} Standard Bags</span>
                </div>
                <div class="text-base tracking-wider text-right">
                  {'🧳 '.repeat(Math.min(vehicle.luggage || 3, 8))}
                </div>
                <p class="text-[10px] text-slate-500 mt-1 italic text-right">Approximate luggage fit. Actual capacity depends on bag dimensions.</p>
              </div>
            </div>

            <!-- PRIMARY CTAs -->
            <div class="space-y-3 pt-2">
              <a
                href={`/build-your-rental/?vehicle=${vehicle.slug}&brand=${encodeURIComponent(vehicle.manufacturer)}&model=${encodeURIComponent(vehicle.model)}&category=${vehicle.category}`}
                class="w-full bg-red-600 hover:bg-red-700 text-white font-extrabold text-base py-4 rounded-xl text-center block shadow-lg transition-all"
              >
                Book Your Trip
              </a>

              <a
                href="tel:+923216616644"
                class="w-full bg-slate-800 hover:bg-slate-750 text-slate-200 font-bold text-xs py-3 rounded-xl text-center block border border-slate-700 transition-colors"
              >
                📞 Call: 0321 6616644
              </a>
            </div>

            <!-- Disclaimer -->
            <div class="text-[11px] text-slate-500 leading-relaxed text-center space-y-1">
              <p>{FUEL_DISCLAIMER_TEXT}</p>
              <p class="text-[10px]">Illustrative vehicle visual shown. Actual rental vehicle color and trim may vary based on verified fleet inventory.</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
