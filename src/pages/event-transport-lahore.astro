---
import Layout from '../layouts/Layout.astro';
import { BUSINESS_INFO } from '../data/business';

const title = "Event Transport Lahore - Conferences, Exhibitions & Guest Shuttles | 4WHEELS";
const description = "Professional event transport management in Lahore. Corporate conferences, exhibitions, private functions, guest shuttle services, multi-vehicle fleets, and venue transfers.";
const canonicalPath = "/event-transport-lahore/";
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">
        Event Fleet Logistics
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">
        Event Transport Services in Lahore
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-3xl mx-auto mb-6">
        Complete transport coordination for corporate conferences, trade exhibitions, sport events, private celebrations, and VIP delegation movement across Lahore.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={BUSINESS_INFO.whatsappLink} target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl transition-colors text-sm shadow-md">
          💬 Plan Event Transport on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-5xl mx-auto px-4 space-y-8">
      <h2 class="text-2xl font-bold text-slate-900">Event Logistics Capabilities</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 text-base mb-2">🎪 Conference & Exhibition Logistics</h3>
          <p class="text-slate-600">Coordinate hotel-to-expo transfers for delegates, speakers, and event attendees using coordinated sedans, vans, and buses.</p>
        </div>
        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 text-base mb-2">🚌 Shuttles & Multi-Vehicle Fleets</h3>
          <p class="text-slate-600">Continuous venue shuttles and multi-car arrangements managed by punctual, experienced local chauffeurs.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
