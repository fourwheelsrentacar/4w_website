---
import SEOHead from '../../../components/SEOHead.astro';
import HeaderComp from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import { BUSINESS_INFO } from '../../../data/business';
import { PAKISTAN_VEHICLE_CATALOG, getCatalogVehiclesByBrand } from '../../../data/pakistanVehicles';

export function getStaticPaths() {
  const brands = Array.from(new Set(PAKISTAN_VEHICLE_CATALOG.map(v => v.brandSlug)));
  return brands.map(brandSlug => ({
    params: { brand: brandSlug }
  }));
}

const { brand } = Astro.params;
const brandVehicles = getCatalogVehiclesByBrand(brand || '');

if (!brandVehicles || brandVehicles.length === 0) {
  return Astro.redirect('/vehicles/');
}

const brandName = brandVehicles[0].brand;
const manufacturerUrl = brandVehicles[0].manufacturerUrl;
const canonicalUrl = `${BUSINESS_INFO.siteUrl}/vehicles/${brand}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={`${brandName} Rental Cars & Pakistan Catalog | 4WHEELS Lahore`}
    description={`Explore official ${brandName} vehicle models in Pakistan and 4WHEELS rental options in Lahore. View detailed specs, fuel tank capacity, seating, and WhatsApp booking.`}
    canonicalUrl={canonicalUrl}
  />
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
  <HeaderComp />

  <main>
    <!-- Breadcrumbs -->
    <nav class="bg-white border-b border-gray-200 py-3 px-4 sm:px-6 lg:px-8 text-xs text-gray-600">
      <div class="max-w-7xl mx-auto flex items-center gap-2">
        <a href="/" class="hover:text-brand-red">Home</a>
        <span>/</span>
        <a href="/vehicles/" class="hover:text-brand-red">Vehicles</a>
        <span>/</span>
        <span class="font-bold text-gray-900">{brandName}</span>
      </div>
    </nav>

    <!-- Brand Header -->
    <section class="bg-gradient-to-r from-gray-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-red bg-brand-red/20 border border-brand-red/30 px-3 py-1 rounded-full inline-block mb-2">
            Manufacturer Catalog
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold">{brandName} Vehicles in Pakistan</h1>
          <p class="text-gray-300 text-sm sm:text-base mt-2 max-w-2xl">
            Official vehicle lineup for {brandName} in Pakistan. Compare seating, boot capacity, fuel efficiency, and request rental options in Lahore through 4WHEELS.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur border border-white/20 p-4 rounded-xl text-xs flex flex-col gap-2">
          <span class="text-gray-300">Official Manufacturer Site:</span>
          <a
            href={manufacturerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white font-bold hover:underline flex items-center gap-1 text-sm"
          >
            Visit Official {brandName} Web Page ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Vehicles List -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Available {brandName} Models</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {brandVehicles.map(car => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow p-5">
            <div class="flex items-center justify-between mb-2">
              <span class={`text-xs font-bold px-2 py-0.5 rounded ${
                car.isFleetConfirmed
                  ? 'bg-green-50 text-green-700 border border-green-200'
                  : 'bg-blue-50 text-blue-700 border border-blue-200'
              }`}>
                {car.isFleetConfirmed ? '4WHEELS Core Fleet' : 'Request This Model'}
              </span>
              <span class="text-xs text-gray-500 font-medium">{car.bodyType}</span>
            </div>

            <h3 class="text-xl font-bold text-gray-900">{car.brand} {car.model}</h3>
            <p class="text-xs text-gray-600 mb-3">{car.variant}</p>
            <p class="text-xs text-gray-700 line-clamp-2 mb-4">{car.tagline}</p>

            <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 text-xs space-y-1 mb-4">
              <div class="flex justify-between">
                <span class="text-gray-500">Powertrain:</span>
                <span class="font-bold">{car.fuelType} ({car.engine || 'Electric'})</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">{car.fuelType === 'Electric' ? 'Battery / Range:' : 'Fuel Tank:'}</span>
                <span class="font-bold">
                  {car.fuelType === 'Electric' ? `${car.batteryCapacity} | ${car.electricRange}` : car.fuelTankCapacity}
                </span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">Seating Capacity:</span>
                <span class="font-bold">Up to {car.maxPassengers} occupants</span>
              </div>
            </div>

            <div class="flex gap-2">
              <a
                href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                class="flex-1 text-center text-xs font-bold bg-gray-100 hover:bg-gray-200 text-gray-800 py-2.5 rounded-lg transition-colors"
              >
                Full Specs & Details
              </a>
              <a
                href={`https://wa.me/923216616644?text=Hi%204WHEELS%2C%20I%20would%20like%20to%20check%20rental%20availability%20for%20${car.brand}%20${car.model}.`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center text-xs font-bold bg-green-600 hover:bg-green-700 text-white py-2.5 rounded-lg transition-colors"
              >
                Inquire WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</body>
</html>
