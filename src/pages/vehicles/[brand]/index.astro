---
import SEOHead from '../../../components/SEOHead.astro';
import HeaderComp from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import VehicleImage from '../../../components/VehicleImage.astro';
import { BUSINESS_INFO } from '../../../data/business';
import { PAKISTAN_BRANDS, getBrandBySlug } from '../../../data/brands';
import { PAKISTAN_VEHICLE_CATALOG, getCatalogVehiclesByBrand } from '../../../data/pakistanVehicles';

export function getStaticPaths() {
  return PAKISTAN_BRANDS.map(b => ({
    params: { brand: b.slug }
  }));
}

const { brand } = Astro.params;
const brandMeta = getBrandBySlug(brand || '');

if (!brandMeta) {
  return Astro.redirect('/vehicles/');
}

const brandVehicles = getCatalogVehiclesByBrand(brandMeta.slug);
const confirmedFleet = brandVehicles.filter(v => v.isFleetConfirmed);
const requestCatalog = brandVehicles.filter(v => !v.isFleetConfirmed);

const canonicalUrl = `${BUSINESS_INFO.siteUrl}/vehicles/${brandMeta.slug}/`;

const categories = Array.from(new Set(brandVehicles.map(v => v.category)));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${BUSINESS_INFO.siteUrl}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Vehicles",
      "item": `${BUSINESS_INFO.siteUrl}/vehicles/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": brandMeta.name,
      "item": canonicalUrl
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={`${brandMeta.name} Vehicles in Pakistan | Specs & Rental Requests | 4WHEELS`}
    description={`Explore official ${brandMeta.name} models sold in Pakistan (${confirmedFleet.length} core fleet available in Lahore, ${requestCatalog.length} request models). Specs, real photos, and WhatsApp booking.`}
    canonicalUrl={canonicalUrl}
  />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
  <HeaderComp />

  <main class="flex-grow">
    <!-- Breadcrumb Navigation -->
    <nav class="bg-slate-100/80 border-b border-slate-200 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-500">
      <div class="max-w-7xl mx-auto flex items-center gap-2">
        <a href="/" class="hover:text-red-600 transition-colors">Home</a>
        <span>/</span>
        <a href="/vehicles/" class="hover:text-red-600 transition-colors">Vehicles</a>
        <span>/</span>
        <span class="font-bold text-slate-900">{brandMeta.name}</span>
      </div>
    </nav>

    <!-- Brand Header Section -->
    <section class="bg-gradient-to-b from-slate-50 via-white to-slate-100/60 py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center gap-3">
            <span class="text-xs font-black uppercase tracking-widest text-red-600 bg-red-50 border border-red-200 px-3 py-1 rounded-full shadow-2xs">
              {brandMeta.country} Automotive
            </span>
            <span class="text-xs font-bold text-slate-500">
              Verified: {brandMeta.lastVerified}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
            {brandMeta.name} Vehicles in Pakistan
          </h1>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            {brandMeta.description || `Explore ${brandMeta.name} models available in Pakistan. Compare technical specifications, seating, boot space, and submit rental requests through 4WHEELS Rent a Car Lahore.`}
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-2">
            <span class="text-xs text-slate-500 font-semibold">Categories:</span>
            {brandMeta.categories.map(cat => (
              <span class="bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-md border border-slate-200 uppercase">
                {cat}
              </span>
            ))}
          </div>
        </div>

        <!-- Distributor Box -->
        <div class="bg-white border border-slate-200 p-5 rounded-2xl text-xs space-y-3 min-w-[280px] shadow-sm">
          <div class="border-b border-slate-200 pb-2">
            <span class="text-slate-500 font-medium block">Official Distributor / Assembly:</span>
            <span class="font-extrabold text-slate-900 text-sm">{brandMeta.distributor || `${brandMeta.name} Pakistan`}</span>
          </div>

          <div class="pt-1">
            <a
              href={brandMeta.officialPakistanSource}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-red-600 font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-200 transition-colors w-full justify-center shadow-2xs"
            >
              <span>Visit Official {brandMeta.name} Website</span>
              <span>↗</span>
            </a>
          </div>

          <p class="text-[10px] text-slate-500 italic text-center leading-tight">
            Independent rental service. Trademarks belong to official distributors.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 1: Confirmed 4WHEELS Core Fleet Vehicles -->
    {confirmedFleet.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="border-b border-slate-200 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded shadow-2xs">
              AVAILABLE THROUGH 4WHEELS
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">
            Confirmed 4WHEELS Fleet Units ({confirmedFleet.length})
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Physical vehicles maintained in 4WHEELS active inventory in Lahore with verified photos and immediate booking options.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {confirmedFleet.map(car => (
            <div
              class="bg-white rounded-2xl border border-slate-200 hover:border-red-500 overflow-hidden transition-all shadow-xs hover:shadow-md flex flex-col justify-between cursor-pointer group"
              onclick={`if (!event.target.closest('a')) window.location.href='/vehicles/${car.brandSlug}/${car.slug}/'`}
            >
              <div>
                <VehicleImage vehicle={car} loading="eager" showLabel={true} className="h-52 group-hover:scale-105 transition-transform duration-300" />

                <div class="p-5 space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded shadow-2xs">
                      ✓ AVAILABLE THROUGH 4WHEELS
                    </span>
                    <span class="text-xs font-bold text-slate-500">{car.bodyType}</span>
                  </div>

                  <h3 class="text-xl font-black text-slate-900 group-hover:text-red-600 transition-colors">{car.brand} {car.model}</h3>
                  <p class="text-xs font-semibold text-slate-500">{car.variant}</p>
                  <p class="text-xs text-slate-600 line-clamp-2">{car.tagline}</p>

                  <div class="bg-slate-50 rounded-xl p-3 border border-slate-200 text-xs space-y-1.5">
                    <div class="flex justify-between">
                      <span class="text-slate-500">Powertrain:</span>
                      <span class="font-bold text-slate-900">{car.fuelType} ({car.engine || 'Verified Engine'})</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-500">Passengers / Luggage:</span>
                      <span class="font-bold text-slate-900">Up to {car.maxPassengers} Occupants | {car.bootCapacity || 'Trunk'}</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-5 pt-0 grid grid-cols-2 gap-2">
                <a
                  href={`/booking/?vehicle=${car.slug}&brand=${encodeURIComponent(car.brand)}&model=${encodeURIComponent(car.model)}&category=${car.category}`}
                  class="bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs py-3 rounded-xl text-center transition-colors shadow-sm"
                >
                  Book Your Trip
                </a>
                <a
                  href="tel:+923216616644"
                  class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-3 rounded-xl text-center border border-slate-200 transition-colors"
                >
                  📞 Call
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Section 2: Pakistan Request Catalog Models -->
    {requestCatalog.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="border-b border-slate-200 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-slate-400"></span>
            <span class="text-xs font-extrabold uppercase tracking-widest text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded">
              OTHER PAKISTAN MODELS YOU CAN REQUEST
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">
            {brandMeta.name} Pakistan Request Catalog ({requestCatalog.length})
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Officially introduced models in Pakistan. Select any car below to request customized rental availability through 4WHEELS.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {requestCatalog.map(car => (
            <div
              class="bg-white rounded-2xl border border-slate-200 hover:border-slate-400 overflow-hidden transition-all shadow-xs hover:shadow-md flex flex-col justify-between cursor-pointer group"
              onclick={`if (!event.target.closest('a')) window.location.href='/vehicles/${car.brandSlug}/${car.slug}/'`}
            >
              <div>
                <VehicleImage vehicle={car} loading="lazy" showLabel={true} className="h-52 group-hover:scale-105 transition-transform duration-300" />

                <div class="p-5 space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
                      REQUEST THIS MODEL
                    </span>
                    <span class="text-xs font-bold text-slate-500">{car.bodyType}</span>
                  </div>

                  <h3 class="text-xl font-black text-slate-900 group-hover:text-red-600 transition-colors">{car.brand} {car.model}</h3>
                  <p class="text-xs font-semibold text-slate-500">{car.variant}</p>
                  <p class="text-xs text-slate-600 line-clamp-2">{car.tagline}</p>

                  <div class="bg-slate-50 rounded-xl p-3 border border-slate-200 text-xs space-y-1.5">
                    <div class="flex justify-between">
                      <span class="text-slate-500">Powertrain:</span>
                      <span class="font-bold text-slate-900">{car.fuelType}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-500">{car.fuelType === 'Electric' ? 'Battery / Range:' : 'Fuel Tank / Spec:'}</span>
                      <span class="font-bold text-emerald-700">
                        {car.fuelType === 'Electric' ? `${car.batteryCapacity} | ${car.electricRange}` : car.fuelTankCapacity || car.engine}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-5 pt-0 grid grid-cols-2 gap-2">
                <a
                  href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                  class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-3 rounded-xl text-center border border-slate-200 transition-colors"
                >
                  View Specs
                </a>
                <a
                  href={`/booking/?vehicle=${car.slug}&brand=${encodeURIComponent(car.brand)}&model=${encodeURIComponent(car.model)}&category=${car.category}`}
                  class="bg-slate-900 hover:bg-red-600 text-white font-extrabold text-xs py-3 rounded-xl text-center transition-colors shadow-xs"
                >
                  Request Model
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 space-y-6 shadow-sm">
        <h2 class="text-2xl font-black text-slate-900">Frequently Asked Questions — {brandMeta.name} Rentals</h2>

        <div class="grid md:grid-cols-2 gap-6 text-sm text-slate-700">
          <div class="space-y-2">
            <h3 class="font-bold text-slate-900">Are all {brandMeta.name} models available for immediate rental in Lahore?</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Vehicles marked as <strong class="text-emerald-700">AVAILABLE THROUGH 4WHEELS</strong> belong to our active core fleet in Lahore. Models marked as <strong class="text-slate-800">REQUEST THIS MODEL</strong> are part of the official Pakistan catalog and can be arranged upon advance inquiry.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-slate-900">Can I rent {brandMeta.name} vehicles for northern area tours and long trips?</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Yes, 4WHEELS provides intercity and northern travel options across Pakistan with experienced drivers, full highway toll estimation, and well-maintained vehicles.
            </p>
          </div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</body>
</html>
