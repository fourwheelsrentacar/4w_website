---
import SEOHead from '../../../components/SEOHead.astro';
import HeaderComp from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import { BUSINESS_INFO } from '../../../data/business';
import { PAKISTAN_VEHICLE_CATALOG, getCatalogVehicleBySlug } from '../../../data/pakistanVehicles';
import { FUEL_DISCLAIMER_TEXT } from '../../../data/rates';
import { getVehicleVisualUrl } from '../../../utils/vehicleVisual';
import VehicleSeatingDiagram from '../../../components/VehicleSeatingDiagram.astro';

export function getStaticPaths() {
  return PAKISTAN_VEHICLE_CATALOG.map(v => ({
    params: { brand: v.brandSlug, model: v.slug }
  }));
}

const { brand, model } = Astro.params;
const car = getCatalogVehicleBySlug(brand || '', model || '');

if (!car) {
  return Astro.redirect('/vehicles/');
}

const canonicalUrl = `${BUSINESS_INFO.siteUrl}/vehicles/${car.brandSlug}/${car.slug}/`;
const visual = getVehicleVisualUrl(car);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={`${car.brand} ${car.model} Specifications & Rental Booking Lahore | 4WHEELS`}
    description={`Official specifications for ${car.brand} ${car.model} (${car.variant}). Check seats, fuel tank/battery capacity, luggage boot space, and book your rental in Lahore.`}
    canonicalUrl={canonicalUrl}
  />
</head>
<body class="bg-slate-950 text-white font-sans antialiased">
  <HeaderComp />

  <main>
    <!-- Breadcrumbs -->
    <nav class="bg-slate-900 border-b border-slate-800 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-400">
      <div class="max-w-7xl mx-auto flex items-center gap-2">
        <a href="/" class="hover:text-red-500">Home</a>
        <span>/</span>
        <a href="/vehicles/" class="hover:text-red-500">Vehicles</a>
        <span>/</span>
        <a href={`/vehicles/${car.brandSlug}/`} class="hover:text-red-500">{car.brand}</a>
        <span>/</span>
        <span class="font-bold text-white">{car.model}</span>
      </div>
    </nav>

    <!-- Main Detail Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Left Column: Illustration Stage & Specifications -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-slate-900 rounded-2xl border border-slate-800 h-80 sm:h-[400px] flex items-center justify-center p-6 relative group overflow-hidden">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px]"></div>

            <img
              src={visual.url}
              alt={`${car.brand} ${car.model}`}
              class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
            />

            <div class="absolute top-4 left-4 flex gap-2">
              <span class={`text-xs font-bold px-3 py-1.5 rounded-lg border uppercase tracking-wider backdrop-blur-sm ${
                car.isFleetConfirmed
                  ? 'bg-emerald-950/90 text-emerald-400 border-emerald-800'
                  : 'bg-slate-900/90 text-slate-200 border-slate-700'
              }`}>
                {car.isFleetConfirmed ? '4WHEELS Active Fleet' : 'Catalog Request Model'}
              </span>
            </div>
          </div>

          <!-- PASSENGERS & LUGGAGE DIAGRAM (Part B Visual System) -->
          <VehicleSeatingDiagram vehicleSlug={car.slug} vehicleName={`${car.brand} ${car.model}`} />

          <!-- Description Box -->
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
            <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-3">Model Description</h2>
            <p class="text-slate-300 text-sm leading-relaxed">{car.description}</p>

            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Suitable Trip Purpose:</h3>
              <div class="flex flex-wrap gap-2">
                {car.suitableUse.map(use => (
                  <span class="bg-slate-800 text-slate-200 border border-slate-700 text-xs font-semibold px-3 py-1 rounded-lg">
                    ✓ {use}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Official Manufacturer Reference Box -->
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <h3 class="text-sm font-extrabold text-white uppercase tracking-wider flex items-center gap-2">
                <span>⚙️ Official Manufacturer Technical Reference</span>
              </h3>
              <span class="text-[10px] font-bold bg-slate-800 text-slate-300 px-2.5 py-1 rounded border border-slate-700">
                Verified Spec
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1">
              <div>
                <span class="text-slate-400 font-medium block">Technical Reference Source:</span>
                <span class="font-bold text-white">{car.brand} Pakistan Official Reference</span>
              </div>
              <div>
                <span class="text-slate-400 font-medium block">Official Manufacturer Domain:</span>
                <span class="font-bold text-slate-200">{car.brand} Pakistan Network</span>
              </div>
            </div>

            {car.manufacturerUrl && (
              <div class="pt-3">
                <a
                  href={car.manufacturerUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-red-400 font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-700 transition-colors"
                >
                  <span>VIEW OFFICIAL {car.brand.toUpperCase()} MODEL DETAILS</span>
                  <span>↗</span>
                </a>
              </div>
            )}

            <p class="text-[11px] text-slate-500 pt-1 leading-relaxed italic border-t border-slate-800/80">
              "Manufacturer links are provided for technical reference. Vehicle availability through 4WHEELS is confirmed separately."
            </p>
          </div>
        </div>

        <!-- Right Column: Specs & CTAs -->
        <div class="lg:col-span-5">
          <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 sticky top-24 space-y-6 shadow-xl">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-red-500">{car.brand}</span>
              <h1 class="text-3xl font-black text-white tracking-tight mt-0.5">{car.model}</h1>
              <p class="text-xs font-bold text-slate-400 mt-1">{car.variant} ({car.modelYear || 'Official Lineup'})</p>
            </div>

            <div class="space-y-3 bg-slate-950/80 p-4 rounded-xl border border-slate-800 text-xs">
              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Transmission</span>
                <span class="font-extrabold text-white">{car.transmission}</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Powertrain</span>
                <span class="font-extrabold text-white">{car.fuelType}</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                <span class="text-slate-400 font-medium">Engine / Spec</span>
                <span class="font-bold text-white">{car.engine || 'Verified Manufacturer Spec'}</span>
              </div>
              {car.fuelTankCapacity && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Fuel Tank</span>
                  <span class="font-bold text-emerald-400">⛽ {car.fuelTankCapacity}</span>
                </div>
              )}
              {car.batteryCapacity && (
                <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
                  <span class="text-slate-400 font-medium">Battery Capacity</span>
                  <span class="font-bold text-sky-400">🔋 {car.batteryCapacity}</span>
                </div>
              )}

              <!-- Passenger Visualization -->
              <div class="py-2 border-b border-slate-800/60">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-slate-400 font-medium">Passenger Occupancy</span>
                  <span class="font-extrabold text-white">Up to {car.maxPassengers} Occupants</span>
                </div>
                <div class="text-base tracking-wider text-right">
                  {'👤 '.repeat(Math.min(car.seats, 10))}
                </div>
              </div>

              <!-- Luggage Visualization -->
              <div class="py-2">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-slate-400 font-medium">Luggage Boot Capacity</span>
                  <span class="font-extrabold text-white">{car.bootCapacity || 'Standard Luggage Trunk'}</span>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 italic text-right">Approximate luggage fit. Actual capacity depends on bag dimensions.</p>
              </div>
            </div>

            <!-- PRIMARY CTAs -->
            <div class="space-y-3 pt-2">
              <a
                href={`/build-your-rental/?vehicle=${car.slug}&brand=${encodeURIComponent(car.brand)}&model=${encodeURIComponent(car.model)}&category=${car.category}`}
                class="w-full bg-red-600 hover:bg-red-700 text-white font-extrabold text-base py-4 rounded-xl text-center block shadow-lg transition-all"
              >
                Book Your Trip
              </a>

              <a
                href="tel:+923216616644"
                class="w-full bg-slate-800 hover:bg-slate-750 text-slate-200 font-bold text-xs py-3 rounded-xl text-center block border border-slate-700 transition-colors"
              >
                📞 Call: 0321 6616644
              </a>
            </div>

            <div class="text-[11px] text-slate-500 leading-relaxed text-center space-y-1">
              <p>{FUEL_DISCLAIMER_TEXT}</p>
              <p class="text-[10px]">Illustrative vehicle visual shown. Actual rental vehicle color and trim may vary based on verified fleet inventory.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</body>
</html>
