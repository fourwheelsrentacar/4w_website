---
import SEOHead from '../../components/SEOHead.astro';
import HeaderComp from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import VehicleImage from '../../components/VehicleImage.astro';
import { BUSINESS_INFO } from '../../data/business';
import { PAKISTAN_BRANDS } from '../../data/brands';
import { PAKISTAN_VEHICLE_CATALOG } from '../../data/pakistanVehicles';

const canonicalUrl = `${BUSINESS_INFO.siteUrl}/vehicles/`;

const confirmedFleet = PAKISTAN_VEHICLE_CATALOG.filter(v => v.isFleetConfirmed);
const catalogVehicles = PAKISTAN_VEHICLE_CATALOG.filter(v => !v.isFleetConfirmed);

const directoryBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${BUSINESS_INFO.siteUrl}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Vehicles Directory",
      "item": canonicalUrl
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title="Pakistan Vehicle Directory & Brand Catalog | 4WHEELS Rent a Car"
    description="Explore Pakistan's complete automobile directory across 21 verified brands (Toyota, Honda, Kia, Hyundai, BYD, Haval, Deepal, MG, etc.). Compare specs and request rental cars in Lahore."
    canonicalUrl={canonicalUrl}
  />
  <script type="application/ld+json" set:html={JSON.stringify(directoryBreadcrumb)} />
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
  <HeaderComp />

  <main class="flex-grow">
    <!-- Breadcrumbs -->
    <nav class="bg-slate-100/80 border-b border-slate-200 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-500">
      <div class="max-w-7xl mx-auto flex items-center gap-2">
        <a href="/" class="hover:text-red-600 transition-colors">Home</a>
        <span>/</span>
        <span class="font-bold text-slate-900">Vehicles Directory</span>
      </div>
    </nav>

    <!-- Directory Hero Header -->
    <section class="bg-gradient-to-b from-slate-50 via-white to-slate-100/60 py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
      <div class="max-w-7xl mx-auto text-center space-y-4">
        <span class="text-xs font-black uppercase tracking-widest text-red-600 bg-red-50 border border-red-200 px-3.5 py-1.5 rounded-full inline-block shadow-2xs">
          Official Pakistan Vehicle Directory
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
          Explore Pakistan Vehicle Brands & <span class="text-red-600">Rental Catalog</span>
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mx-auto leading-relaxed">
          Browse active automotive manufacturers in Pakistan. Select a brand below to view available 4WHEELS core fleet vehicles alongside request-on-demand Pakistan catalog models.
        </p>

        <div class="pt-4 flex flex-wrap justify-center gap-3">
          <a
            href="/booking/"
            class="bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs px-5 py-3 rounded-xl transition-all shadow-md flex items-center gap-2"
          >
            🚘 Visual Vehicle Configurator
          </a>
          <a
            href="/trip-fit-planner/"
            class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs px-5 py-3 rounded-xl border border-slate-200 transition-colors flex items-center gap-2 shadow-2xs"
          >
            🧭 Find My Trip Fit Vehicle
          </a>
        </div>
      </div>
    </section>

    <!-- EXPLORE BY BRAND GRID -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="border-b border-slate-200 pb-4 mb-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Browse By Brand ({PAKISTAN_BRANDS.length})</h2>
          <p class="text-xs text-slate-500 mt-1">Select a brand landing page to explore dedicated models, specs, and rental request options.</p>
        </div>
        <span class="text-xs font-bold text-slate-700 bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-2xs">
          21 Active Pakistan Brands
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {PAKISTAN_BRANDS.map(brand => {
          const brandModelCount = PAKISTAN_VEHICLE_CATALOG.filter(v => v.brandSlug.toLowerCase() === brand.slug.toLowerCase()).length;
          return (
            <a
              href={`/vehicles/${brand.slug}/`}
              class="bg-white hover:bg-slate-50 border border-slate-200 hover:border-red-500 rounded-2xl p-5 text-center transition-all shadow-2xs hover:shadow-md group flex flex-col justify-between"
            >
              <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">{brand.country}</span>
                <h3 class="text-lg sm:text-xl font-black text-slate-900 group-hover:text-red-600 transition-colors">
                  {brand.name}
                </h3>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">{brandModelCount} {brandModelCount === 1 ? 'Model' : 'Models'}</span>
                <span class="text-red-600 font-extrabold group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ACTUAL 4WHEELS FLEET HIGHLIGHTS -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="border-b border-slate-200 pb-4 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded shadow-2xs">
            PHYSICAL LAHORE INVENTORY
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">
            Confirmed 4WHEELS Core Fleet Vehicles
          </h2>
        </div>
        <a href="/fleet/" class="text-xs font-bold text-red-600 hover:underline">
          View Dedicated Fleet Gallery →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {confirmedFleet.map(car => (
          <div
            class="bg-white rounded-2xl border border-slate-200 hover:border-red-500 overflow-hidden transition-all shadow-xs hover:shadow-md flex flex-col justify-between cursor-pointer group"
            onclick={`if (!event.target.closest('a')) window.location.href='/vehicles/${car.brandSlug}/${car.slug}/'`}
          >
            <div>
              <VehicleImage vehicle={car} loading="lazy" showLabel={true} className="h-48 group-hover:scale-105 transition-transform duration-300" />

              <div class="p-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded shadow-2xs">
                    ✓ AVAILABLE THROUGH 4WHEELS
                  </span>
                  <span class="text-xs font-bold text-slate-500">{car.bodyType}</span>
                </div>

                <h3 class="text-lg font-black text-slate-900 group-hover:text-red-600 transition-colors">{car.brand} {car.model}</h3>
                <p class="text-xs text-slate-500">{car.variant}</p>

                <div class="bg-slate-50 rounded-xl p-3 border border-slate-200 text-xs space-y-1">
                  <div class="flex justify-between">
                    <span class="text-slate-500">Powertrain:</span>
                    <span class="font-bold text-slate-900">{car.fuelType} ({car.engine || 'Spec'})</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-500">Max Capacity:</span>
                    <span class="font-bold text-slate-900">Up to {car.maxPassengers} Occupants</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-5 pt-0 grid grid-cols-2 gap-2">
              <a
                href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-2.5 rounded-xl text-center border border-slate-200 transition-colors"
              >
                Specs & Details
              </a>
              <a
                href={`/booking/?vehicle=${car.slug}&brand=${encodeURIComponent(car.brand)}&model=${encodeURIComponent(car.model)}&category=${car.category}`}
                class="bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs py-2.5 rounded-xl text-center transition-colors shadow-sm"
              >
                Book Your Trip
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PAKISTAN REQUEST CATALOG HIGHLIGHTS -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="border-b border-slate-200 pb-4 mb-6">
        <span class="text-xs font-extrabold uppercase tracking-widest text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded">
          PAKISTAN MARKET REQUEST CATALOG
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">
          Request Catalog Models ({catalogVehicles.length})
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Officially introduced models in Pakistan. Choose any model below to request customized availability through 4WHEELS.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {catalogVehicles.map(car => (
          <div
            class="bg-white rounded-2xl border border-slate-200 hover:border-slate-400 overflow-hidden transition-all shadow-xs hover:shadow-md flex flex-col justify-between cursor-pointer group"
            onclick={`if (!event.target.closest('a')) window.location.href='/vehicles/${car.brandSlug}/${car.slug}/'`}
          >
            <div>
              <VehicleImage vehicle={car} loading="lazy" showLabel={true} className="h-48 group-hover:scale-105 transition-transform duration-300" />

              <div class="p-5 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-black uppercase tracking-wider text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
                    REQUEST THIS MODEL
                  </span>
                  <span class="text-xs font-bold text-slate-500">{car.bodyType}</span>
                </div>

                <h3 class="text-lg font-black text-slate-900 group-hover:text-red-600 transition-colors">{car.brand} {car.model}</h3>
                <p class="text-xs text-slate-500">{car.variant}</p>

                <div class="bg-slate-50 rounded-xl p-3 border border-slate-200 text-xs space-y-1">
                  <div class="flex justify-between">
                    <span class="text-slate-500">Powertrain:</span>
                    <span class="font-bold text-slate-900">{car.fuelType}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-500">Range / Tank:</span>
                    <span class="font-bold text-emerald-700">{car.electricRange || car.fuelTankCapacity || car.engine}</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-5 pt-0 grid grid-cols-2 gap-2">
              <a
                href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-2.5 rounded-xl text-center border border-slate-200 transition-colors"
              >
                View Specs
              </a>
              <a
                href={`/booking/?vehicle=${car.slug}&brand=${encodeURIComponent(car.brand)}&model=${encodeURIComponent(car.model)}&category=${car.category}`}
                class="bg-slate-900 hover:bg-red-600 text-white font-extrabold text-xs py-2.5 rounded-xl text-center transition-colors shadow-xs"
              >
                Request Model
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TRADEMARK NOTICE -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="bg-slate-100/90 rounded-2xl p-5 text-xs text-slate-600 border border-slate-200 leading-relaxed shadow-2xs">
        <strong class="text-slate-900">Trademark & Technical Reference Notice:</strong> Automotive manufacturer names, logos, and model designations are used strictly for vehicle identification and technical reference. 4WHEELS Rent a Car is an independent rental operator. Listing catalog models does not imply authorized dealership status or physical ownership of every catalog vehicle.
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</body>
</html>
