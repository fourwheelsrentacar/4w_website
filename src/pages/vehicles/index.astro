---
import SEOHead from '../../components/SEOHead.astro';
import HeaderComp from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS_INFO } from '../../data/business';
import { PAKISTAN_VEHICLE_CATALOG } from '../../data/pakistanVehicles';

const canonicalUrl = `${BUSINESS_INFO.siteUrl}/vehicles/`;

const brands = Array.from(new Set(PAKISTAN_VEHICLE_CATALOG.map(v => v.brand))).map(b => {
  const sample = PAKISTAN_VEHICLE_CATALOG.find(v => v.brand === b);
  return {
    name: b,
    slug: sample?.brandSlug || b.toLowerCase(),
    count: PAKISTAN_VEHICLE_CATALOG.filter(v => v.brand === b).length,
    officialUrl: sample?.manufacturerUrl || '#'
  };
});

const categories = [
  { slug: 'sedan', name: 'Sedans', icon: '🚗' },
  { slug: 'suv', name: 'SUVs & 4x4', icon: '🚙' },
  { slug: 'hatchback', name: 'Hatchbacks', icon: '🚘' },
  { slug: 'crossover', name: 'Crossovers', icon: '🚐' },
  { slug: 'luxury', name: 'Luxury & VIP', icon: '👑' },
  { slug: 'ev', name: 'Electric Vehicles (EV)', icon: '⚡' },
  { slug: 'hybrid', name: 'Hybrids & PHEV', icon: '🔋' },
  { slug: 'pickup', name: 'Pickups & 4x4', icon: '🛻' },
  { slug: 'van', name: 'Passenger Vans', icon: '🚐' },
  { slug: 'coaster', name: 'Coasters & Mini Buses', icon: '🚌' }
];

const confirmedFleet = PAKISTAN_VEHICLE_CATALOG.filter(v => v.isFleetConfirmed);
const catalogVehicles = PAKISTAN_VEHICLE_CATALOG.filter(v => !v.isFleetConfirmed);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title="Pakistan Vehicle Catalog & 4WHEELS Rental Fleet | Lahore Car Rental"
    description="Explore Pakistan's official vehicle catalog alongside 4WHEELS confirmed rental fleet. Browse Toyota, Honda, Hyundai, BYD, MG, Deepal, Haval & request your preferred car in Lahore."
    canonicalUrl={canonicalUrl}
  />
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
  <HeaderComp />

  <main>
    <!-- Hero Header -->
    <section class="bg-gradient-to-r from-slate-900 via-zinc-900 to-slate-900 text-white py-14 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <span class="bg-brand-red/20 text-brand-red border border-brand-red/30 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider inline-block mb-3">
          Vehicle Discovery & Rental Planning
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          Pakistan Vehicle Catalog & <span class="text-brand-red">4WHEELS Fleet</span>
        </h1>
        <p class="text-lg text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Browse officially launched vehicles in Pakistan or choose from confirmed 4WHEELS core fleet units available in Lahore for self-drive or chauffeur-driven rentals.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/find-my-vehicle/" class="bg-brand-red hover:bg-red-700 text-white px-6 py-3 rounded-lg font-bold shadow-md transition-all flex items-center gap-2">
            🧭 Find My Vehicle (Trip Planner)
          </a>
          <a href="/compare-vehicles/" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-6 py-3 rounded-lg font-bold transition-all flex items-center gap-2">
            📊 Compare Vehicles
          </a>
        </div>
      </div>
    </section>

    <!-- Distinction Notice Card -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 relative z-10">
      <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 grid md:grid-cols-2 gap-6">
        <div class="flex items-start gap-4 p-4 rounded-lg bg-green-50 border border-green-200">
          <div class="text-3xl">✅</div>
          <div>
            <h2 class="font-bold text-green-900 text-lg">4WHEELS Fleet</h2>
            <p class="text-xs text-green-800 mt-1">
              Vehicles directly confirmed in our active inventory with verified photos and immediate availability checks in Lahore.
            </p>
            <span class="inline-block mt-2 text-xs font-bold text-green-700 bg-green-100 px-2 py-0.5 rounded">
              Label: Check Current Availability
            </span>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-lg bg-blue-50 border border-blue-200">
          <div class="text-3xl">📋</div>
          <div>
            <h2 class="font-bold text-blue-900 text-lg">Pakistan Vehicle Catalog</h2>
            <p class="text-xs text-blue-800 mt-1">
              Official vehicles sold/launched in Pakistan. You can request any model, and 4WHEELS will verify availability for your dates.
            </p>
            <span class="inline-block mt-2 text-xs font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded">
              Label: Request This Model
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Browse By Brand -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Browse Official Pakistan Brands</h2>
        <p class="text-gray-600 text-sm mt-1">Select a manufacturer to explore official lineups, specs, and rental request options.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {brands.map(brand => (
          <a
            href={`/vehicles/${brand.slug}/`}
            class="bg-white hover:bg-gray-50 border border-gray-200 hover:border-brand-red rounded-xl p-4 text-center transition-all shadow-sm hover:shadow-md group"
          >
            <div class="text-xl font-black text-gray-900 group-hover:text-brand-red transition-colors">
              {brand.name}
            </div>
            <div class="text-xs text-gray-500 mt-1">
              {brand.count} {brand.count === 1 ? 'Model' : 'Models'}
            </div>
            <span class="text-[10px] text-brand-red font-semibold mt-2 inline-block group-hover:underline">
              View Brand Lineup →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Confirmed 4WHEELS Fleet Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-gray-200 pb-4 mb-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-green-600 bg-green-100 px-2.5 py-1 rounded">
            Physical Inventory
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mt-2">4WHEELS Core Fleet Vehicles</h2>
        </div>
        <a href="/fleet/" class="text-sm font-bold text-brand-red hover:underline mt-2 md:mt-0">
          View Dedicated Fleet Page & Gallery →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {confirmedFleet.map(car => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded">
                  4WHEELS Fleet
                </span>
                <span class="text-xs font-semibold text-gray-500">{car.bodyType}</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900">{car.brand} {car.model}</h3>
              <p class="text-xs text-gray-600 mt-0.5">{car.variant}</p>

              <!-- Spec Chips -->
              <div class="grid grid-cols-2 gap-2 mt-4 text-xs bg-gray-50 p-3 rounded-lg border border-gray-100">
                <div>👥 <strong>Passengers:</strong> Up to {car.maxPassengers}</div>
                <div>⚙️ <strong>Trans:</strong> {car.transmission}</div>
                <div>
                  {car.fuelType === 'Electric' ? '🔋' : '⛽'}
                  <strong>{car.fuelType === 'Electric' ? 'Battery:' : 'Tank:'}</strong>
                  {car.fuelType === 'Electric' ? car.batteryCapacity : car.fuelTankCapacity}
                </div>
                <div>🧳 <strong>Boot:</strong> {car.bootCapacity}</div>
              </div>

              <!-- Seating Visualizer -->
              <div class="mt-3 text-xs text-gray-700 flex items-center justify-between">
                <span>Seats:</span>
                <span class="text-sm">{'👤 '.repeat(car.seats)}</span>
              </div>

              <div class="mt-5 flex items-center justify-between gap-2">
                <a
                  href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                  class="flex-1 text-center text-xs font-bold text-gray-800 bg-gray-100 hover:bg-gray-200 py-2.5 rounded-lg transition-colors"
                >
                  Specs & Details
                </a>
                <a
                  href={`https://wa.me/923216616644?text=Hi%204WHEELS%2C%20I%20would%20like%20to%20check%20current%20availability%20for%20${car.brand}%20${car.model}.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center text-xs font-bold text-white bg-green-600 hover:bg-green-700 py-2.5 rounded-lg transition-colors"
                >
                  Check Availability
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pakistan Vehicle Catalog Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="border-b border-gray-200 pb-4 mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-100 px-2.5 py-1 rounded">
          Pakistan Market Lineups
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mt-2">Pakistan Vehicle Catalog (Request On-Demand)</h2>
        <p class="text-sm text-gray-600 mt-1">
          Officially launched models in Pakistan. You can request any model below and 4WHEELS will arrange vehicle availability.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {catalogVehicles.map(car => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded">
                  Request This Model
                </span>
                <span class="text-xs font-semibold text-gray-500">{car.bodyType}</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900">{car.brand} {car.model}</h3>
              <p class="text-xs text-gray-600 mt-0.5">{car.variant}</p>

              <!-- Spec Chips -->
              <div class="grid grid-cols-2 gap-2 mt-4 text-xs bg-gray-50 p-3 rounded-lg border border-gray-100">
                <div>👥 <strong>Passengers:</strong> Up to {car.maxPassengers}</div>
                <div>⚙️ <strong>Powertrain:</strong> {car.fuelType}</div>
                <div>
                  {car.fuelType === 'Electric' ? '🔋' : '⛽'}
                  <strong>Spec:</strong>
                  {car.fuelType === 'Electric' ? car.batteryCapacity : car.fuelTankCapacity}
                </div>
                <div>📏 <strong>Clearance:</strong> {car.groundClearance}</div>
              </div>

              <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-500">
                <a
                  href={car.manufacturerUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-brand-red flex items-center gap-1 underline"
                >
                  Official Manufacturer Site ↗
                </a>
                <span>Verified: {car.verifiedDate}</span>
              </div>

              <div class="mt-4 flex items-center justify-between gap-2">
                <a
                  href={`/vehicles/${car.brandSlug}/${car.slug}/`}
                  class="flex-1 text-center text-xs font-bold text-gray-800 bg-gray-100 hover:bg-gray-200 py-2.5 rounded-lg transition-colors"
                >
                  View Details
                </a>
                <a
                  href={`https://wa.me/923216616644?text=Hi%204WHEELS%2C%20I%20would%20like%20to%20request%20availability%20information%20for%20${car.brand}%20${car.model}.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 py-2.5 rounded-lg transition-colors"
                >
                  Request Model
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Disclaimer Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="bg-gray-100 rounded-lg p-4 text-xs text-gray-600 border border-gray-200">
        <strong class="text-gray-900">Trademark & Catalog Notice:</strong> Vehicle manufacturer trademarks, logos, and model designations belong to their respective owners. 4WHEELS Rent a Car is an independent rental provider in Lahore. Listing models in the Pakistan Vehicle Catalog does not imply dealership affiliation or physical ownership of every catalog model.
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</body>
</html>
