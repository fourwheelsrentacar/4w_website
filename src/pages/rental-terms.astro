---
import Layout from '../layouts/Layout.astro';
import { BUSINESS_INFO } from '../data/business';
import { getContextualWhatsAppUrl } from '../utils/whatsappContext';

const title = "Rental Terms & Policies - 4WHEELS Rent a Car Lahore";
const waUrl = getContextualWhatsAppUrl({
  pageType: 'support',
  pageTitle: 'Rental Terms & Policies',
  canonicalUrl: `${BUSINESS_INFO.siteUrl}/rental-terms/`,
});
const description = "Official rental terms, daily cycle rules, fuel policy, toll charges, traffic violations (challans), and rental extension policies for 4WHEELS Rent a Car Lahore.";
const canonicalPath = "/rental-terms/";
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">
        Transparent Rental Conditions
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">
        4WHEELS Rental Terms & Policies
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-3xl mx-auto mb-6">
        Clear, honest rental terms designed to give customers complete peace of mind during city and outstation journeys.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 text-slate-800 text-sm leading-relaxed">

      <!-- Section 27: Rental Day Rule -->
      <div class="border border-slate-200 rounded-2xl p-6 bg-slate-50">
        <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
          <span>🕒 1. Rental Day & Time Calculation</span>
        </h2>
        <p class="mb-3 text-slate-700">
          A rental day is calculated according to the agreed booking period and the 4WHEELS rental-day policy, with the daily cycle based around <strong>12:00 AM midnight</strong> where applicable.
        </p>
        <div class="bg-amber-50 border border-amber-200 p-3 rounded-lg text-xs font-semibold text-amber-900">
          ⚠️ Note: 12:00 AM represents midnight. Rental extensions or late vehicle returns beyond the agreed booking cutoff must be requested in advance via customer care.
        </div>
      </div>

      <!-- Section 28: Terms Matrix -->
      <div class="space-y-6">
        <h2 class="text-xl font-bold text-slate-900">2. Fuel, Tolls & Operational Expenses</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="border border-slate-200 rounded-xl p-5">
            <h3 class="font-bold text-slate-900 text-base mb-2">⛽ Fuel Policy</h3>
            <p class="text-slate-600">
              Vehicles are provided on either a <strong>Full-to-Full</strong> basis or <strong>Fuel Excluded</strong> basis depending on rental type. Customer bears trip fuel costs unless explicitly written into a corporate contract.
            </p>
          </div>

          <div class="border border-slate-200 rounded-xl p-5">
            <h3 class="font-bold text-slate-900 text-base mb-2">🛣️ Motorway Tolls & M-Tag</h3>
            <p class="text-slate-600">
              Motorway toll plaza charges, M-Tag balances, and highway fees are separate from the base vehicle rental rate unless stated otherwise in writing.
            </p>
          </div>

          <div class="border border-slate-200 rounded-xl p-5">
            <h3 class="font-bold text-slate-900 text-base mb-2">🚦 Traffic Violations (Challans)</h3>
            <p class="text-slate-600">
              Traffic violations (over-speeding, red light signals, lane violations) incurred during the renter's responsible period are the sole responsibility of the renter/authorized driver.
            </p>
          </div>

          <div class="border border-slate-200 rounded-xl p-5">
            <h3 class="font-bold text-slate-900 text-base mb-2">🅿️ Parking & Airport Fees</h3>
            <p class="text-slate-600">
              Commercial airport parking tickets, entry passes, and municipal parking fees are excluded from standard rates and payable by customer.
            </p>
          </div>
        </div>
      </div>

      <!-- Outstation Driver Expenses -->
      <div class="border-t border-slate-200 pt-8">
        <h2 class="text-xl font-bold text-slate-900 mb-3">3. Outstation Driver Expenses</h2>
        <p class="text-slate-700 mb-4">
          For intercity outstation bookings with driver (e.g. Lahore to Murree, Islamabad, or Northern Areas), driver meal allowances and overnight stay accommodations are specified in your written WhatsApp quotation.
        </p>
      </div>

      <div class="bg-slate-900 text-white rounded-2xl p-6 text-center">
        <h3 class="text-lg font-bold mb-2">Have Specific Questions About Rental Terms?</h3>
        <p class="text-xs text-slate-300 mb-4">Our customer care team is available on WhatsApp and Phone to confirm exact policies for your booking.</p>
        <a href={waUrl} target="_blank" class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl transition-colors text-xs">
          💬 Ask Customer Care on WhatsApp
        </a>
      </div>

    </div>
  </section>
</Layout>
