---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { PAKISTAN_ROUTES } from '../../data/routes';
---

<Layout title="Pakistan Popular Travel Routes | 4WHEELS Rent a Car">
  <SEOHead
    title="Pakistan Popular Travel Routes | 4WHEELS Rent a Car"
    description="Explore popular intercity routes from Lahore to Islamabad, Murree, Faisalabad, Multan, and Sialkot with distance, fuel estimates, tolls, and recommended rental cars."
    canonicalUrl="https://4wheelsrentacar.pk/routes/"
  />

  <main class="bg-slate-950 text-slate-100 min-h-screen pb-16">
    <!-- Hero Header -->
    <section class="bg-slate-900 border-b border-slate-800 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
          🛣️ Pakistan Route Directory
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Intercity Motorway & Highway Route Guides
        </h1>
        <p class="text-slate-300 max-w-3xl mx-auto text-base sm:text-lg leading-relaxed">
          Plan your road trips with verified driving distances, motorway tolls, fuel consumption estimates, and recommended 4WHEELS rental vehicles.
        </p>
      </div>
    </section>

    <!-- Routes Cards Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PAKISTAN_ROUTES.map(route => (
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between hover:border-slate-700 transition-all shadow-xl">
            <div>
              <div class="flex justify-between items-center text-xs text-slate-400 font-bold uppercase mb-3">
                <span class="text-amber-400">⏱️ {route.drivingTimeHours}</span>
                <span>🛣️ {route.distanceKm} km</span>
              </div>

              <h2 class="text-xl font-bold text-white mb-2 hover:text-red-400 transition-colors">
                <a href={`/routes/${route.slug}/`}>{route.title}</a>
              </h2>

              <p class="text-xs text-slate-300 line-clamp-3 mb-4 leading-relaxed">
                {route.overview}
              </p>

              <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs space-y-1 mb-4">
                <div class="flex justify-between text-slate-400">
                  <span>Motorway:</span>
                  <span class="text-slate-200 font-semibold">{route.motorway}</span>
                </div>
                <div class="flex justify-between text-slate-400">
                  <span>Estimated Fuel:</span>
                  <span class="text-slate-200 font-semibold">~{route.estimatedFuelLiters} Liters</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between items-center text-xs">
              <a href={`/routes/${route.slug}/`} class="font-bold text-red-400 hover:text-red-300 flex items-center gap-1">
                View Route Specs →
              </a>
              <a
                href={`/trip-planner/?origin=${encodeURIComponent(route.origin)}&destination=${encodeURIComponent(route.destination)}`}
                class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-3 py-1.5 rounded-lg transition-colors"
              >
                Plan This Trip
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- FAQ Section -->
      <FAQ
        title="Intercity Motorway & Toll FAQ"
        items={[
          {
            question: "Are fuel and toll estimates updated?",
            answer: "Estimates are calculated using current petroleum prices and official NHA motorway toll rates."
          },
          {
            question: "Can I rent a car with a driver for intercity routes?",
            answer: "Yes, 4WHEELS offers chauffeur-driven sedans, 4x4 SUVs, and Coasters for all intercity routes across Pakistan."
          }
        ]}
      />

      <CTASection
        title="Ready to Book Your Intercity Journey?"
        description="Select your vehicle and dates to submit a direct booking inquiry to 4WHEELS Customer Care."
        primaryBtnText="Book Your Trip"
        primaryBtnHref="/build-your-rental/"
      />
    </div>
  </main>
</Layout>
