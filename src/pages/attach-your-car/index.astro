<script>
  // Calculator Dynamic Logic
  const catSelect = document.getElementById('calc-category') as HTMLSelectElement;
  const yearSelect = document.getElementById('calc-year') as HTMLSelectElement;
  const monthlyDisplay = document.getElementById('calc-monthly-display');
  const annualDisplay = document.getElementById('calc-annual-display');

  const updateCalculator = () => {
    if (!catSelect || !yearSelect) return;
    const selectedOpt = catSelect.options[catSelect.selectedIndex];
    const avgMonthly = parseFloat(selectedOpt.getAttribute('data-avg') || '75000');
    const multiplier = parseFloat(yearSelect.value || '1.0');

    const calculatedMonthly = Math.round((avgMonthly * multiplier) / 1000) * 1000;
    const calculatedAnnual = calculatedMonthly * 12;

    if (monthlyDisplay) {
      monthlyDisplay.textContent = `PKR ${calculatedMonthly.toLocaleString()}`;
    }
    if (annualDisplay) {
      annualDisplay.textContent = `PKR ${calculatedAnnual.toLocaleString()}`;
    }
  };

  catSelect?.addEventListener('change', updateCalculator);
  yearSelect?.addEventListener('change', updateCalculator);

  // Form Submission & WhatsApp Deep-link Dispatch
  const form = document.getElementById('car-attachment-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-banner');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const carMakeModel = (document.getElementById('car-make-model') as HTMLInputElement)?.value || '';
    const carYear = (document.getElementById('car-year') as HTMLSelectElement)?.value || '2024';
    const carColor = (document.getElementById('car-color') as HTMLInputElement)?.value || '';
    const carMileage = (document.getElementById('car-mileage') as HTMLInputElement)?.value || 'N/A';
    const carCity = (document.getElementById('car-city') as HTMLInputElement)?.value || 'Lahore';

    const ownerName = (document.getElementById('owner-name') as HTMLInputElement)?.value || '';
    const ownerStatus = (document.getElementById('owner-status') as HTMLSelectElement)?.value || 'Resident';
    const ownerPhone = (document.getElementById('owner-phone') as HTMLInputElement)?.value || '';
    const expectedRent = (document.getElementById('expected-rent') as HTMLInputElement)?.value || 'Market Standard';
    const ownerNotes = (document.getElementById('owner-notes') as HTMLTextAreaElement)?.value || '';

    const message =
      'Assalam o Alaikum 4WHEELS Management,\n' +
      'I want to attach my vehicle to your rental fleet for monthly passive income.\n\n' +
      '🚗 VEHICLE DETAILS\n' +
      `• Make & Model: ${carMakeModel}\n` +
      `• Model Year: ${carYear}\n` +
      `• Exterior Color: ${carColor}\n` +
      `• Mileage: ${carMileage}\n` +
      `• Registration City: ${carCity}\n\n` +
      '👤 OWNER INFORMATION\n' +
      `• Name: ${ownerName}\n` +
      `• Residency Status: ${ownerStatus}\n` +
      `• WhatsApp / Phone: ${ownerPhone}\n` +
      `• Expected Monthly Rent: PKR ${expectedRent}\n` +
      (ownerNotes ? `• Additional Notes: ${ownerNotes}\n` : '') +
      '\nPlease confirm inspection timing at your Johar Town office and monthly contract terms.';

    if (successBanner) {
      successBanner.classList.remove('hidden');
    }

    const waUrl = `https://wa.me/923216616644?text=${encodeURIComponent(message)}`;
    window.open(waUrl, '_blank');
  });
</script>
