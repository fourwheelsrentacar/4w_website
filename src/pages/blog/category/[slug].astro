---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SEOHead from '../../../components/SEOHead.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO } from '../../../data/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = Array.from(new Set(posts.map((p) => p.data.category)));

  return categories.map((category) => {
    const slug = category.toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-');
    return {
      params: { slug },
      props: { category },
    };
  });
}

const { category } = Astro.props;
const posts = await getCollection('blog');
const categoryPosts = posts.filter((p) => p.data.category === category && p.data.index && !p.data.draft);

const pageTitle = `${category} Rental Guides - ${BUSINESS_INFO.name}`;
const pageDescription = `Practical car rental guidance, tips, and articles in Lahore related to ${category}.`;
const slug = category.toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-');
---

<html lang="en">
  <head>
    <SEOHead title={pageTitle} description={pageDescription} canonicalUrl={`${BUSINESS_INFO.siteUrl}/blog/category/${slug}/`} />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-12">
      <!-- Breadcrumb -->
      <nav class="text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-red-600 transition">Home</a></li>
          <li><span>/</span></li>
          <li><a href="/blog/" class="hover:text-red-600 transition">Car Rental Guide</a></li>
          <li><span>/</span></li>
          <li class="font-medium text-slate-800">{category}</li>
        </ol>
      </nav>

      <!-- Category Archive Header -->
      <div class="border-b border-slate-200 pb-8 mb-12">
        <span class="inline-block px-3 py-1 bg-red-100 text-red-700 text-xs font-bold uppercase tracking-wider rounded-full mb-3">Topic Category</span>
        <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">{category} Guides</h1>
        <p class="mt-3 text-lg text-slate-600 max-w-2xl">
          Practical advice and essential information for renting and driving vehicles under the {category} category in Lahore.
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="grid md:grid-cols-3 gap-6">
        {categoryPosts.map((post) => (
          <article class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-slate-300 transition flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3 text-xs">
                <span class="px-2.5 py-1 bg-slate-100 text-slate-700 font-bold rounded-md">{post.data.category}</span>
                <span class="text-slate-400">{post.data.readingTime}</span>
              </div>
              <h2 class="text-lg font-bold text-slate-900 mb-2 hover:text-red-600 transition leading-snug">
                <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="text-slate-600 text-xs line-clamp-3 mb-4 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
              <span>{post.data.datePublished}</span>
              <a href={`/blog/${post.data.slug}/`} class="text-red-600 hover:text-red-700 font-bold">Read Guide &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>
