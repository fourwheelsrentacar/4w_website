---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO } from '../../data/business';

const pageTitle = `4WHEELS Car Rental Guide - Lahore Knowledge Hub`;
const pageDescription = `Practical guidance for renting, driving, and choosing the right car in Lahore. Expert articles, vehicle guides, and rental safety checklists.`;

const posts = await getCollection('blog');
const publishedPosts = posts.filter((p) => p.data.index && !p.data.draft);

const categories = [
  'Renting 101',
  'Self Drive',
  'With Driver',
  'Lahore Travel',
  'Airport Rental',
  'Monthly & Long-Term Rental',
  'Corporate Travel',
  'Choosing a Car',
  'Rental Safety'
];

const featuredPost = publishedPosts.find((p) => p.data.slug === 'how-to-rent-a-car-in-lahore-beginner-guide') || publishedPosts[0];
---

<html lang="en">
  <head>
    <SEOHead title={pageTitle} description={pageDescription} canonicalUrl={`${BUSINESS_INFO.siteUrl}/blog/`} />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <Header />

    <main class="max-w-7xl mx-auto px-4 py-12">
      <!-- Knowledge Hub Hero -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3 py-1 bg-red-100 text-red-700 text-xs font-bold uppercase tracking-wider rounded-full mb-3">Lahore Knowledge Hub</span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">4WHEELS Car Rental Guide</h1>
        <p class="mt-4 text-xl text-slate-600">
          Practical guidance for renting, driving and choosing the right car in Lahore.
        </p>

        <!-- Search Bar -->
        <div class="mt-8 max-w-xl mx-auto relative">
          <input
            type="text"
            id="blog-search-input"
            placeholder="Search guides (e.g. self-drive, airport, documents, Corolla)..."
            class="w-full px-5 py-3.5 pl-12 rounded-2xl border border-slate-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 text-sm bg-white"
          />
          <svg class="w-5 h-5 absolute left-4 top-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Featured Guide Banner -->
      {featuredPost && (
        <section class="mb-16">
          <div class="bg-slate-900 text-white rounded-3xl p-8 md:p-12 shadow-xl relative overflow-hidden grid md:grid-cols-3 gap-8 items-center">
            <div class="md:col-span-2 relative z-10">
              <span class="px-3 py-1 bg-red-600 text-white text-xs font-bold rounded-md uppercase tracking-wider">Featured Guide</span>
              <h2 class="text-2xl md:text-4xl font-extrabold mt-4 mb-3 hover:text-red-400 transition">
                <a href={`/blog/${featuredPost.data.slug}/`}>{featuredPost.data.title}</a>
              </h2>
              <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-6">
                {featuredPost.data.description}
              </p>
              <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-400">
                <span>By {featuredPost.data.author}</span>
                <span>•</span>
                <span>{featuredPost.data.readingTime}</span>
                <span>•</span>
                <a href={`/blog/${featuredPost.data.slug}/`} class="px-4 py-2 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition">Read Full Guide &rarr;</a>
              </div>
            </div>
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 text-xs space-y-3">
              <h3 class="font-bold text-slate-200 uppercase text-[10px] tracking-wider">Quick Summary</h3>
              <p class="text-slate-300 leading-relaxed">{featuredPost.data.quickAnswer}</p>
            </div>
          </div>
        </section>
      )}

      <!-- Category Filter Tabs -->
      <section class="mb-12">
        <h2 class="text-xl font-bold text-slate-900 mb-4">Browse by Topic</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((cat) => (
            <a
              href={`/blog/category/${cat.toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-')}/`}
              class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition shadow-sm"
            >
              {cat}
            </a>
          ))}
        </div>
      </section>

      <!-- Articles Grid -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">All Rental Guides</h2>
        <div id="articles-grid" class="grid md:grid-cols-3 gap-6">
          {publishedPosts.map((post) => (
            <article
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-category={post.data.category.toLowerCase()}
              class="article-card bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-slate-300 transition flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-3 text-xs">
                  <span class="px-2.5 py-1 bg-slate-100 text-slate-700 font-bold rounded-md">{post.data.category}</span>
                  <span class="text-slate-400">{post.data.readingTime}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 hover:text-red-600 transition leading-snug">
                  <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
                </h3>
                <p class="text-slate-600 text-xs line-clamp-3 mb-4 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
                <span>{post.data.datePublished}</span>
                <a href={`/blog/${post.data.slug}/`} class="text-red-600 hover:text-red-700 font-bold">Read &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />

    <!-- Client-Side Lightweight Filter Script -->
    <script>
      const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
      const cards = document.querySelectorAll('.article-card');

      input?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const category = card.getAttribute('data-category') || '';
          if (title.includes(query) || desc.includes(query) || category.includes(query)) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    </script>
  </body>
</html>
