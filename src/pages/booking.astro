---
import Layout from '../layouts/Layout.astro';
import { FLEET_VEHICLES } from '../data/fleet';
import { PAKISTAN_VEHICLE_CATALOG, type CatalogVehicle } from '../data/pakistanVehicles';
import { PAKISTAN_BRANDS, type Brand } from '../data/brands';
import { VEHICLE_YEAR_GROUPS, type VehicleYearGroup } from '../data/vehicleYears';
import { GROUP_TRANSPORT_VEHICLES } from '../data/groupTransport';
import { VERIFIED_ROUTE_DATABASE } from '../data/routes';

// Combine catalog vehicles with group transport items
const groupCatalogVehicles: CatalogVehicle[] = GROUP_TRANSPORT_VEHICLES.map(gt => ({
  id: gt.id,
  slug: gt.slug,
  brand: gt.title.includes('Toyota') ? 'Toyota' : (gt.title.includes('Yutong') ? 'Yutong / Daewoo' : 'Hinopak / Isuzu'),
  brandSlug: gt.title.includes('Toyota') ? 'toyota' : (gt.title.includes('Yutong') ? 'yutong' : 'hinopak'),
  model: gt.title,
  variant: gt.category,
  modelYear: '2024-2026',
  bodyType: gt.category,
  category: gt.category === 'Coaster' ? 'coaster' : (gt.category === 'Passenger Van' ? 'van' : 'bus'),
  status: gt.isFleetConfirmed ? '4WHEELS Core Fleet' : 'Available on Request',
  seats: gt.maxPassengers,
  maxPassengers: gt.maxPassengers,
  transmission: 'Manual',
  fuelType: 'Diesel',
  engine: 'Heavy Duty Diesel Engine',
  fuelTankCapacity: '95 Litres',
  batteryCapacity: null,
  electricRange: null,
  bootCapacity: gt.luggageCapacity,
  groundClearance: '200 mm',
  colors: ['White / Gold', 'White', 'Silver'],
  suitableUse: gt.suitableUse,
  manufacturerUrl: 'https://toyota-indus.com',
  brochureUrl: null,
  sourceUrl: 'https://www.4wheelspk.com',
  verifiedDate: '2026-08-21',
  isFleetConfirmed: gt.isFleetConfirmed,
  tagline: gt.description,
  description: gt.description,
  heroPhoto: '/vehicles/fleet/toyota-coaster/hero.webp'
}));

const existingIds = new Set(PAKISTAN_VEHICLE_CATALOG.map(v => v.id));
const extraGroupVehicles = groupCatalogVehicles.filter(v => !existingIds.has(v.id));
const allCatalogVehicles = [...PAKISTAN_VEHICLE_CATALOG, ...extraGroupVehicles];

// Build brand vehicle count maps per category
const brandCategoryCountMap: Record<string, Record<string, number>> = {};
PAKISTAN_BRANDS.forEach(b => {
  brandCategoryCountMap[b.slug] = { all: 0 };
});

allCatalogVehicles.forEach(v => {
  const bSlug = v.brandSlug.toLowerCase();
  if (!brandCategoryCountMap[bSlug]) {
    brandCategoryCountMap[bSlug] = { all: 0 };
  }
  brandCategoryCountMap[bSlug].all = (brandCategoryCountMap[bSlug].all || 0) + 1;
  const cat = v.category.toLowerCase();
  brandCategoryCountMap[bSlug][cat] = (brandCategoryCountMap[bSlug][cat] || 0) + 1;
});

const title = "Book Your Rental Vehicle | 4WHEELS Rent a Car Lahore";
const description = "Configure your vehicle rental step-by-step: select category, brand, model, exact model year/shape, and preferred color. Direct WhatsApp verification with 4WHEELS Rent a Car Lahore.";
const canonicalPath = "/booking/";

// Category definitions with clean real WebP photography
const CATEGORIES = [
  {
    id: 'hatchback',
    name: 'ECONOMY / HATCHBACK',
    tagline: 'City Commute • Fuel Efficient • Compact Parking',
    image: '/vehicles/fleet/suzuki-alto/hero.webp',
    popularModel: 'Suzuki Alto / Swift / Picanto'
  },
  {
    id: 'sedan',
    name: 'SEDAN',
    tagline: 'Executive Comfort • Outstation Travel • Family Trips',
    image: '/vehicles/fleet/toyota-corolla/hero.webp',
    popularModel: 'Toyota Corolla / Honda Civic / Yaris'
  },
  {
    id: 'suv',
    name: 'SUV / CROSSOVER',
    tagline: 'Northern Tours • Tough Roads • Generous Luggage',
    image: '/vehicles/fleet/toyota-fortuner/hero.webp',
    popularModel: 'Toyota Fortuner / Kia Sportage L / Haval H6'
  },
  {
    id: 'luxury',
    name: 'LUXURY / EXECUTIVE',
    tagline: 'VIP Transport • Wedding Motorcades • Diplomat Travel',
    image: '/vehicles/fleet/audi-a6/hero.webp',
    popularModel: 'Audi A6 / Hyundai Sonata / BYD Seal'
  },
  {
    id: 'pickup',
    name: 'PICKUP / 4X4',
    tagline: 'Off-Road 4x4 • Project Sites • Extreme Terrain',
    image: '/vehicles/fleet/toyota-revo/hero.webp',
    popularModel: 'Toyota Hilux Revo Rocco / BYD Shark 6'
  },
  {
    id: 'van',
    name: 'VAN / MPV',
    tagline: 'Group Transport • Airport Protocol • 11–13 Seats',
    image: '/vehicles/fleet/toyota-hiace/hero.webp',
    popularModel: 'Toyota HiAce Grand Cabin / Kia Carnival'
  },
  {
    id: 'coaster',
    name: 'COASTER',
    tagline: '22 Seater Executive Bus • With Driver • Tour Groups',
    image: '/vehicles/fleet/toyota-coaster/hero.webp',
    popularModel: 'Toyota Coaster 22-Seater Executive'
  },
  {
    id: 'bus',
    name: 'BUS / COACH',
    tagline: 'Large Delegations • School Tours • 28 to 51 Seats',
    image: '/vehicles/fleet/toyota-coaster/hero.webp',
    popularModel: 'Yutong & Daewoo Executive Coaches'
  }
];

// Color choices
const COLOR_OPTIONS = [
  { id: 'any', name: 'ANY AVAILABLE COLOR', hex: '#64748b', isDefault: true },
  { id: 'white', name: 'Super White / Pearl White', hex: '#f8fafc' },
  { id: 'black', name: 'Attitude Black / Crystal Black', hex: '#0f172a' },
  { id: 'silver', name: 'Silky Silver / Metallic Silver', hex: '#94a3b8' },
  { id: 'grey', name: 'Graphite Grey / Meteoroid Grey', hex: '#475569' },
  { id: 'red', name: 'Crimson Red / Passion Red', hex: '#dc2626' },
  { id: 'blue', name: 'Ocean Blue / Dark Blue', hex: '#2563eb' }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Header Banner -->
  <section class="bg-slate-900 text-white py-8 sm:py-10 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e0121a_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="bg-red-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-widest mb-3 inline-block shadow-md">
        4WHEELS Visual Vehicle Configurator
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-2">
        Book Your Trip
      </h1>
      <p class="text-slate-300 text-xs sm:text-base max-w-2xl mx-auto leading-relaxed">
        Select category, brand, model, exact model year/shape, and preferred color with real WebP vehicle photography. Instant reservation via WhatsApp.
      </p>
    </div>
  </section>

  <!-- Main Visual Selection Section -->
  <section class="py-8 sm:py-12 bg-slate-950 text-white min-h-[90vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Interactive Stepper Header Bar -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 mb-8 shadow-xl">
        <!-- Desktop Stepper Labels -->
        <div class="hidden md:flex items-center justify-between text-xs font-extrabold text-slate-400">
          <div id="step-tab-1" class="step-tab flex items-center gap-2 text-red-500 cursor-pointer hover:text-white transition-colors" data-tab-step="1">
            <span class="w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center text-xs shadow-md">1</span>
            <span>Category</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-2" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">2</span>
            <span>Brand</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-3" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="3">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">3</span>
            <span>Model</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-4" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="4">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">4</span>
            <span>Year & Color</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-5" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="5">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">5</span>
            <span>Route</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-6" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="6">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">6</span>
            <span>Dates & Details</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-7" class="step-tab flex items-center gap-2 cursor-pointer hover:text-white transition-colors" data-tab-step="7">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">7</span>
            <span>Review</span>
          </div>
        </div>

        <!-- Mobile Stepper Header -->
        <div class="md:hidden flex items-center justify-between">
          <div>
            <span class="text-[10px] font-black text-red-500 uppercase tracking-widest block">Booking Flow</span>
            <span id="mobile-step-title" class="text-sm font-extrabold text-white">Step 1: WHAT TYPE OF VEHICLE DO YOU NEED?</span>
          </div>
          <span id="mobile-step-counter" class="text-xs font-black bg-red-600 text-white px-3 py-1 rounded-full">
            1 of 7
          </span>
        </div>
      </div>

      <!-- Split Screen Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- LEFT (7 cols): Interactive Visual Selection Panel -->
        <div class="lg:col-span-7 bg-slate-900 rounded-2xl border border-slate-800 p-5 sm:p-8 shadow-xl">

          <!-- STEP 1: CATEGORY -->
          <div id="step-panel-1" class="step-panel space-y-6">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight">WHAT TYPE OF VEHICLE DO YOU NEED?</h2>
                <p class="text-xs text-slate-400">Select a category to view matching real-photo models.</p>
              </div>
              <span class="text-xs text-slate-400 font-bold">Step 1 of 7</span>
            </div>

            <!-- Responsive Category Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="category-cards-grid">
              {CATEGORIES.map(cat => (
                <div
                  class="cat-card group bg-slate-950 border border-slate-800 hover:border-red-500 rounded-2xl p-4 cursor-pointer transition-all duration-300 hover:shadow-xl flex flex-col justify-between"
                  data-cat-id={cat.id}
                >
                  <div class="aspect-[16/9] w-full rounded-xl overflow-hidden bg-slate-900 border border-slate-800/80 mb-3 relative flex items-center justify-center p-2">
                    <img
                      src={cat.image}
                      alt={`${cat.name} rental Lahore`}
                      loading="eager"
                      class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute bottom-1.5 right-2 text-[10px] text-slate-300 font-bold bg-slate-950/80 px-2 py-0.5 rounded border border-slate-800">
                      Real WebP Photograph
                    </div>
                  </div>
                  <div>
                    <h3 class="text-base font-black text-white group-hover:text-red-400 transition-colors">
                      {cat.name}
                    </h3>
                    <p class="text-xs text-slate-400 mt-1 leading-snug">
                      {cat.tagline}
                    </p>
                    <div class="mt-3 flex items-center justify-between border-t border-slate-800/80 pt-2">
                      <span class="text-[11px] text-amber-400 font-semibold">{cat.popularModel}</span>
                      <span class="bg-red-600 group-hover:bg-red-700 text-white font-black text-[11px] px-3 py-1 rounded-lg transition-colors">
                        SELECT →
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- STEP 2: BRAND -->
          <div id="step-panel-2" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight">CHOOSE A BRAND</h2>
                <p class="text-xs text-slate-400">Showing matching brands for <span id="selected-cat-label" class="text-red-400 font-bold uppercase">All Categories</span></p>
              </div>
              <button type="button" class="btn-change-cat text-xs text-red-400 font-bold hover:underline">
                ← Change Category
              </button>
            </div>

            <!-- Brand Search & Filter Bar -->
            <div class="flex items-center gap-3">
              <input
                type="text"
                id="brand-search-input"
                placeholder="Search brand (Toyota, Honda, Kia, BYD, Haval, Deepal...)"
                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none"
              />
              <button type="button" id="btn-toggle-all-brands" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-4 py-3 rounded-xl border border-slate-700 whitespace-nowrap">
                VIEW ALL BRANDS
              </button>
            </div>

            <!-- Brand Tiles Grid / Mobile Chips -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="brand-tiles-container">
              <div
                class="brand-tile bg-red-600/20 border-red-500 border rounded-xl p-3.5 cursor-pointer transition-all flex items-center justify-between"
                data-brand-slug="all"
              >
                <div>
                  <div class="text-sm font-extrabold text-white">ALL BRANDS</div>
                  <div class="text-[10px] text-slate-300">Show all matching models</div>
                </div>
                <span class="text-xs font-black bg-red-600 text-white px-2.5 py-0.5 rounded">All</span>
              </div>

              {PAKISTAN_BRANDS.map(b => (
                <div
                  class={`brand-tile bg-slate-950 border border-slate-800 hover:border-red-500 rounded-xl p-3.5 cursor-pointer transition-all flex items-center justify-between group ${!b.featured ? 'hidden extra-brand' : ''}`}
                  data-brand-slug={b.slug}
                  data-brand-categories={b.categories.join(',')}
                >
                  <div>
                    <div class="text-sm font-extrabold text-white group-hover:text-red-400 transition-colors">
                      {b.name}
                    </div>
                    <div class="text-[10px] text-slate-400">{b.country}</div>
                  </div>
                  <span class="brand-count-badge text-[10px] font-black bg-slate-800 text-slate-300 group-hover:bg-red-600 group-hover:text-white px-2 py-0.5 rounded">
                    {b.vehicleCount} models
                  </span>
                </div>
              ))}
            </div>

            <div class="pt-2 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-2.5 rounded-xl border border-slate-700">
                ← Back
              </button>
            </div>
          </div>

          <!-- STEP 3: MODEL -->
          <div id="step-panel-3" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight">CHOOSE MODEL</h2>
                <p class="text-xs text-slate-400">Select vehicle model to view available model years and body shapes.</p>
              </div>
              <button type="button" class="btn-change-brand text-xs text-red-400 font-bold hover:underline">
                ← Change Brand
              </button>
            </div>

            <!-- Model Cards Container -->
            <div class="grid grid-cols-1 gap-4" id="model-cards-container">
              <!-- Populated via JS -->
            </div>

            <div class="pt-2 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-2.5 rounded-xl border border-slate-700">
                ← Back
              </button>
            </div>
          </div>

          <!-- STEP 4: MODEL YEAR / SHAPE & COLOR -->
          <div id="step-panel-4" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight">CHOOSE MODEL YEAR / SHAPE</h2>
                <p class="text-xs text-slate-400">Select model year / generation body shape and preferred color.</p>
              </div>
              <button type="button" class="btn-change-model text-xs text-red-400 font-bold hover:underline">
                ← Change Model
              </button>
            </div>

            <!-- Model Year / Generation Shape Options -->
            <div class="space-y-3">
              <label class="block text-xs font-black uppercase tracking-wider text-slate-300">
                1. Select Model Year / Body Shape Generation
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="year-shape-options-container">
                <!-- Dynamically populated via JS -->
              </div>
            </div>

            <!-- Preferred Color Choice (Optional, Never Blocks) -->
            <div class="space-y-3 pt-3 border-t border-slate-800">
              <label class="block text-xs font-black uppercase tracking-wider text-slate-300">
                2. Preferred Exterior Color <span class="text-slate-500 font-normal lowercase">(Optional preference, subject to rental availability)</span>
              </label>
              <div class="flex flex-wrap gap-2" id="color-swatches-container">
                {COLOR_OPTIONS.map(c => (
                  <button
                    type="button"
                    class={`color-swatch-btn text-xs font-bold px-3.5 py-2 rounded-xl border flex items-center gap-2 transition-all ${
                      c.isDefault ? 'bg-red-600 text-white border-red-500 shadow-md scale-105' : 'bg-slate-950 text-slate-300 border-slate-800 hover:border-slate-700'
                    }`}
                    data-color-id={c.id}
                    data-color-name={c.name}
                  >
                    <span class="w-3.5 h-3.5 rounded-full border border-white/20 shadow-inner" style={`background-color: ${c.hex}`}></span>
                    <span>{c.name}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-2.5 rounded-xl border border-slate-700">
                ← Back
              </button>
              <button type="button" id="btn-confirm-year-color" class="bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs px-6 py-3 rounded-xl shadow-lg transition-colors">
                Continue to Route →
              </button>
            </div>
          </div>

          <!-- STEP 5: ROUTE & RENTAL MODE -->
          <div id="step-panel-5" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white uppercase tracking-tight">5. PICKUP & DROP-OFF ROUTE</h2>
                <p class="text-xs text-slate-400">Set route locations for verified distance and travel time estimate.</p>
              </div>
              <span class="text-xs text-slate-400 font-bold">Step 5 of 7</span>
            </div>

            <!-- Selected Vehicle Banner -->
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-red-500 uppercase tracking-wider block">Configured Vehicle</span>
                <h3 id="preselect-title" class="text-lg font-black text-white">Toyota Corolla</h3>
                <p id="preselect-subtitle" class="text-xs text-slate-400">2024 Model • Altis X Shape • White Preferred</p>
              </div>
              <button type="button" id="btn-change-vehicle-main" class="text-xs font-bold text-red-400 hover:text-red-300 underline">
                CHANGE VEHICLE
              </button>
            </div>

            <div class="space-y-4">
              <div>
                <label for="field-mode" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Rental Mode</label>
                <select id="field-mode" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none">
                  <option value="With Driver">With Driver (Chauffeur Service Included)</option>
                  <option value="Self Drive">Self Drive (CNIC & Verification Required)</option>
                </select>
              </div>

              <div>
                <label for="field-pickup" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  📍 Pickup Location <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-pickup" required placeholder="Address, area, airport, or landmark (e.g. Johar Town, Lahore)" value="Johar Town Phase 1, Lahore" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <div>
                <label for="field-destination" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  🏁 Drop-off Destination <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-destination" required placeholder="Destination (e.g. Islamabad F-7 / Lahore Airport / Murree)" value="Islamabad F-7" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <!-- Route Calculation Display -->
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <span class="text-xs font-extrabold text-red-500 uppercase tracking-wider flex items-center gap-1.5">
                    <span>⚡ Route Distance Estimation</span>
                  </span>
                  <span id="calc-status-badge" class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold px-2 py-0.5 rounded">
                    4WHEELS Verified Route Database
                  </span>
                </div>
                <div class="grid grid-cols-2 gap-4 pt-1">
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Estimated Distance</span>
                    <span id="route-calc-distance" class="text-lg font-black text-white">Approx. 375 km</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Driving Duration</span>
