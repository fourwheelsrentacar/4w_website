<script is:inline set:html={`
  window.catalogData = ${JSON.stringify(allCatalogVehicles)};
  window.brandsData = ${JSON.stringify(PAKISTAN_BRANDS)};
  window.yearGroupsData = ${JSON.stringify(VEHICLE_YEAR_GROUPS)};
  window.brandCategoryCounts = ${JSON.stringify(brandCategoryCountMap)};
  window.verifiedRouteDb = ${JSON.stringify(VERIFIED_ROUTE_DATABASE)};
`}>
</script>

<script>
  let currentStep = 1;
  let selectedCategory = 'all';
  let selectedBrand = 'all';
  let selectedVehicleObj: any = null;
  let selectedYearGroupObj: any = null;
  let selectedColorName = 'ANY AVAILABLE COLOR';

  const catalog = window.catalogData || [];
  const yearGroups = window.yearGroupsData || [];

  // Default selection
  selectedVehicleObj = catalog.find((v: any) => v.id === 'toyota-corolla-altis') || catalog[0];

  // Render Model Cards
  const renderModelCards = () => {
    const container = document.getElementById('model-cards-container');
    if (!container) return;

    let filtered = catalog;

    if (selectedCategory && selectedCategory !== 'all') {
      filtered = filtered.filter((v: any) => {
        const cat = v.category.toLowerCase();
        if (selectedCategory === 'suv') return cat === 'suv' || cat === 'crossover' || cat === 'phev' || cat === 'hybrid' || cat === 'ev';
        if (selectedCategory === 'van') return cat === 'van';
        if (selectedCategory === 'coaster') return cat === 'coaster' || cat === 'bus';
        if (selectedCategory === 'bus') return cat === 'bus' || cat === 'coaster';
        if (selectedCategory === 'pickup') return cat === 'pickup';
        if (selectedCategory === 'luxury') return cat === 'luxury';
        if (selectedCategory === 'hatchback') return cat === 'hatchback';
        if (selectedCategory === 'sedan') return cat === 'sedan';
        return cat === selectedCategory;
      });
    }

    if (selectedBrand && selectedBrand !== 'all') {
      filtered = filtered.filter((v: any) => v.brandSlug.toLowerCase() === selectedBrand.toLowerCase());
    }

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 text-center space-y-3">
          <div class="text-amber-400 font-bold text-sm">No exact models found for this brand & category filter.</div>
          <button type="button" id="btn-reset-filters" class="bg-red-600 hover:bg-red-700 text-white font-bold text-xs px-4 py-2 rounded-xl">
            Show All Models
          </button>
        </div>
      `;
      document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
        selectedCategory = 'all';
        selectedBrand = 'all';
        renderModelCards();
      });
      return;
    }

    container.innerHTML = '';

    filtered.forEach((v: any) => {
      const isFleet = v.isFleetConfirmed || v.status === '4WHEELS Core Fleet';
      const statusBadge = isFleet
        ? `<span class="bg-emerald-950 text-emerald-400 border border-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded uppercase">✓ AVAILABLE THROUGH 4WHEELS</span>`
        : `<span class="bg-amber-950 text-amber-300 border border-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded uppercase">⚡ REQUEST THIS MODEL</span>`;

      const card = document.createElement('div');
      card.className = 'model-card bg-slate-950 border border-slate-800 hover:border-red-500 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center gap-4 transition-all duration-300 group cursor-pointer hover:shadow-xl hover:shadow-red-950/30';
      card.setAttribute('data-vehicle-id', v.id);

      card.innerHTML = `
        <div class="w-full sm:w-48 aspect-[16/9] bg-slate-900 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center p-2 relative shrink-0">
          <img
            src="${v.heroPhoto || '/vehicles/fleet/toyota-corolla/hero.webp'}"
            alt="${v.brand} ${v.model}"
            loading="lazy"
            class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
          />
        </div>

        <div class="flex-1 space-y-2 w-full">
          <div class="flex items-center justify-between flex-wrap gap-2">
            ${statusBadge}
            <span class="text-[10px] text-slate-400 font-bold uppercase">${v.category}</span>
          </div>

          <div>
            <h3 class="text-base sm:text-lg font-black text-white group-hover:text-red-400 transition-colors">
              ${v.brand} ${v.model}
            </h3>
            <p class="text-xs text-slate-400">${v.variant || v.tagline}</p>
          </div>

          <div class="flex flex-wrap gap-2 text-[11px] font-bold">
            <span class="bg-slate-900 text-slate-300 px-2 py-0.5 rounded border border-slate-800">${v.transmission}</span>
            <span class="bg-slate-900 text-slate-300 px-2 py-0.5 rounded border border-slate-800">${v.fuelType}</span>
            <span class="bg-slate-900 text-slate-300 px-2 py-0.5 rounded border border-slate-800">${v.seats} Seats</span>
          </div>
        </div>

        <div class="w-full sm:w-auto shrink-0 pt-2 sm:pt-0">
          <button type="button" class="btn-select-model w-full sm:w-auto bg-red-600 group-hover:bg-red-700 text-white font-extrabold text-xs px-5 py-3 rounded-xl shadow-md pointer-events-none" data-id="${v.id}">
            VIEW YEARS / SHAPES →
          </button>
        </div>
      `;

      card.addEventListener('click', () => {
        const found = catalog.find((item: any) => item.id === v.id);
        if (found) {
          selectedVehicleObj = found;
          renderYearShapeOptions();
          showStep(4);
        }
      });

      container.appendChild(card);
    });
  };

  // Render Year & Shape Options
  const renderYearShapeOptions = () => {
    const container = document.getElementById('year-shape-options-container');
    if (!container || !selectedVehicleObj) return;

    let matchingGroups = yearGroups.filter((g: any) =>
      g.modelSlug === selectedVehicleObj.slug || g.modelName.toLowerCase().includes(selectedVehicleObj.model.toLowerCase())
    );

    if (matchingGroups.length === 0) {
      matchingGroups = [{
        id: `${selectedVehicleObj.slug}-default`,
        modelSlug: selectedVehicleObj.slug,
        modelName: `${selectedVehicleObj.brand} ${selectedVehicleObj.model}`,
        startYear: 2022,
        endYear: 2026,
        customerLabel: `${selectedVehicleObj.modelYear || '2022–2026'} Current Shape`,
        generation: 'Verified Generation',
        heroPhoto: selectedVehicleObj.heroPhoto || '/vehicles/fleet/toyota-corolla/hero.webp',
        isFleetConfirmed: selectedVehicleObj.isFleetConfirmed,
        variants: [selectedVehicleObj.variant || 'Standard'],
        colors: selectedVehicleObj.colors || ['White', 'Black', 'Silver']
      }];
    }

    container.innerHTML = '';
    selectedYearGroupObj = matchingGroups[0];

    matchingGroups.forEach((g: any, index: number) => {
      const isSelected = index === 0;
      const card = document.createElement('div');
      card.className = `year-shape-card border rounded-2xl p-4 cursor-pointer transition-all duration-300 flex items-center gap-4 ${
        isSelected ? 'bg-red-600/20 border-red-500 ring-1 ring-red-500' : 'bg-slate-950 border-slate-800 hover:border-slate-700'
      }`;
      card.setAttribute('data-group-id', g.id);

      card.innerHTML = `
        <div class="w-28 h-20 bg-slate-900 rounded-xl overflow-hidden border border-slate-800 shrink-0 flex items-center justify-center p-1">
          <img src="${g.heroPhoto}" alt="${g.customerLabel}" class="w-full h-full object-contain" />
        </div>
        <div class="flex-1">
          <span class="text-[10px] font-black text-red-400 uppercase tracking-wider block">${g.generation}</span>
          <h4 class="text-sm font-black text-white">${g.customerLabel}</h4>
          <p class="text-[11px] text-slate-400 mt-0.5">${g.startYear}–${g.endYear} Production</p>
        </div>
        <div class="shrink-0">
          <span class="radio-indicator w-5 h-5 rounded-full border border-slate-600 flex items-center justify-center ${isSelected ? 'border-red-500 bg-red-600 text-white' : ''}">
            ${isSelected ? '✓' : ''}
          </span>
        </div>
      `;

      card.addEventListener('click', () => {
        document.querySelectorAll('.year-shape-card').forEach(c => {
          c.classList.remove('bg-red-600/20', 'border-red-500', 'ring-1', 'ring-red-500');
          c.classList.add('bg-slate-950', 'border-slate-800');
          const radio = c.querySelector('.radio-indicator');
          if (radio) {
            radio.className = 'radio-indicator w-5 h-5 rounded-full border border-slate-600 flex items-center justify-center';
            radio.textContent = '';
          }
        });
        card.classList.remove('bg-slate-950', 'border-slate-800');
        card.classList.add('bg-red-600/20', 'border-red-500', 'ring-1', 'ring-red-500');
        const radio = card.querySelector('.radio-indicator');
        if (radio) {
          radio.className = 'radio-indicator w-5 h-5 rounded-full border border-red-500 bg-red-600 text-white flex items-center justify-center';
          radio.textContent = '✓';
        }
        selectedYearGroupObj = g;
        updateSummary();
      });

      container.appendChild(card);
    });

    updateSummary();
  };

  // Color Swatches
  document.querySelectorAll('.color-swatch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.color-swatch-btn').forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');
        b.classList.add('bg-slate-950', 'text-slate-300', 'border-slate-800');
      });
      btn.classList.remove('bg-slate-950', 'text-slate-300', 'border-slate-800');
      btn.classList.add('bg-red-600', 'text-white', 'border-red-500', 'shadow-md', 'scale-105');

      selectedColorName = btn.getAttribute('data-color-name') || 'ANY AVAILABLE COLOR';
      updateSummary();
    });
  });

  // Category Cards Handlers
  document.querySelectorAll('.cat-card').forEach(card => {
    card.addEventListener('click', () => {
      const catId = card.getAttribute('data-cat-id');
      if (catId) {
        selectedCategory = catId;
        const catLabel = document.getElementById('selected-cat-label');
        if (catLabel) catLabel.textContent = catId.toUpperCase();
        showStep(2);
      }
    });
  });

  // Brand Tiles Handlers
  document.querySelectorAll('.brand-tile').forEach(tile => {
    tile.addEventListener('click', () => {
      const bSlug = tile.getAttribute('data-brand-slug');
      if (bSlug) {
        selectedBrand = bSlug;
        document.querySelectorAll('.brand-tile').forEach(t => {
          t.classList.remove('bg-red-600/20', 'border-red-500');
          t.classList.add('bg-slate-950', 'border-slate-800');
        });
        tile.classList.remove('bg-slate-950', 'border-slate-800');
        tile.classList.add('bg-red-600/20', 'border-red-500');
        renderModelCards();
        showStep(3);
      }
    });
  });

  document.getElementById('btn-toggle-all-brands')?.addEventListener('click', () => {
    document.querySelectorAll('.extra-brand').forEach(b => b.classList.toggle('hidden'));
  });

  document.querySelector('.btn-change-cat')?.addEventListener('click', () => showStep(1));
  document.querySelector('.btn-change-brand')?.addEventListener('click', () => showStep(2));
  document.querySelector('.btn-change-model')?.addEventListener('click', () => showStep(3));
  document.getElementById('btn-change-vehicle-main')?.addEventListener('click', () => showStep(1));
  document.getElementById('btn-change-vehicle-summary')?.addEventListener('click', () => showStep(1));
  document.getElementById('btn-confirm-year-color')?.addEventListener('click', () => showStep(5));

  // Route Calculation
  const calculateRouteDistance = () => {
    const pickupInput = document.getElementById('field-pickup') as HTMLInputElement;
    const destInput = document.getElementById('field-destination') as HTMLInputElement;
    const pickup = pickupInput ? pickupInput.value : '';
    const dest = destInput ? destInput.value : '';

    const normPickup = pickup.toLowerCase().trim();
    const normDest = dest.toLowerCase().trim();

    const encodedMapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(pickup)}&destination=${encodeURIComponent(dest)}&travelmode=driving`;

    const routeDb = window.verifiedRouteDb || [];
    let matchedRoute = null;

    for (const r of routeDb) {
      const origMatch = normPickup.includes(r.originSlug) || normPickup.includes(r.originCity.toLowerCase());
      const destMatch = normDest.includes(r.destinationSlug) || normDest.includes(r.destinationCity.toLowerCase());
      if (origMatch && destMatch) { matchedRoute = r; break; }
      const revOrigMatch = normPickup.includes(r.destinationSlug) || normPickup.includes(r.destinationCity.toLowerCase());
      const revDestMatch = normDest.includes(r.originSlug) || normDest.includes(r.originCity.toLowerCase());
      if (revOrigMatch && revDestMatch) { matchedRoute = r; break; }
    }

    const badgeElem = document.getElementById('calc-status-badge');
    const distElem = document.getElementById('route-calc-distance');
    const durElem = document.getElementById('route-calc-duration');
    const sumDist = document.getElementById('summary-distance');
    const googleMapsBtn = document.getElementById('btn-google-maps-check') as HTMLAnchorElement;

    if (matchedRoute) {
      const kmText = `Approx. ${matchedRoute.distanceKm} km`;
      const hrs = Math.floor(matchedRoute.typicalDurationMinutes / 60);
      const mins = matchedRoute.typicalDurationMinutes % 60;
      const durText = hrs > 0 ? `${hrs} hrs ${mins > 0 ? mins + ' mins' : ''}` : `${mins} mins`;

      if (badgeElem) badgeElem.textContent = '4WHEELS Verified Route Database';
      if (distElem) distElem.textContent = kmText;
      if (durElem) durElem.textContent = durText;
      if (sumDist) sumDist.textContent = kmText;
      if (googleMapsBtn) googleMapsBtn.href = matchedRoute.googleMapsUrl || encodedMapsUrl;
    } else {
      if (badgeElem) badgeElem.textContent = 'Route Distance to be Confirmed';
      if (distElem) distElem.textContent = 'To be confirmed';
      if (durElem) durElem.textContent = 'Depends on traffic';
      if (sumDist) sumDist.textContent = 'To be confirmed';
      if (googleMapsBtn) googleMapsBtn.href = encodedMapsUrl;
    }
  };

  // Dates Calculation
  const startDateInput = document.getElementById('field-start-date') as HTMLInputElement;
  const endDateInput = document.getElementById('field-end-date') as HTMLInputElement;
  const durationDisplay = document.getElementById('display-duration');
  const sumDuration = document.getElementById('summary-duration');

  const today = new Date();
  const tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);

  if (startDateInput && endDateInput) {
    startDateInput.min = today.toISOString().split('T')[0];
    startDateInput.value = today.toISOString().split('T')[0];
    endDateInput.min = startDateInput.value;
    endDateInput.value = tomorrow.toISOString().split('T')[0];
  }

  const calculateDatesDuration = () => {
    if (!startDateInput || !endDateInput) return;
    const start = new Date(startDateInput.value);
    const end = new Date(endDateInput.value);
    if (end < start) endDateInput.value = startDateInput.value;
    const diffTime = Math.abs(new Date(endDateInput.value).getTime() - new Date(startDateInput.value).getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) || 1;
    const text = `${diffDays} Rental Day${diffDays > 1 ? 's' : ''}`;

    if (durationDisplay) durationDisplay.textContent = text;
    if (sumDuration) sumDuration.textContent = text;
  };

  startDateInput?.addEventListener('change', () => {
    if (endDateInput && startDateInput) endDateInput.min = startDateInput.value;
    calculateDatesDuration();
  });
  endDateInput?.addEventListener('change', calculateDatesDuration);

  // Stepper Display Controller
  const showStep = (stepNumber: number) => {
    document.querySelectorAll('.step-panel').forEach(panel => panel.classList.add('hidden'));
    const targetPanel = document.getElementById(`step-panel-${stepNumber}`);
    if (targetPanel) targetPanel.classList.remove('hidden');

    document.querySelectorAll('.step-tab').forEach((tab, idx) => {
      const stepIdx = idx + 1;
      const circle = tab.querySelector('span:first-child');
      if (stepIdx === stepNumber) {
        tab.classList.add('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center text-xs';
      } else if (stepIdx < stepNumber) {
        tab.classList.remove('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs';
      } else {
        tab.classList.remove('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs';
      }
    });

    const mobileCounter = document.getElementById('mobile-step-counter');
    const mobileTitle = document.getElementById('mobile-step-title');
    if (mobileCounter) mobileCounter.textContent = `${stepNumber} of 7`;

    const titles = [
      '1. WHAT TYPE OF VEHICLE DO YOU NEED?',
      '2. CHOOSE A BRAND',
      '3. CHOOSE MODEL',
      '4. MODEL YEAR / SHAPE & COLOR',
      '5. PICKUP & DROP-OFF ROUTE',
      '6. RENTAL DATES & TRIP DETAILS',
      '7. REVIEW & WHATSAPP RESERVATION'
    ];
    if (mobileTitle) mobileTitle.textContent = titles[stepNumber - 1];

    currentStep = stepNumber;
    window.scrollTo({ top: 180, behavior: 'smooth' });
  };

  (window as any).showStep = showStep;

  // Interactive Stepper Tab Click
  document.querySelectorAll('.step-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetStepStr = tab.getAttribute('data-tab-step');
      if (targetStepStr) {
        const targetStep = parseInt(targetStepStr, 10);
        if (targetStep === 3) renderModelCards();
        if (targetStep === 4) renderYearShapeOptions();
        if (targetStep === 7) populateReviewScreen();
        showStep(targetStep);
      }
    });
  });

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep === 6) {
        const name = (document.getElementById('field-name') as HTMLInputElement)?.value;
        const phone = (document.getElementById('field-phone') as HTMLInputElement)?.value;
        if (!name || !phone) {
          alert('Please enter your Full Name and Phone/WhatsApp number.');
          return;
        }
        populateReviewScreen();
      }
      if (currentStep < 7) showStep(currentStep + 1);
    });
  });

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) showStep(currentStep - 1);
    });
  });

  // Dynamic Summary Updates
  const updateSummary = () => {
    if (!selectedVehicleObj) return;

    const brandName = selectedVehicleObj.brand || 'Toyota';
    const modelName = `${brandName} ${selectedVehicleObj.model || ''}`;
    const yearLabel = selectedYearGroupObj ? selectedYearGroupObj.customerLabel : (selectedVehicleObj.customerLabel || 'Current Shape');
    const photoUrl = selectedYearGroupObj ? selectedYearGroupObj.heroPhoto : (selectedVehicleObj.heroPhoto || '/vehicles/fleet/toyota-corolla/hero.webp');

    const preTitle = document.getElementById('preselect-title');
    const preSub = document.getElementById('preselect-subtitle');

    const sBrand = document.getElementById('summary-brand');
    const sModel = document.getElementById('summary-model');
    const sSpecs = document.getElementById('summary-specs');
    const sYearLabel = document.getElementById('summary-year-label');
    const sColorLabel = document.getElementById('summary-color-label');
    const sBadge = document.getElementById('summary-badge');
    const sPickup = document.getElementById('summary-pickup');
    const sDropoff = document.getElementById('summary-dropoff');
    const sVisual = document.getElementById('summary-visual-img') as HTMLImageElement;

    const pickup = (document.getElementById('field-pickup') as HTMLInputElement)?.value || 'Johar Town, Lahore';
    const dest = (document.getElementById('field-destination') as HTMLInputElement)?.value || 'Islamabad F-7';

    if (preTitle) preTitle.textContent = modelName;
    if (preSub) preSub.textContent = `${yearLabel} • Preferred Color: ${selectedColorName}`;

    if (sBrand) sBrand.textContent = brandName.toUpperCase();
    if (sModel) sModel.textContent = selectedVehicleObj.model;
    if (sSpecs) sSpecs.textContent = `${yearLabel} • ${selectedVehicleObj.transmission} • ${selectedVehicleObj.fuelType}`;

    if (sYearLabel) sYearLabel.textContent = yearLabel;
    if (sColorLabel) sColorLabel.textContent = selectedColorName;

    const isFleet = selectedVehicleObj.isFleetConfirmed || selectedVehicleObj.status === '4WHEELS Core Fleet';
    if (sBadge) {
      sBadge.textContent = isFleet ? 'AVAILABLE THROUGH 4WHEELS' : 'REQUEST MODEL';
      sBadge.className = isFleet
        ? 'text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold px-2 py-0.5 rounded uppercase'
        : 'text-[10px] bg-amber-950 text-amber-300 border border-amber-800 font-bold px-2 py-0.5 rounded uppercase';
    }

    if (sPickup) sPickup.textContent = pickup;
    if (sDropoff) sDropoff.textContent = dest;

    if (sVisual) sVisual.src = photoUrl;

    calculateRouteDistance();
    calculateDatesDuration();
  };

  document.getElementById('field-pickup')?.addEventListener('input', updateSummary);
  document.getElementById('field-destination')?.addEventListener('input', updateSummary);
  document.getElementById('field-mode')?.addEventListener('change', updateSummary);

  // Passengers & Luggage Controls
  const pInput = document.getElementById('field-passengers') as HTMLInputElement;
  const lInput = document.getElementById('field-luggage') as HTMLInputElement;

  document.getElementById('btn-inc-passengers')?.addEventListener('click', () => {
    if (pInput) { pInput.value = (parseInt(pInput.value) + 1).toString(); }
  });
  document.getElementById('btn-dec-passengers')?.addEventListener('click', () => {
    if (pInput && parseInt(pInput.value) > 1) { pInput.value = (parseInt(pInput.value) - 1).toString(); }
  });
  document.getElementById('btn-inc-luggage')?.addEventListener('click', () => {
    if (lInput) { lInput.value = (parseInt(lInput.value) + 1).toString(); }
  });
  document.getElementById('btn-dec-luggage')?.addEventListener('click', () => {
    if (lInput && parseInt(lInput.value) > 0) { lInput.value = (parseInt(lInput.value) - 1).toString(); }
  });

  // Populate Review Screen
  const populateReviewScreen = () => {
    if (!selectedVehicleObj) return;

    const brandName = selectedVehicleObj.brand || '';
    const modelName = `${brandName} ${selectedVehicleObj.model}`;
    const yearLabel = selectedYearGroupObj ? selectedYearGroupObj.customerLabel : (selectedVehicleObj.customerLabel || 'Current Shape');
    const isFleet = selectedVehicleObj.isFleetConfirmed || selectedVehicleObj.status === '4WHEELS Core Fleet';

    const rVehicle = document.getElementById('review-vehicle-title');
    const rYearShape = document.getElementById('review-year-shape');
    const rColorPref = document.getElementById('review-color-pref');
    const rStatus = document.getElementById('review-status-badge');

    const pickup = (document.getElementById('field-pickup') as HTMLInputElement)?.value || '';
    const dest = (document.getElementById('field-destination') as HTMLInputElement)?.value || '';
    const distText = document.getElementById('route-calc-distance')?.textContent || '375 km';

    const start = (document.getElementById('field-start-date') as HTMLInputElement)?.value || '';
    const end = (document.getElementById('field-end-date') as HTMLInputElement)?.value || '';
    const daysText = durationDisplay?.textContent || '1 Day';

    const pCount = pInput ? pInput.value : '4';
    const lCount = lInput ? lInput.value : '2';

    const name = (document.getElementById('field-name') as HTMLInputElement)?.value || '';
    const phone = (document.getElementById('field-phone') as HTMLInputElement)?.value || '';

    const rPickup = document.getElementById('review-pickup');
    const rDest = document.getElementById('review-destination');
    const rDist = document.getElementById('review-distance');
    const rMode = document.getElementById('review-mode');

    const rStart = document.getElementById('review-start-date');
    const rEnd = document.getElementById('review-end-date');
    const rDur = document.getElementById('review-duration');
    const rCap = document.getElementById('review-capacity');

    const rName = document.getElementById('review-name');
    const rPhone = document.getElementById('review-phone');

    if (rVehicle) rVehicle.textContent = modelName;
    if (rYearShape) rYearShape.textContent = yearLabel;
    if (rColorPref) rColorPref.textContent = `Color: ${selectedColorName}`;

    if (rStatus) {
      if (isFleet) {
        rStatus.textContent = 'AVAILABLE THROUGH 4WHEELS';
        rStatus.className = 'bg-emerald-950 text-emerald-400 border border-emerald-800 px-2.5 py-0.5 rounded font-bold';
      } else {
        rStatus.textContent = 'REQUEST THIS MODEL';
        rStatus.className = 'bg-amber-950 text-amber-300 border border-amber-800 px-2.5 py-0.5 rounded font-bold';
      }
    }

    if (rPickup) rPickup.textContent = pickup;
    if (rDest) rDest.textContent = dest;
    if (rDist) rDist.textContent = distText;
    if (rMode) rMode.textContent = (document.getElementById('field-mode') as HTMLSelectElement)?.value || 'With Driver';

    if (rStart) rStart.textContent = start;
    if (rEnd) rEnd.textContent = end;
    if (rDur) rDur.textContent = daysText;
    if (rCap) rCap.textContent = `${pCount} Pax, ${lCount} Bags`;

    if (rName) rName.textContent = name;
    if (rPhone) rPhone.textContent = phone;
  };

  // Structured WhatsApp Message
  const buildWhatsAppMessage = () => {
    if (!selectedVehicleObj) return '';

    const brandName = selectedVehicleObj.brand || '';
    const modelName = `${brandName} ${selectedVehicleObj.model}`;
    const yearLabel = selectedYearGroupObj ? selectedYearGroupObj.customerLabel : (selectedVehicleObj.customerLabel || 'Current Shape');
    const isFleet = selectedVehicleObj.isFleetConfirmed || selectedVehicleObj.status === '4WHEELS Core Fleet';

    const pickup = (document.getElementById('field-pickup') as HTMLInputElement)?.value || '';
    const dest = (document.getElementById('field-destination') as HTMLInputElement)?.value || '';
    const distText = document.getElementById('route-calc-distance')?.textContent || '375 km';

    const start = (document.getElementById('field-start-date') as HTMLInputElement)?.value || '';
    const end = (document.getElementById('field-end-date') as HTMLInputElement)?.value || '';
    const daysText = durationDisplay?.textContent || '1 Day';

    const pCount = pInput ? pInput.value : '4';
    const lCount = lInput ? lInput.value : '2';
    const mode = (document.getElementById('field-mode') as HTMLSelectElement)?.value || 'With Driver';
    const purpose = (document.getElementById('field-purpose') as HTMLSelectElement)?.value || 'Outstation Travel';

    const name = (document.getElementById('field-name') as HTMLInputElement)?.value || '';
    const phone = (document.getElementById('field-phone') as HTMLInputElement)?.value || '';
    const notes = (document.getElementById('field-notes') as HTMLTextAreaElement)?.value || '';

    if (!isFleet) {
      return (
        'Hello 4WHEELS, I would like to request availability for this vehicle model.\n\n' +
        '🚗 REQUESTED VEHICLE MODEL\n' +
        `• Vehicle: ${modelName}\n` +
        `• Model Year / Shape: ${yearLabel}\n` +
        `• Preferred Color: ${selectedColorName}\n` +
        `• Category: ${selectedVehicleObj.category.toUpperCase()}\n` +
        `• Transmission: ${selectedVehicleObj.transmission}\n` +
        `• Fuel Type: ${selectedVehicleObj.fuelType}\n` +
        `• Rental Mode: ${mode}\n\n` +
        '📍 ROUTE & DATES\n' +
        `• Pickup: ${pickup}\n` +
        `• Drop-off: ${dest}\n` +
        `• Estimated Distance: ${distText}\n` +
        `• Start Date: ${start}\n` +
        `• End Date: ${end}\n` +
        `• Total Duration: ${daysText}\n\n` +
        '👥 TRAVELERS & DETAILS\n' +
        `• Passengers: ${pCount} Occupants\n` +
        `• Luggage: ${lCount} Suitcases\n` +
        `• Purpose: ${purpose}\n\n` +
        '👤 CUSTOMER INFORMATION\n' +
        `• Name: ${name}\n` +
        `• Phone: ${phone}\n` +
        (notes ? `• Special Notes: ${notes}\n` : '') +
        '\nPlease confirm whether this requested vehicle or model year can be arranged.'
      );
    }

    return (
      'Hello 4WHEELS, I would like to send a configured rental inquiry.\n\n' +
      '🚗 SELECTED VEHICLE\n' +
      `• Vehicle: ${modelName}\n` +
      `• Model Year / Shape: ${yearLabel}\n` +
      `• Preferred Color: ${selectedColorName}\n` +
      `• Category: ${selectedVehicleObj.category.toUpperCase()}\n` +
      `• Transmission: ${selectedVehicleObj.transmission}\n` +
      `• Rental Mode: ${mode}\n\n` +
      '📍 ROUTE & DATES\n' +
      `• Pickup: ${pickup}\n` +
      `• Drop-off: ${dest}\n` +
      `• Estimated Distance: ${distText}\n` +
      `• Start Date: ${start}\n` +
      `• End Date: ${end}\n` +
      `• Total Duration: ${daysText}\n\n` +
      '👥 TRAVELERS & PURPOSE\n' +
      `• Passengers: ${pCount} Occupants\n` +
      `• Luggage: ${lCount} Suitcases\n` +
      `• Trip Purpose: ${purpose}\n\n` +
      '👤 CUSTOMER INFORMATION\n' +
      `• Name: ${name}\n` +
      `• Phone: ${phone}\n` +
      (notes ? `• Special Notes: ${notes}\n` : '') +
      '\nPlease confirm vehicle availability and current rental quotation. Thank you.'
    );
  };

  document.getElementById('btn-send-whatsapp')?.addEventListener('click', () => {
    const text = buildWhatsAppMessage();
    window.open(`https://wa.me/923216616644?text=${encodeURIComponent(text)}`, '_blank');
  });

  const copyToast = document.getElementById('copy-toast');
  document.getElementById('btn-copy-inquiry')?.addEventListener('click', () => {
    const text = buildWhatsAppMessage();
    navigator.clipboard.writeText(text).then(() => {
      if (copyToast) {
        copyToast.classList.remove('hidden');
        setTimeout(() => copyToast.classList.add('hidden'), 3000);
      }
    });
  });

  document.getElementById('btn-edit-booking')?.addEventListener('click', () => showStep(5));

  // Mobile Drawer
  document.getElementById('btn-toggle-mobile-drawer')?.addEventListener('click', () => {
    const drawer = document.getElementById('summary-drawer');
    const arrow = document.getElementById('drawer-arrow-icon');
    if (drawer) {
      drawer.classList.toggle('hidden');
      if (arrow) arrow.textContent = drawer.classList.contains('hidden') ? '▲' : '▼';
    }
  });

  // Handle URL Pre-selection (Quick Book Mode / Preselected vehicle entry)
  const urlParams = new URLSearchParams(window.location.search);
  const paramVehicle = urlParams.get('vehicle');
  const paramBrand = urlParams.get('brand');
  const paramCategory = urlParams.get('category');

  if (paramVehicle) {
    const found = catalog.find((v: any) => v.slug === paramVehicle || v.id === paramVehicle);
    if (found) {
      selectedVehicleObj = found;
      renderYearShapeOptions();
      updateSummary();
      showStep(5); // Direct to Route step for pre-selected vehicle
    }
  } else if (paramBrand) {
    selectedBrand = paramBrand.toLowerCase();
    renderModelCards();
    showStep(3);
  } else if (paramCategory) {
    selectedCategory = paramCategory.toLowerCase();
    showStep(2);
  } else {
    updateSummary();
  }
</script>
