---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import { getCollection } from 'astro:content';
import { BUSINESS_INFO } from '../../data/business';

const pageTitle = `4WHEELS Editorial Team - Author Profile`;
const pageDescription = `Learn about the 4WHEELS Editorial Team, producing factual car rental guidance based on operational experience in Lahore since 2008.`;

const posts = await getCollection('blog');
const publishedPosts = posts.filter((p) => p.data.index && !p.data.draft);
---

<html lang="en">
  <head>
    <SEOHead title={pageTitle} description={pageDescription} canonicalUrl={`${BUSINESS_INFO.siteUrl}/authors/4wheels-editorial-team/`} />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <Header />

    <main class="max-w-5xl mx-auto px-4 py-12">
      <!-- Author Profile Card -->
      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-200 mb-12">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6 text-center md:text-left">
          <div class="w-24 h-24 rounded-full bg-red-600 text-white font-black text-3xl flex items-center justify-center shrink-0 shadow-lg">
            4W
          </div>
          <div>
            <span class="inline-block px-3 py-1 bg-red-100 text-red-800 text-xs font-bold rounded-full mb-2">Verified Editorial Team</span>
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">4WHEELS Editorial Team</h1>
            <p class="text-slate-600 mt-3 text-base leading-relaxed max-w-2xl">
              The 4WHEELS Editorial Team produces practical, accurate, and realistic car rental guidance based on 4WHEELS' direct experience serving local, corporate, and international car-rental customers in Lahore since 2008.
            </p>
            <div class="mt-4 flex flex-wrap gap-4 text-xs font-semibold text-slate-500 justify-center md:justify-start">
              <span>• Factual Lahore Rental Guidance</span>
              <span>• Non-Promotional Advice</span>
              <span>• Updated Regularly</span>
              <a href="/editorial-policy/" class="text-red-600 hover:underline">Read Editorial Policy &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Articles Authored -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Published Guides ({publishedPosts.length})</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {publishedPosts.slice(0, 10).map((post) => (
            <article class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-slate-300 transition">
              <span class="px-2.5 py-0.5 bg-slate-100 text-slate-700 text-xs font-bold rounded mb-2 inline-block">{post.data.category}</span>
              <h3 class="text-lg font-bold text-slate-900 mb-2 hover:text-red-600 transition">
                <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
              </h3>
              <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed mb-4">{post.data.description}</p>
              <a href={`/blog/${post.data.slug}/`} class="text-xs font-bold text-red-600 hover:underline">Read Guide &rarr;</a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
