---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { getPublishedLocations, getLocationBySlug } from '../../data/locations';
import { BUSINESS_INFO } from '../../data/business';

export function getStaticPaths() {
  return getPublishedLocations().map(loc => ({
    params: { location: loc.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;

if (!loc) {
  return Astro.redirect('/404');
}

const pageTitle = `Rent a Car in ${loc.city} | 4WHEELS Vehicle Rental`;
const pageDescription = `${loc.classification} - Vehicle rental service for ${loc.city}, ${loc.province}. ${loc.serviceOverview} Book sedans, SUVs, and vans with 4WHEELS on WhatsApp.`;
const canonicalPath = `/locations/${loc.slug}/`;

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations/' },
  { name: loc.city, path: canonicalPath }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRental",
  "name": `4WHEELS Rent a Car ${loc.city}`,
  "url": `${BUSINESS_INFO.siteUrl}${canonicalPath}`,
  "telephone": "+923216616644",
  "priceRange": "PKR 3,800 - PKR 65,000",
  "currenciesAccepted": "PKR",
  "paymentAccepted": "Cash, Bank Transfer, Online Payment",
  "description": loc.serviceOverview,
  "provider": {
    "@type": "AutoRental",
    "name": BUSINESS_INFO.name,
    "telephone": "+923216616644",
    "url": BUSINESS_INFO.siteUrl,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": BUSINESS_INFO.address.street,
      "addressLocality": "Johar Town Phase 1, Lahore",
      "addressRegion": "Punjab",
      "postalCode": "54792",
      "addressCountry": "PK"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": loc.city,
    "containedInPlace": {
      "@type": "AdministrativeArea",
      "name": loc.province
    }
  }
};
---

<Layout title={pageTitle} description={pageDescription} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <BreadcrumbSchema items={breadcrumbItems} />

  <main class="bg-slate-50 text-slate-800 min-h-screen pb-16">
    <!-- Breadcrumbs -->
    <nav class="bg-white border-b border-slate-200 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-500" aria-label="Breadcrumb">
      <div class="max-w-5xl mx-auto flex items-center space-x-2">
        <a href="/" class="hover:text-red-600 transition-colors">Home</a>
        <span>›</span>
        <a href="/locations/" class="hover:text-red-600 transition-colors">Locations</a>
        <span>›</span>
        <span class="text-slate-800 font-semibold truncate">{loc.city}</span>
      </div>
    </nav>

    <!-- Header Hero -->
    <section class="bg-gradient-to-b from-slate-50 via-white to-slate-100/60 border-b border-slate-200 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center space-y-4">
        <span class={`inline-block text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider ${
          loc.classification === 'OFFICIAL LOCATION'
            ? 'bg-red-600 text-white'
            : 'bg-amber-50 text-amber-800 border border-amber-200'
        }`}>
          {loc.classification}
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
          Rent a Car in {loc.city}
        </h1>
        <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          {loc.serviceOverview}
        </p>

        {loc.classification !== 'OFFICIAL LOCATION' && (
          <div class="bg-white border border-slate-200 rounded-xl p-3.5 max-w-xl mx-auto text-xs text-slate-600 shadow-xs">
            ℹ️ <span class="text-slate-900 font-bold">Location Policy:</span> 4WHEELS primary physical head office is situated exclusively in <span class="text-slate-900 font-bold">Johar Town Phase 1, Lahore</span>. Transport for {loc.city} is dispatched as intercity chauffeur service or verified long-term delivery.
          </div>
        )}
      </div>
    </section>

    <!-- Content Specs & Details -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-10">

      <!-- Quick Specs Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div class="auto-card bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
          <p class="text-slate-500 font-medium mb-1">📍 Distance from Lahore Hub</p>
          <p class="text-slate-900 font-bold text-base">
            {loc.approxDistanceKmFromLahore === 0 ? 'Main Head Office Hub' : `~${loc.approxDistanceKmFromLahore} km`}
          </p>
        </div>

        <div class="auto-card bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
          <p class="text-slate-500 font-medium mb-1">🛫 Nearest Airport</p>
          <p class="text-slate-900 font-bold text-base truncate">
            {loc.airport || 'Intercity Express Motorway'}
          </p>
        </div>

        <div class="auto-card bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
          <p class="text-slate-500 font-medium mb-1">🚘 Supported Vehicles</p>
          <p class="text-slate-900 font-bold text-base truncate">
            {loc.vehicleTypesAvailable.join(', ')}
          </p>
        </div>
      </div>

      <!-- Common Routes -->
      {loc.commonRoutes && loc.commonRoutes.length > 0 && (
        <section class="auto-card bg-white border border-slate-200 rounded-2xl p-6 space-y-4 shadow-xs">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>🛣️ Frequently Traveled Intercity Routes</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
            {loc.commonRoutes.map(route => (
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-slate-800 flex justify-between items-center">
                <span>{route}</span>
                <a href="/trip-planner/" class="text-xs font-bold text-red-600 hover:text-red-700">Plan →</a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Location FAQ -->
      {loc.faqs && loc.faqs.length > 0 && (
        <FAQ
          title={`Frequently Asked Questions: ${loc.city}`}
          items={loc.faqs}
        />
      )}

      <!-- Booking CTA Section -->
      <CTASection
        title={`Book Your Vehicle for ${loc.city}`}
        description={`Configure your rental duration and vehicle type for travel in or to ${loc.city} with 4WHEELS Rent a Car.`}
        primaryBtnText="Book Your Trip"
        primaryBtnHref="/booking/"
      />

    </div>
  </main>
</Layout>
