---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { getPublishedLocations, getLocationBySlug } from '../../data/locations';
import { BUSINESS_INFO } from '../../data/business';

export function getStaticPaths() {
  return getPublishedLocations().map(loc => ({
    params: { location: loc.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;

if (!loc) {
  return Astro.redirect('/404');
}

const pageTitle = `Rent a Car in ${loc.city} | 4WHEELS Vehicle Rental`;
const pageDescription = `${loc.classification} - Vehicle rental service for ${loc.city}, ${loc.province}. ${loc.serviceOverview} Book sedans, SUVs, and vans with 4WHEELS on WhatsApp.`;
const canonicalUrl = `https://4wheelsrentacar.pk/locations/${loc.slug}/`;

const locationSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": `${loc.city} Vehicle Service`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": loc.city,
    "addressRegion": loc.province,
    "addressCountry": "PK"
  },
  "description": loc.serviceOverview
};
---

<Layout title={pageTitle}>
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    canonicalUrl={canonicalUrl}
  />

  <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} />

  <main class="bg-slate-950 text-slate-100 min-h-screen pb-16">
    <!-- Breadcrumbs -->
    <nav class="bg-slate-900 border-b border-slate-800 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-400" aria-label="Breadcrumb">
      <div class="max-w-5xl mx-auto flex items-center space-x-2">
        <a href="/" class="hover:text-white">Home</a>
        <span>›</span>
        <a href="/locations/" class="hover:text-white">Locations</a>
        <span>›</span>
        <span class="text-slate-200 font-semibold truncate">{loc.city}</span>
      </div>
    </nav>

    <!-- Header Hero -->
    <section class="bg-slate-900 border-b border-slate-800 py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center space-y-4">
        <span class={`inline-block text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider ${
          loc.classification === 'OFFICIAL LOCATION'
            ? 'bg-red-600 text-white'
            : 'bg-slate-800 text-amber-400 border border-amber-500/30'
        }`}>
          {loc.classification}
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Rent a Car in {loc.city}
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          {loc.serviceOverview}
        </p>

        {loc.classification !== 'OFFICIAL LOCATION' && (
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3.5 max-w-xl mx-auto text-xs text-slate-400">
            ℹ️ <span class="text-slate-200 font-bold">Location Policy:</span> 4WHEELS primary physical head office is situated exclusively in <span class="text-white font-bold">Johar Town Phase 1, Lahore</span>. Transport for {loc.city} is dispatched as intercity chauffeur service or verified long-term delivery.
          </div>
        )}
      </div>
    </section>

    <!-- Content Specs & Details -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-10">

      <!-- Quick Specs Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
          <p class="text-slate-400 font-medium mb-1">📍 Distance from Lahore Hub</p>
          <p class="text-slate-100 font-bold text-base">
            {loc.approxDistanceKmFromLahore === 0 ? 'Main Head Office Hub' : `~${loc.approxDistanceKmFromLahore} km`}
          </p>
        </div>

        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
          <p class="text-slate-400 font-medium mb-1">🛫 Nearest Airport</p>
          <p class="text-slate-100 font-bold text-base truncate">
            {loc.airport || 'Intercity Express Motorway'}
          </p>
        </div>

        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800">
          <p class="text-slate-400 font-medium mb-1">🚘 Supported Vehicles</p>
          <p class="text-slate-100 font-bold text-base truncate">
            {loc.vehicleTypesAvailable.join(', ')}
          </p>
        </div>
      </div>

      <!-- Common Routes -->
      {loc.commonRoutes && loc.commonRoutes.length > 0 && (
        <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span>🛣️ Frequently Traveled Intercity Routes</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
            {loc.commonRoutes.map(route => (
              <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-slate-200 flex justify-between items-center">
                <span>{route}</span>
                <a href="/trip-planner/" class="text-xs font-bold text-amber-400 hover:text-amber-300">Plan →</a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Location FAQ -->
      {loc.faqs && loc.faqs.length > 0 && (
        <FAQ
          title={`Frequently Asked Questions: ${loc.city}`}
          items={loc.faqs}
        />
      )}

      <!-- Booking CTA Section -->
      <CTASection
        title={`Book Your Vehicle for ${loc.city}`}
        description={`Configure your rental duration and vehicle type for travel in or to ${loc.city} with 4WHEELS Rent a Car.`}
        primaryBtnText="Book Your Trip"
        primaryBtnHref="/build-your-rental/"
      />

    </div>
  </main>
</Layout>
