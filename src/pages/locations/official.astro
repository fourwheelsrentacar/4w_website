---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS_INFO } from '../../data/business';

const pageTitle = "Official 4WHEELS Rent a Car Locations | Johar Town Lahore";
const pageDescription = "View confirmed official 4WHEELS Rent a Car physical office locations. Only locations listed on this page are confirmed official branches.";
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/locations/official/">
  <SEOHead
    slot="seo"
    title={pageTitle}
    description={pageDescription}
    canonicalPath="/locations/official/"
  />

  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block bg-red-600 text-white font-extrabold text-xs uppercase px-3 py-1 rounded tracking-wider mb-4">
        Verified Branches
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 text-white">
        Official 4WHEELS Locations
      </h1>
      <p class="text-lg sm:text-xl text-red-400 font-semibold mb-6">
        {BUSINESS_INFO.trustWording}
      </p>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Only locations listed on this page are confirmed official 4WHEELS Rent a Car locations.
      </p>
    </div>
  </section>

  <!-- Location Verification List -->
  <section class="py-12 bg-slate-50 text-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Primary Physical Office Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 mb-8">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-6">
          <div>
            <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded mb-1">
              ✓ Verified Head Office & Main Fleet Hub
            </span>
            <h2 class="text-2xl font-bold text-slate-900">
              Johar Town Phase 1, Lahore
            </h2>
          </div>
          <span class="text-2xl">🏢</span>
        </div>

        <div class="space-y-4 text-sm sm:text-base">
          <div>
            <strong class="text-slate-900">Address:</strong>
            <p class="text-slate-700 mt-0.5">{BUSINESS_INFO.address.fullAddress}</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-100">
            <div>
              <strong class="text-slate-900">Phone:</strong>
              <p><a href={BUSINESS_INFO.telLink} class="text-red-600 font-bold hover:underline">{BUSINESS_INFO.phoneDisplay}</a></p>
            </div>
            <div>
              <strong class="text-slate-900">WhatsApp:</strong>
              <p><a href={BUSINESS_INFO.whatsappLink} target="_blank" class="text-emerald-600 font-bold hover:underline">{BUSINESS_INFO.phoneInternational}</a></p>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100">
            <strong class="text-slate-900">Services Available:</strong>
            <p class="text-slate-700 text-sm mt-1">
              Self-Drive Car Rental, Chauffeur-Driven Cars, Airport Transfers, Wedding Fleet, Corporate Fleet & Outstation Group Transport.
            </p>
          </div>
        </div>
      </div>

      <!-- Verified Location Notice -->
      <div class="bg-slate-900 text-slate-200 rounded-2xl p-6 sm:p-8 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
          ℹ️ Intercity Travel & Dispatch Notice
        </h3>
        <p class="text-sm leading-relaxed text-slate-300 mb-4">
          While 4WHEELS Rent a Car provides chauffeur-driven intercity transport and travel services to Islamabad, Rawalpindi, Multan, Faisalabad, and other Pakistan travel destinations, physical vehicle dispatches and head office operations are managed directly from our verified Johar Town Phase 1, Lahore headquarters.
        </p>
        <p class="text-sm font-semibold text-red-400">
          Only locations listed on this page are confirmed official 4WHEELS Rent a Car locations.
        </p>
      </div>

    </div>
  </section>

  <CTASection
    title="Need Vehicle Service in Lahore or Intercity Travel?"
    description="Contact official 4WHEELS customer care for verified booking and vehicle availability."
    primaryButtonText="💬 WhatsApp Customer Care"
    primaryButtonHref={BUSINESS_INFO.whatsappLink}
  />
</Layout>
