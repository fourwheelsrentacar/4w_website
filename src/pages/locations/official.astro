---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import CTASection from '../../components/CTASection.astro';
import { BUSINESS_INFO } from '../../data/business';
import { getContextualWhatsAppUrl } from '../../utils/whatsappContext';

const pageTitle = "Official 4WHEELS Rent a Car Locations | Johar Town Lahore";
const pageDescription = "View confirmed official 4WHEELS Rent a Car physical office location in Johar Town Phase 1, Lahore. Only locations listed on this page are confirmed official branches.";

const mapsSearchUrl = BUSINESS_INFO.mapsSearchUrl;
const mapsDirectionsUrl = BUSINESS_INFO.mapsDirectionsUrl;
const waUrl = getContextualWhatsAppUrl({
  pageTitle: 'Official Office Location',
  canonicalUrl: `${BUSINESS_INFO.siteUrl}/locations/official/`,
});
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/locations/official/">
  <SEOHead
    slot="seo"
    title={pageTitle}
    description={pageDescription}
    canonicalPath="/locations/official/"
  />

  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block bg-red-600 text-white font-extrabold text-xs uppercase px-3 py-1 rounded tracking-wider mb-4">
        Verified Physical Branch
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 text-white">
        Official 4WHEELS Office Location
      </h1>
      <p class="text-lg sm:text-xl text-red-400 font-semibold mb-6">
        {BUSINESS_INFO.trustBadge} — {BUSINESS_INFO.trustWording}
      </p>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Only physical offices listed on this official location page are confirmed 4WHEELS Rent a Car branches.
      </p>
    </div>
  </section>

  <!-- Location Verification List -->
  <section class="py-12 bg-slate-50 text-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Primary Physical Office Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 mb-8">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-6">
          <div>
            <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded mb-1">
              ✓ Verified Head Office & Main Fleet Hub
            </span>
            <h2 class="text-2xl font-bold text-slate-900">
              Johar Town Phase 1, Lahore
            </h2>
          </div>
          <span class="text-3xl">🏢</span>
        </div>

        <div class="space-y-4 text-sm sm:text-base mb-6">
          <div>
            <strong class="text-slate-900">Full Postal Address:</strong>
            <p class="text-slate-700 mt-0.5 font-medium">{BUSINESS_INFO.address.fullAddress}</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-100">
            <div>
              <strong class="text-slate-900">Official Phone:</strong>
              <p><a href={BUSINESS_INFO.telLink} class="text-red-600 font-bold hover:underline">{BUSINESS_INFO.phoneDisplay}</a></p>
            </div>
            <div>
              <strong class="text-slate-900">Official WhatsApp:</strong>
              <p><a href={waUrl} target="_blank" class="text-emerald-600 font-bold hover:underline">{BUSINESS_INFO.phoneInternational}</a></p>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100">
            <strong class="text-slate-900">Location Accessibility:</strong>
            <p class="text-slate-700 text-sm mt-1">
              Situated directly on the main road with clear vehicular entry, convenient customer parking, and quick dispatch access across Lahore.
            </p>
          </div>

          <div class="pt-2 border-t border-slate-100">
            <strong class="text-slate-900">Services Available at Head Office:</strong>
            <p class="text-slate-700 text-sm mt-1">
              Self-Drive Car Rental, Chauffeur-Driven Cars, Airport Transfers, Wedding Fleet, Corporate Fleet & Outstation Group Transport.
            </p>
          </div>
        </div>

        <!-- Google Maps Action Buttons -->
        <div class="flex flex-wrap gap-3 pt-4 border-t border-slate-100">
          <a
            href={mapsSearchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-4 py-2.5 rounded-lg transition-colors flex items-center gap-1.5"
          >
            🗺️ VIEW ON GOOGLE MAPS
          </a>
          <a
            href={mapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-4 py-2.5 rounded-lg transition-colors flex items-center gap-1.5"
          >
            🧭 GET DIRECTIONS
          </a>
          <a
            href={BUSINESS_INFO.telLink}
            class="bg-red-600 hover:bg-red-700 text-white font-bold text-xs px-4 py-2.5 rounded-lg transition-colors flex items-center gap-1.5"
          >
            📞 CALL
          </a>
        </div>
      </div>

      <!-- Service Area vs Branch Clarification Notice -->
      <div class="bg-slate-900 text-slate-200 rounded-2xl p-6 sm:p-8 border border-slate-800 mb-8">
        <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
          ℹ️ Service Area vs. Physical Branch Clarification
        </h3>
        <p class="text-sm leading-relaxed text-slate-300 mb-4">
          While 4WHEELS Rent a Car delivers vehicle rentals across Lahore (DHA, Gulberg, Model Town, Cantt, Bahria Town, Allama Iqbal International Airport) and provides outstation trips to Islamabad, Rawalpindi, Multan, and Faisalabad, physical vehicle dispatches are managed strictly from our verified <strong>Johar Town Phase 1, Lahore headquarters</strong>.
        </p>
        <p class="text-sm font-semibold text-red-400">
          We do not operate secondary physical branches in other cities. Please verify any claimed branch or franchise directly via 0321 6616644.
        </p>
      </div>

      <!-- Verification Reminder -->
      <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-xl text-slate-800">
        <h4 class="text-sm font-bold text-amber-900 mb-1">Verify Before Payment</h4>
        <p class="text-xs sm:text-sm text-slate-700">
          Please verify booking and payment instructions directly with official 4WHEELS customer care at <strong>0321 6616644</strong> before completing any transaction.
        </p>
      </div>

    </div>
  </section>

  <CTASection
    heading="Need Vehicle Service in Lahore or Intercity Travel?"
    subheading="Contact official 4WHEELS customer care for verified booking and vehicle availability."
    primaryButtonText="💬 WhatsApp Customer Care"
    primaryButtonHref={waUrl}
  />
</Layout>
