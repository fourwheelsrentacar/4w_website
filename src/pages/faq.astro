---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { BUSINESS_INFO } from '../data/business';

const title = "Frequently Asked Questions | 4WHEELS Rent a Car Lahore";
const description = "Find answers to frequently asked questions about car rental in Lahore with 4WHEELS. Learn about official domains, self-drive, chauffeur options, monthly rentals, airport transfers, and booking verification.";
const canonicalPath = "/faq/";

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: canonicalPath }
];

const allFaqs = [
  {
    question: "What is the official 4WHEELS website?",
    answer: "The official production website of 4WHEELS Rent a Car is www.4wheelspk.com. All canonical pages, vehicle specs, and booking configurators derive strictly from this domain."
  },
  {
    question: "How do I book a car with 4WHEELS?",
    answer: "You can configure your trip step-by-step using our visual booking configurator at www.4wheelspk.com/booking/. Your prefilled summary is sent directly to 4WHEELS customer care on WhatsApp for immediate confirmation."
  },
  {
    question: "What is the official 4WHEELS phone and WhatsApp number?",
    answer: "The official voice line and WhatsApp support number for 4WHEELS Rent a Car is 0321 6616644 (+92 321 6616644 internationally)."
  },
  {
    question: "Where is 4WHEELS located in Lahore?",
    answer: "Our official head office and primary fleet dispatch hub is located at Plot number 5, Block F1, Johar Town Phase 1, Lahore, Pakistan."
  },
  {
    question: "How can I verify an official 4WHEELS booking?",
    answer: "Confirm that your booking originated from www.4wheelspk.com/booking/ and was verified directly by official customer care at 0321 6616644 or WhatsApp +92 321 6616644."
  },
  {
    question: "Does 4WHEELS offer self-drive cars in Lahore?",
    answer: "Yes, 4WHEELS provides self-drive car rental options in Lahore. Customer identity verification (such as local CNIC and driving license inspection during handover) applies."
  },
  {
    question: "Can I book a car with a driver?",
    answer: "Yes, professional chauffeur-driven cars are available for local city travel, business meetings, wedding events, and intercity trips across Pakistan."
  },
  {
    question: "Can I book a car for Lahore Airport transfers?",
    answer: "Yes, 4WHEELS offers direct pickup and drop-off protocol services for Allama Iqbal International Airport (LHE) Lahore."
  },
  {
    question: "Can I rent a vehicle for one day or monthly?",
    answer: "Yes, both short-term daily rentals and long-term monthly vehicle arrangements are available depending on fleet availability."
  },
  {
    question: "Can I request a particular model year or preferred color?",
    answer: "Yes, our booking engine allows you to select specific generation body shapes and preferred colors (e.g. Super White, Attitude Black). Preferred colors are subject to rental availability while 'Any Available Color' offers the fastest confirmation."
  },
  {
    question: "Are requested vehicle colors guaranteed?",
    answer: "Preferred color selections are fulfilled whenever available in active inventory. If your exact preferred color is temporarily reserved, customer care will offer the closest available option."
  },
  {
    question: "Can I request a vehicle model not listed in the regular fleet?",
    answer: "Yes, through our Pakistan Vehicle Request Catalog, you can request specific market models (such as BYD Seal, Haval H6, or Hyundai Sonata) for specialized arrangements."
  },
  {
    question: "Can I book an SUV for northern-area travel?",
    answer: "Yes, 4x4 SUVs like the Toyota Fortuner and Hilux Revo Rocco are fully equipped for outstation travel, steep gradients, and northern-area tours."
  },
  {
    question: "Can I rent a Coaster or bus for group transport?",
    answer: "Yes, 4WHEELS operates executive 22-seater Toyota Coasters and 28-to-51 seater tour coaches with experienced drivers for group travel."
  },
  {
    question: "How are intercity route distances calculated?",
    answer: "Route distances and driving times are calculated using our verified Pakistan route database and official NHA motorway mileage data."
  },
  {
    question: "Do I upload my CNIC or license on the website?",
    answer: "No, 4WHEELS never requires public digital upload of government ID or license documents on public websites. Verification is conducted securely during physical vehicle handover."
  },
  {
    question: "How can I verify a claimed physical branch?",
    answer: "4WHEELS operates its primary head office exclusively in Johar Town Phase 1, Lahore. Any other claimed branch must be verified via our Official Verification Hub or customer care line at 0321 6616644."
  },
  {
    question: "What should I do if I see another similar-named website?",
    answer: "Other properties may use similar '4 Wheels' naming. Please verify all bookings, domain URLs, and payment requests through www.4wheelspk.com or official customer care."
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <BreadcrumbSchema items={breadcrumbItems} />
  <!-- Header Banner -->
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="bg-red-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">
          Customer Support & FAQ
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Clear, direct answers to common questions about vehicle rentals, official domains, chauffeur services, and booking verification with 4WHEELS in Lahore.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FAQ items={allFaqs} title="4WHEELS Car Rental FAQs" />
  </section>

  <!-- Final CTA -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <CTASection
      title="Have More Questions?"
      description="Contact official 4WHEELS Customer Care directly at 0321 6616644 or via WhatsApp to get immediate assistance."
      primaryBtnText="Book Your Trip"
      primaryBtnHref="/booking/"
    />
  </div>
</Layout>
