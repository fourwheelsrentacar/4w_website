---
import Layout from '../layouts/Layout.astro';
import { FLEET_VEHICLES } from '../data/fleet';

const title = "Compare Vehicles - Compare Fleet Specifications | 4WHEELS Lahore";
const description = "Compare seats, luggage capacity, rental modes, transmission, and recommended uses for 2-3 rental vehicles in Lahore. Make an informed choice with 4WHEELS.";
const canonicalPath = "/compare-vehicles/";
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2 inline-block">
        Side-by-Side Comparison
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
        Compare Fleet Vehicles
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto">
        Select up to 3 vehicles from our verified fleet to compare seating capacity, luggage room, rental modes, and suitability.
      </p>
    </div>
  </section>

  <section class="py-12 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4">

      <!-- Vehicle Selectors -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
          <label for="select-v1" class="block text-xs font-bold text-slate-700 mb-1">Vehicle 1</label>
          <select id="select-v1" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-bold text-slate-900">
            {FLEET_VEHICLES.map((v, idx) => (
              <option value={v.slug} selected={idx === 0}>{v.manufacturer} {v.model}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="select-v2" class="block text-xs font-bold text-slate-700 mb-1">Vehicle 2</label>
          <select id="select-v2" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-bold text-slate-900">
            {FLEET_VEHICLES.map((v, idx) => (
              <option value={v.slug} selected={idx === 1}>{v.manufacturer} {v.model}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="select-v3" class="block text-xs font-bold text-slate-700 mb-1">Vehicle 3 (Optional)</label>
          <select id="select-v3" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-bold text-slate-900">
            <option value="">-- None --</option>
            {FLEET_VEHICLES.map((v, idx) => (
              <option value={v.slug} selected={idx === 2}>{v.manufacturer} {v.model}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Comparison Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-800 border-collapse">
          <thead>
            <tr class="bg-slate-900 text-white border-b border-slate-800">
              <th class="p-4 font-bold w-1/4">Specification</th>
              <th class="p-4 font-bold text-center w-1/4" id="th-v1">Vehicle 1</th>
              <th class="p-4 font-bold text-center w-1/4" id="th-v2">Vehicle 2</th>
              <th class="p-4 font-bold text-center w-1/4" id="th-v3">Vehicle 3</th>
            </tr>
          </thead>
          <tbody id="compare-tbody" class="divide-y divide-slate-200">
            <!-- Dynamic JS injected -->
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center bg-red-50 border border-red-100 rounded-xl p-6">
        <h3 class="text-base font-bold text-red-900 mb-1">Have Questions About Choice or Availability?</h3>
        <p class="text-xs text-red-700 mb-4">Our customer care team will help you select the ideal vehicle and confirm today's price quote.</p>
        <a href="https://wa.me/923216616644?text=Hello%204WHEELS%2C%20I%20am%20comparing%20vehicles%20and%20would%20like%20guidance." target="_blank" class="inline-block bg-emerald-600 text-white text-xs font-bold px-6 py-3 rounded-lg shadow-sm">
          💬 Ask 4WHEELS on WhatsApp
        </a>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { FLEET_VEHICLES } from '../data/fleet';

  const sel1 = document.getElementById('select-v1') as HTMLSelectElement;
  const sel2 = document.getElementById('select-v2') as HTMLSelectElement;
  const sel3 = document.getElementById('select-v3') as HTMLSelectElement;
  const tbody = document.getElementById('compare-tbody');

  const updateTable = () => {
    if (!tbody || !sel1 || !sel2 || !sel3) return;

    const v1 = FLEET_VEHICLES.find(v => v.slug === sel1.value);
    const v2 = FLEET_VEHICLES.find(v => v.slug === sel2.value);
    const v3 = FLEET_VEHICLES.find(v => v.slug === sel3.value);

    const cols = [v1, v2, v3];

    // Headers
    cols.forEach((v, idx) => {
      const th = document.getElementById(`th-v${idx + 1}`);
      if (th) th.textContent = v ? `${v.manufacturer} ${v.model}` : '-';
    });

    const rows = [
      { label: 'Category', getVal: (v: any) => v ? v.category.toUpperCase() : '-' },
      { label: 'Passenger Capacity', getVal: (v: any) => v ? `👤 ${v.seats || 'N/A'} Seats` : '-' },
      { label: 'Luggage Bags', getVal: (v: any) => v ? `🧳 ${v.luggage || 'N/A'} Bags` : '-' },
      { label: 'Self Drive', getVal: (v: any) => v ? (v.selfDrive ? '✅ Yes' : '❌ No') : '-' },
      { label: 'With Driver', getVal: (v: any) => v ? (v.withDriver ? '✅ Yes' : '❌ No') : '-' },
      { label: 'Transmission', getVal: (v: any) => v ? (v.transmission || 'Automatic') : '-' },
      { label: 'Fuel Type', getVal: (v: any) => v ? (v.fuelType || 'Petrol') : '-' },
      { label: 'Best For', getVal: (v: any) => v ? v.suitableFor.join(', ') : '-' },
      {
        label: 'Action',
        getVal: (v: any) => v ? `
          <div class="space-y-1">
            <a href="/fleet/${v.slug}/" class="block bg-slate-900 text-white text-[11px] font-bold py-1.5 px-2 rounded hover:bg-slate-800">
              View
            </a>
            <a href="https://wa.me/923216616644?text=${encodeURIComponent(`Hello 4WHEELS, I am inquiring about the ${v.manufacturer} ${v.model}.`)}" target="_blank" class="block bg-emerald-600 text-white text-[11px] font-bold py-1.5 px-2 rounded hover:bg-emerald-700">
              WhatsApp
            </a>
          </div>
        ` : '-'
      }
    ];

    tbody.innerHTML = rows.map(r => `
      <tr>
        <td class="p-4 font-bold text-slate-900 bg-slate-50">${r.label}</td>
        <td class="p-4 text-center">${r.getVal(v1)}</td>
        <td class="p-4 text-center">${r.getVal(v2)}</td>
        <td class="p-4 text-center">${r.getVal(v3)}</td>
      </tr>
    `).join('');
  };

  sel1?.addEventListener('change', updateTable);
  sel2?.addEventListener('change', updateTable);
  sel3?.addEventListener('change', updateTable);
  updateTable();
</script>
