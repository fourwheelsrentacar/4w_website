---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { GUIDE_ARTICLES, getGuideBySlug } from '../../data/guides';

export function getStaticPaths() {
  return GUIDE_ARTICLES.map(guide => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props;

if (!guide) {
  return Astro.redirect('/404');
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.title,
  "description": guide.excerpt,
  "author": {
    "@type": "Organization",
    "name": "4WHEELS Rent a Car",
    "url": "https://4wheelsrentacar.pk"
  },
  "publisher": {
    "@type": "Organization",
    "name": "4WHEELS Rent a Car",
    "logo": {
      "@type": "ImageObject",
      "url": "https://4wheelsrentacar.pk/images/logo.png"
    }
  },
  "datePublished": guide.datePublished,
  "dateModified": guide.dateModified,
  "mainEntityOfPage": `https://4wheelsrentacar.pk/guides/${guide.slug}/`
};
---

<Layout title={`${guide.title} | 4WHEELS Knowledge Hub`}>
  <SEOHead
    title={`${guide.title} | 4WHEELS Knowledge Hub`}
    description={guide.excerpt}
    canonicalUrl={`https://4wheelsrentacar.pk/guides/${guide.slug}/`}
  />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="bg-slate-950 text-slate-100 min-h-screen pb-16">
    <!-- Breadcrumbs -->
    <nav class="bg-slate-900 border-b border-slate-800 py-3 px-4 sm:px-6 lg:px-8 text-xs text-slate-400" aria-label="Breadcrumb">
      <div class="max-w-5xl mx-auto flex items-center space-x-2">
        <a href="/" class="hover:text-white">Home</a>
        <span>›</span>
        <a href="/guides/" class="hover:text-white">Guides</a>
        <span>›</span>
        <span class="text-slate-200 font-semibold truncate">{guide.title}</span>
      </div>
    </nav>

    <!-- Article Header Hero -->
    <header class="bg-slate-900 border-b border-slate-800 py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto space-y-4">
        <div class="flex items-center gap-3">
          <span class="bg-red-600/20 text-red-400 border border-red-500/30 text-[11px] font-extrabold uppercase px-3 py-1 rounded">
            {guide.category}
          </span>
          <span class="text-xs text-slate-400">Published: {guide.datePublished}</span>
          <span class="text-xs text-slate-400">• Updated: {guide.dateModified}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight">
          {guide.title}
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          {guide.excerpt}
        </p>

        <div class="pt-2 text-xs text-slate-400 flex items-center gap-2">
          <span>✍️ By {guide.author}</span>
          <span>•</span>
          <span>Verified by 4WHEELS Customer Care</span>
        </div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 space-y-10">

      <!-- Direct Answer Box (GEO / AEO Search Friendly) -->
      <section class="bg-gradient-to-r from-red-950/40 via-slate-900 to-slate-900 border-l-4 border-red-600 border-y border-r border-slate-800 rounded-xl p-5 sm:p-6 shadow-xl">
        <p class="text-xs font-black uppercase tracking-wider text-red-400 mb-2 flex items-center gap-1.5">
          <span>⚡ DIRECT ANSWER / KEY SUMMARY</span>
        </p>
        <p class="text-sm sm:text-base text-slate-100 font-medium leading-relaxed">
          {guide.directAnswer}
        </p>
      </section>

      <!-- Key Facts Table/Grid -->
      {guide.keyFacts && guide.keyFacts.length > 0 && (
        <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
          <h2 class="text-base font-bold text-white mb-4 uppercase tracking-wider text-slate-300">
            📊 Quick Fact Sheet
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
            {guide.keyFacts.map(fact => (
              <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 flex justify-between items-center">
                <span class="text-slate-400 font-medium">{fact.label}</span>
                <span class="text-slate-100 font-bold">{fact.value}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Table of Contents -->
      {guide.contentSections && guide.contentSections.length > 0 && (
        <section class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-4 text-xs">
          <p class="font-bold text-slate-300 uppercase tracking-wider mb-2">Table of Contents</p>
          <ul class="space-y-1 text-slate-400">
            {guide.contentSections.map((sec, idx) => (
              <li>
                <a href={`#sec-${idx}`} class="hover:text-red-400 transition-colors">
                  {idx + 1}. {sec.heading}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Main Article Body Sections -->
      <article class="space-y-8 text-slate-200 leading-relaxed text-sm sm:text-base">
        {guide.contentSections.map((sec, idx) => (
          <section id={`sec-${idx}`} class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-3">
            <h2 class="text-xl font-bold text-white tracking-tight text-red-400">
              {sec.heading}
            </h2>
            <p class="text-slate-300 leading-relaxed">
              {sec.body}
            </p>
          </section>
        ))}
      </article>

      <!-- Urdu Summary Block if available -->
      {guide.urduSummary && (
        <section class="bg-slate-900 border border-emerald-500/30 rounded-2xl p-6 text-right" lang="ur">
          <p class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">اردو میں مختصر خلاصہ</p>
          <p class="text-base text-slate-100 leading-loose font-serif">{guide.urduSummary}</p>
        </section>
      )}

      <!-- Commercial Action Banner -->
      <section class="bg-gradient-to-r from-red-900/50 to-slate-900 border border-red-500/30 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-2xl">
        <div class="space-y-2 text-center sm:text-left">
          <h3 class="text-lg sm:text-xl font-bold text-white">Need a verified vehicle for your trip?</h3>
          <p class="text-xs sm:text-sm text-slate-300">
            Browse 4WHEELS verified fleet in Lahore or submit a custom trip inquiry via our booking configurator.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href="/build-your-rental/"
            class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-6 py-3 rounded-xl transition-all shadow-md text-xs sm:text-sm text-center uppercase tracking-wide"
          >
            🚗 Book Your Trip
          </a>
          <a
            href="/trip-planner/"
            class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-6 py-3 rounded-xl transition-all shadow-md text-xs sm:text-sm text-center uppercase tracking-wide"
          >
            🧭 Plan This Trip
          </a>
        </div>
      </section>

      <!-- FAQs -->
      {guide.faqs && guide.faqs.length > 0 && (
        <FAQ
          title="Frequently Asked Questions"
          items={guide.faqs}
        />
      )}

      <!-- Sources Section -->
      {guide.sources && guide.sources.length > 0 && (
        <footer class="pt-6 border-t border-slate-800 text-xs text-slate-400 space-y-2">
          <p class="font-bold uppercase tracking-wider text-slate-300">Information Sources & Verification:</p>
          <ul class="list-disc list-inside space-y-1">
            {guide.sources.map(src => (
              <li>{src.title}</li>
            ))}
          </ul>
        </footer>
      )}

    </div>
  </main>
</Layout>
