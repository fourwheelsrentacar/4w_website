---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { BUSINESS_INFO } from '../data/business';

const title = "4WHEELS Rent a Car Lahore | Self Drive & With Driver";
const description = "Rent a car in Lahore with 4WHEELS. Serving Lahore Since 2008. Self-drive and with-driver options for daily, monthly, airport and corporate rental requirements. Call or WhatsApp for latest price.";

const homepageFaqs = [
  {
    question: "How are rental prices determined?",
    answer: "Rental rates depend on vehicle type, rental duration, route, fuel arrangements, tolls, and whether you choose self-drive or a driver. Contact 4WHEELS via phone or WhatsApp for a customized quote."
  },
  {
    question: "Can I rent a self-drive car in Lahore?",
    answer: "Yes, 4WHEELS provides self-drive car rental options in Lahore. Contact us directly via phone or WhatsApp to verify availability and current documentation requirements."
  },
  {
    question: "Can I rent a car with a driver?",
    answer: "Yes, we offer professional cars with drivers for local city travel, business meetings, family outings, and airport transfers across Lahore."
  },
  {
    question: "Do you offer daily and monthly rentals?",
    answer: "Yes, both daily short-term rentals and monthly long-term rentals are available depending on vehicle availability."
  },
  {
    question: "Can I book a car for Lahore Airport transfers?",
    answer: "Yes, we provide direct pickup and drop-off services for Allama Iqbal International Airport Lahore."
  },
  {
    question: "How do I check vehicle availability and get the latest price?",
    answer: "Contact 4WHEELS directly at 0321 6616644 or message us on WhatsApp with your travel dates and requirements."
  }
];
---

<Layout title={title} description={description} canonicalPath="/">
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-12 md:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/80 border border-red-800 text-red-400 text-xs font-semibold">
            <span>📍 Johar Town Phase 1, Lahore</span>
            <span class="text-slate-500">•</span>
            <span>{BUSINESS_INFO.trustBadge}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
            Rent a Car in Lahore — <span class="text-red-500">Self Drive</span> or <span class="text-slate-300">With Driver</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
            Choose flexible car rental options in Lahore for daily trips, airport travel, monthly requirements and business use. Reliable local service with direct phone & WhatsApp booking.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href={BUSINESS_INFO.telLink}
              class="bg-red-600 hover:bg-red-700 text-white font-bold text-base px-6 py-3.5 rounded-xl transition-all text-center shadow-lg shadow-red-600/20"
            >
              📞 Call {BUSINESS_INFO.phoneDisplay}
            </a>
            <a
              href={BUSINESS_INFO.whatsappPriceLink}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base px-6 py-3.5 rounded-xl transition-all text-center shadow-lg shadow-emerald-600/20"
            >
              💬 WhatsApp for Latest Price
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 bg-slate-800/80 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-4">
          <div class="text-xs text-red-400 font-bold uppercase tracking-wider">{BUSINESS_INFO.trustBadge}</div>
          <h2 class="text-xl font-bold text-white border-b border-slate-700 pb-3">Quick Availability Check</h2>
          <p class="text-sm text-slate-300">
            Need a rental car in Lahore? Contact our team directly to verify vehicle availability and get an accurate rate for your dates.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
            <li class="flex items-center gap-2">✓ Self-drive rental options</li>
            <li class="flex items-center gap-2">✓ Professional drivers available</li>
            <li class="flex items-center gap-2">✓ Lahore Airport transfers</li>
            <li class="flex items-center gap-2">✓ Flexible daily & monthly duration</li>
          </ul>
          <div class="pt-2 flex flex-col gap-2">
            <a
              href={BUSINESS_INFO.whatsappTripLink}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-2.5 rounded-lg text-sm transition-colors"
            >
              💬 WhatsApp for Trip Information
            </a>
            <a
              href="/contact/"
              class="block w-full text-center bg-slate-700 hover:bg-slate-600 text-white font-semibold py-2 rounded-lg text-xs transition-colors border border-slate-600"
            >
              View Contact & Location Info
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rental Services Overview -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">Our Rental Services in Lahore</h2>
      <p class="text-slate-600 text-base">
        4WHEELS offers practical vehicle rental options tailored for individual drivers, families, visitors, and businesses.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <ServiceCard
        title="Self Drive Cars"
        description="Drive on your own schedule across Lahore. Flexible rental periods available for eligible drivers."
        href="/self-drive-car-rental-lahore/"
        icon="🚗"
      />
      <ServiceCard
        title="Cars With Driver"
        description="Relax with an experienced driver for city errands, business meetings, events, or family trips."
        href="/car-with-driver-lahore/"
        icon="👨‍✈️"
      />
      <ServiceCard
        title="Daily Rentals"
        description="Short-term rental arrangements suited for daily travel, weekend trips, and quick errands."
        href="/rent-a-car-lahore/"
        icon="📅"
      />
      <ServiceCard
        title="Monthly Rentals"
        description="Extended rental options for residents, corporate stays, or long-term vehicle requirements."
        href="/monthly-car-rental-lahore/"
        icon="📆"
      />
      <ServiceCard
        title="Airport Transfers"
        description="Reliable pickup and drop-off services for Allama Iqbal International Airport Lahore."
        href="/lahore-airport-car-rental/"
        icon="✈️"
      />
      <ServiceCard
        title="Corporate Rentals"
        description="Dedicated vehicle arrangements for executive movement, staff travel, and business projects."
        href="/corporate-car-rental-lahore/"
        icon="🏢"
      />
    </div>
  </section>

  <!-- How Booking Works -->
  <section class="py-12 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">How Booking Works</h2>
        <p class="text-slate-600">Simple three-step rental process with 4WHEELS Rent a Car.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6 rounded-xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 bg-red-600 text-white font-bold text-xl rounded-full flex items-center justify-center mx-auto mb-4">1</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Contact 4WHEELS</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Tell us your preferred dates, rental type (self-drive or with driver), and destination details.
          </p>
        </div>

        <div class="text-center p-6 rounded-xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 bg-red-600 text-white font-bold text-xl rounded-full flex items-center justify-center mx-auto mb-4">2</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Check Price & Availability</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            We confirm current vehicle availability and provide a clear quotation based on your trip requirements.
          </p>
        </div>

        <div class="text-center p-6 rounded-xl bg-slate-50 border border-slate-100">
          <div class="w-12 h-12 bg-red-600 text-white font-bold text-xl rounded-full flex items-center justify-center mx-auto mb-4">3</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Confirm Your Booking</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Finalize the appropriate vehicle and rental arrangement for pickup or delivery in Lahore.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Official 4WHEELS Trust Section -->
  <section class="py-12 bg-slate-900 text-white border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-red-600 text-white font-extrabold text-xs uppercase px-3 py-1 rounded tracking-wider mb-3">
        Official 4WHEELS Rent a Car
      </div>
      <h2 class="text-2xl sm:text-4xl font-black mb-3">
        Serving Lahore Since 2008
      </h2>
      <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base mb-6 leading-relaxed">
        For genuine bookings, fleet inquiries, and official verification, contact 4WHEELS directly.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-sm font-bold">
        <a
          href={BUSINESS_INFO.telLink}
          class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl transition-colors"
        >
          📞 Call: {BUSINESS_INFO.phoneDisplay}
        </a>
        <a
          href={BUSINESS_INFO.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl transition-colors"
        >
          💬 WhatsApp Customer Care
        </a>
        <a
          href="/official/"
          class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-6 py-3 rounded-xl transition-colors"
        >
          Verify Official Details →
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose 4WHEELS -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Why Choose 4WHEELS</h2>
      <div class="text-red-600 font-bold text-sm mb-4">{BUSINESS_INFO.trustBadge}</div>
      <p class="text-slate-600">Focused on clear communication and practical car rental in Lahore.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Serving Lahore Since 2008</h3>
        <p class="text-slate-600 text-sm">Over 15 years of local experience serving Johar Town, Gulberg, DHA, and Lahore Airport.</p>
      </div>
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Both Rental Options</h3>
        <p class="text-slate-600 text-sm">Choose between self-drive freedom or relaxed travel with a professional driver.</p>
      </div>
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Flexible Rental Durations</h3>
        <p class="text-slate-600 text-sm">Rent for a single day, airport trip, or extended monthly rental periods.</p>
      </div>
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Direct Communication</h3>
        <p class="text-slate-600 text-sm">Speak directly with our team via phone or WhatsApp for quick confirmation.</p>
      </div>
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Airport Coverage</h3>
        <p class="text-slate-600 text-sm">Convenient transfers to and from Allama Iqbal International Airport Lahore.</p>
      </div>
      <div class="p-5 rounded-xl border border-slate-200 bg-white">
        <h3 class="font-bold text-slate-900 mb-1">✓ Corporate Solutions</h3>
        <p class="text-slate-600 text-sm">Custom vehicle arrangements for corporate travel and long-term business needs.</p>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="py-12 bg-slate-100 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">Visit or Contact 4WHEELS in Lahore</h2>
          <p class="text-slate-600 mb-6 leading-relaxed">
            Our office is located in Johar Town Phase 1, Lahore ({BUSINESS_INFO.trustBadge}). You can call or WhatsApp us anytime to inquire about current car rental availability.
          </p>
          <div class="space-y-3 text-sm">
            <div class="flex items-start gap-2">
              <span class="font-bold text-slate-900">Address:</span>
              <span class="text-slate-700">{BUSINESS_INFO.address.fullAddress}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900">Phone:</span>
              <a href={BUSINESS_INFO.telLink} class="text-red-600 font-bold hover:underline">{BUSINESS_INFO.phoneDisplay}</a>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900">WhatsApp:</span>
              <a href={BUSINESS_INFO.whatsappPriceLink} target="_blank" rel="noopener noreferrer" class="text-emerald-600 font-bold hover:underline">0321 6616644</a>
            </div>
          </div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center">
          <h3 class="text-lg font-bold text-slate-900 mb-2">Location Map & Office</h3>
          <p class="text-slate-600 text-sm mb-4">
            Johar Town Phase 1 is easily accessible from major Lahore routes including Canal Bank Road and MM Alam Road.
          </p>
          <a
            href="https://maps.google.com/?q=Johar+Town+Phase+1+Lahore"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-5 rounded-lg text-sm transition-colors"
          >
            📍 Open Location in Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Preview -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <FAQ items={homepageFaqs} />
    <div class="text-center -mt-4 mb-12">
      <a href="/faq/" class="text-red-600 font-bold hover:underline text-sm inline-flex items-center gap-1">
        <span>View All Frequently Asked Questions</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <!-- Final CTA: Need the Latest Rental Price? -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <CTASection
      heading="Need the Latest Rental Price?"
      subheading="Quotations vary based on vehicle selection, duration, fuel costs, route, driver requirement, and tolls. Contact 4WHEELS directly for an accurate current quote."
      ctaType="price"
    />
  </div>
</Layout>
