---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import CTASection from '../components/CTASection.astro';
import { BUSINESS_INFO } from '../data/business';
import { PRESS_RELEASES } from '../data/press';
import { getContextualWhatsAppUrl } from '../utils/whatsappContext';

const pageTitle = "Official Brand Verification Hub | 4WHEELS Rent a Car Lahore";
const pageDescription = "Verify the genuine official 4WHEELS Rent a Car business identity, official website domain (www.4wheelspk.com), Johar Town office address, customer care line, and payment instructions.";

const mapsSearchUrl = BUSINESS_INFO.mapsSearchUrl;
const mapsDirectionsUrl = BUSINESS_INFO.mapsDirectionsUrl;
const googleReviewsUrl = BUSINESS_INFO.googleReviewsUrl;
const waUrl = getContextualWhatsAppUrl({
  pageTitle: 'Official Brand Verification Hub',
  canonicalUrl: `${BUSINESS_INFO.siteUrl}/official/`,
});

const advisories = PRESS_RELEASES.filter(p => p.category === 'Customer Advisory' || p.category === 'Brand Verification Notice' || p.category === 'Official Statement');
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/official/">

  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block bg-red-600 text-white font-extrabold text-xs uppercase px-3 py-1 rounded tracking-wider mb-4">
        Official Brand Verification Hub
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 text-white">
        Official 4WHEELS Rent a Car
      </h1>
      <p class="text-lg sm:text-xl text-red-400 font-semibold mb-6">
        Serving Lahore Since 2008
      </p>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Before sending payment or confirming a rental, customers can verify the website, telephone number, booking details or representative through official 4WHEELS customer care.
      </p>
    </div>
  </section>

  <!-- Main Verification Grid -->
  <section class="py-12 bg-slate-950 text-slate-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Official Details Card -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-xl">
        <h2 class="text-2xl font-black text-white mb-6 pb-3 border-b border-slate-800 flex items-center gap-2">
          <span class="text-red-500">✓</span> Authoritative Official Channels
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Website</span>
            <a href="https://www.4wheelspk.com/" class="text-red-400 font-extrabold text-base hover:underline break-all">
              https://www.4wheelspk.com/
            </a>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Booking Portal</span>
            <a href="/booking/" class="text-white font-extrabold text-base hover:underline break-all">
              https://www.4wheelspk.com/booking/
            </a>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Fleet Directory</span>
            <a href="/fleet/" class="text-white font-extrabold text-base hover:underline break-all">
              https://www.4wheelspk.com/fleet/
            </a>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Phone & Voice</span>
            <a href="tel:+923216616644" class="text-red-400 font-extrabold text-base hover:underline">
              0321 6616644
            </a>
            <span class="text-slate-400 text-xs block">(International: +92 321 6616644)</span>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official WhatsApp</span>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-extrabold text-base hover:underline">
              +92 321 6616644
            </a>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Email</span>
            <a href="mailto:4wheels44@gmail.com" class="text-white font-extrabold text-base hover:underline">
              4wheels44@gmail.com
            </a>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 sm:col-span-2">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Physical Head Office</span>
            <p class="text-white font-extrabold text-sm">
              5, F1, Block F1, Johar Town Phase 1, Lahore, Pakistan
            </p>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 sm:col-span-2">
            <span class="text-slate-400 font-bold uppercase text-[10px] block mb-1">Official Facebook Page</span>
            <a href="https://www.facebook.com/4wheelrentacar/" target="_blank" rel="noopener noreferrer" class="text-blue-400 font-extrabold text-xs hover:underline break-all">
              https://www.facebook.com/4wheelrentacar/
            </a>
          </div>
        </div>
      </div>

      <!-- Verification UX Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">🌐</div>
          <h3 class="text-base font-black text-white">VERIFY OUR WEBSITE</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Check your browser address bar to ensure you are visiting <strong>www.4wheelspk.com</strong>. All canonical sitemaps, vehicle specs, and booking forms originate strictly from this domain.
          </p>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">📞</div>
          <h3 class="text-base font-black text-white">VERIFY OUR PHONE / WHATSAPP</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            All voice calls and official WhatsApp messages originate exclusively from <strong>0321 6616644</strong> (+92 321 6616644). Never transfer deposits to messages from unverified numbers.
          </p>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">📍</div>
          <h3 class="text-base font-black text-white">VERIFY OUR LOCATION</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Our official headquarters and primary vehicle dispatch hub is situated at Plot number 5, Block F1, Johar Town Phase 1, Lahore. Any other claimed physical location should be verified with customer care.
          </p>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">📋</div>
          <h3 class="text-base font-black text-white">VERIFY A BOOKING</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Confirm that your booking was configured through <a href="/booking/" class="text-red-400 font-bold hover:underline">/booking/</a> or directly confirmed by 4WHEELS Customer Care at 0321 6616644.
          </p>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">👔</div>
          <h3 class="text-base font-black text-white">VERIFY A REPRESENTATIVE</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            All chauffeur assignments and corporate account representatives are issued directly from our Johar Town headquarters.
          </p>
        </div>

        <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-2">
          <div class="text-xl">💳</div>
          <h3 class="text-base font-black text-white">VERIFY A PAYMENT REQUEST</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Always verify bank account details and booking payment requests via voice call or official WhatsApp (0321 6616644) before completing bank transfers.
          </p>
        </div>

      </div>

      <!-- Similar-Name Notice & Brand Protection Block -->
      <div class="bg-slate-900 border border-slate-800 p-6 sm:p-8 rounded-2xl space-y-4">
        <h3 class="text-lg font-black text-white flex items-center gap-2">
          <span>🏛️ SIMILAR-NAME BUSINESSES & BRAND PROTECTION</span>
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Other businesses and online properties may use similar "4 Wheels", "4Wheels" or "4 Wheel Rent a Car" naming. Similar naming does not establish affiliation with 4WHEELS Rent a Car.
        </p>
        <p class="text-xs sm:text-sm text-slate-200 font-bold bg-slate-950 p-4 rounded-xl border border-slate-800 leading-relaxed">
          Customers should verify any website, branch, representative or payment instruction through www.4wheelspk.com or official customer care at 0321 6616644.
        </p>
      </div>

      <!-- Latest Customer Advisories Section -->
      <div class="bg-slate-900 border border-slate-800 p-6 sm:p-8 rounded-2xl space-y-6">
        <div class="flex justify-between items-center border-b border-slate-800 pb-3">
          <h3 class="text-lg font-black text-white uppercase tracking-wider">
            📢 LATEST CUSTOMER ADVISORIES
          </h3>
          <a href="/press/" class="text-xs font-bold text-red-400 hover:underline">View Press Centre →</a>
        </div>

        <div class="space-y-4">
          {advisories.map(adv => (
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-1.5">
              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <span class="bg-red-950 text-red-400 border border-red-800 px-2 py-0.5 rounded font-bold uppercase">{adv.category}</span>
                <span>{adv.datePublished}</span>
              </div>
              <h4 class="text-sm sm:text-base font-black text-white hover:text-red-400 transition-colors">
                <a href={`/press/${adv.slug}/`}>{adv.title}</a>
              </h4>
              <p class="text-xs text-slate-300 leading-relaxed line-clamp-2">
                {adv.summary}
              </p>
              <div class="pt-2">
                <a href={`/press/${adv.slug}/`} class="text-xs font-bold text-red-400 hover:underline inline-flex items-center gap-1">
                  <span>Read Official Advisory</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <CTASection
    title="Need Immediate Verification or Assistance?"
    description="Connect directly with official 4WHEELS customer care in Johar Town, Lahore for rental quotes, availability, and branch verification."
    primaryBtnText="💬 Contact Official WhatsApp"
    primaryBtnHref={waUrl}
  />
</Layout>
