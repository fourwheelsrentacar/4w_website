<script>

  // Calculate Route Distance based on pickup & destination inputs
  const calculateRouteDistance = () => {
    const pickupInput = document.getElementById('field-pickup');
    const destInput = document.getElementById('field-destination');
    const pickup = pickupInput ? pickupInput.value : '';
    const dest = destInput ? destInput.value : '';

    const normPickup = pickup.toLowerCase().trim();
    const normDest = dest.toLowerCase().trim();

    const encodedMapsUrl = 'https://www.google.com/maps/dir/?api=1&origin=' + encodeURIComponent(pickup) + '&destination=' + encodeURIComponent(dest) + '&travelmode=driving';

    const routeDb = window.verifiedRouteDb || [];
    let matchedRoute = null;

    for (const r of routeDb) {
      const origMatch = normPickup.includes(r.originSlug) || normPickup.includes(r.originCity.toLowerCase()) || normPickup.includes(r.originName.toLowerCase());
      const destMatch = normDest.includes(r.destinationSlug) || normDest.includes(r.destinationCity.toLowerCase()) || normDest.includes(r.destinationName.toLowerCase());
      if (origMatch && destMatch) {
        matchedRoute = r;
        break;
      }
      const revOrigMatch = normPickup.includes(r.destinationSlug) || normPickup.includes(r.destinationCity.toLowerCase()) || normPickup.includes(r.destinationName.toLowerCase());
      const revDestMatch = normDest.includes(r.originSlug) || normDest.includes(r.originCity.toLowerCase()) || normDest.includes(r.originName.toLowerCase());
      if (revOrigMatch && revDestMatch) {
        matchedRoute = r;
        break;
      }
    }

    const badgeElem = document.getElementById('calc-status-badge');
    const distElem = document.getElementById('route-calc-distance');
    const durElem = document.getElementById('route-calc-duration');
    const sumDist = document.getElementById('summary-distance');
    const routeSourceNote = document.getElementById('route-source-note');
    const googleMapsBtn = document.getElementById('btn-google-maps-check');
    const customDistContainer = document.getElementById('custom-distance-container');

    if (matchedRoute) {
      const kmText = 'Approx. ' + matchedRoute.distanceKm + ' km';
      const hrs = Math.floor(matchedRoute.typicalDurationMinutes / 60);
      const mins = matchedRoute.typicalDurationMinutes % 60;
      const durText = hrs > 0 ? (hrs + ' hrs ' + (mins > 0 ? mins + ' mins' : '')) : (mins + ' mins');

      if (badgeElem) {
        badgeElem.className = 'text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold px-2 py-0.5 rounded';
        badgeElem.textContent = '4WHEELS Verified Route Database';
      }
      if (distElem) distElem.textContent = kmText;
      if (durElem) durElem.textContent = durText;
      if (sumDist) sumDist.textContent = kmText;
      if (routeSourceNote) routeSourceNote.textContent = 'Planning distance from 4WHEELS verified route database. Last verified: ' + matchedRoute.verifiedDate;
      if (googleMapsBtn) {
        googleMapsBtn.href = matchedRoute.googleMapsUrl || encodedMapsUrl;
      }
      if (customDistContainer) customDistContainer.classList.add('hidden');
    } else {
      if (badgeElem) {
        badgeElem.className = 'text-[10px] bg-amber-950 text-amber-300 border border-amber-800 font-bold px-2 py-0.5 rounded';
        badgeElem.textContent = 'Route Not in Quick Database';
      }
      const customDistElem = document.getElementById('field-custom-distance');
      const customDistInput = customDistElem ? customDistElem.value : null;
      const customDist = customDistInput ? parseInt(customDistInput, 10) : null;

      if (customDist && customDist > 0) {
        if (distElem) distElem.textContent = 'Approx. ' + customDist + ' km';
        if (sumDist) sumDist.textContent = 'Approx. ' + customDist + ' km';
        if (routeSourceNote) routeSourceNote.textContent = 'Customer-entered planning distance. 4WHEELS will confirm.';
      } else {
        if (distElem) distElem.textContent = 'To be confirmed';
        if (sumDist) sumDist.textContent = 'To be confirmed';
        if (routeSourceNote) routeSourceNote.textContent = '4WHEELS will confirm final route and distance with your quotation.';
      }
      if (durElem) durElem.textContent = 'Depends on traffic';
      if (googleMapsBtn) {
        googleMapsBtn.href = encodedMapsUrl;
      }
      if (customDistContainer) customDistContainer.classList.remove('hidden');
    }
  };

  document.getElementById('field-custom-distance')?.addEventListener('input', calculateRouteDistance);

  // Stepper Logic
  const showStep = (stepNumber: number) => {
    document.querySelectorAll('.step-panel').forEach(panel => panel.classList.add('hidden'));
    const targetPanel = document.getElementById(`step-panel-${stepNumber}`);
    if (targetPanel) targetPanel.classList.remove('hidden');

    // Update Desktop Header Tabs
    document.querySelectorAll('.step-tab').forEach((tab, idx) => {
      const stepIdx = idx + 1;
      const circle = tab.querySelector('span:first-child');
      if (stepIdx === stepNumber) {
        tab.classList.add('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center text-xs';
      } else if (stepIdx < stepNumber) {
        tab.classList.remove('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs';
      } else {
        tab.classList.remove('text-red-500');
        if (circle) circle.className = 'w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs';
      }
    });

    // Update Mobile Indicators
    const mobileCounter = document.getElementById('mobile-step-counter');
    const mobileTitle = document.getElementById('mobile-step-title');
    if (mobileCounter) mobileCounter.textContent = `${stepNumber} of 6`;

    const titles = [
      '1. Vehicle Selection',
      '2. Pickup & Drop-off',
      '3. Select Dates',
      '4. Capacity & Fit',
      '5. Customer Contact',
      '6. Review & Inquiry'
    ];
    if (mobileTitle) mobileTitle.textContent = titles[stepNumber - 1];

    currentStep = stepNumber;
    window.scrollTo({ top: 180, behavior: 'smooth' });
  };

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep === 5) {
        const name = (document.getElementById('field-name') as HTMLInputElement)?.value;
        const phone = (document.getElementById('field-phone') as HTMLInputElement)?.value;
        if (!name || !phone) {
          alert('Please enter your Full Name and Phone/WhatsApp number.');
          return;
        }
        populateReviewScreen();
      }
      if (currentStep < 6) showStep(currentStep + 1);
    });
  });

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) showStep(currentStep - 1);
    });
  });

  // Dynamic Summary Live Updates
  const updateSummary = () => {
    const brandElem = document.getElementById('field-brand');
    const modelElem = document.getElementById('field-model');
    const modeElem = document.getElementById('field-mode');
    const transElem = document.getElementById('field-transmission');
    const catElem = document.getElementById('field-category');
    const pickupElem = document.getElementById('field-pickup');
    const destElem = document.getElementById('field-destination');
    const pElem = document.getElementById('field-passengers');
    const lElem = document.getElementById('field-luggage');

    const brand = brandElem ? brandElem.value : 'Toyota';
    const model = modelElem ? modelElem.value : 'Toyota Corolla';
    const mode = modeElem ? modeElem.value : 'With Driver';
    const trans = transElem ? transElem.value : 'Automatic';
    const cat = catElem ? catElem.value : 'sedan';
    const pickup = pickupElem ? pickupElem.value : 'Johar Town, Lahore';
    const dest = destElem ? destElem.value : 'Islamabad F-7';

    const pCount = pElem ? pElem.value : '4';
    const lCount = lElem ? lElem.value : '2';

    const sBrand = document.getElementById('summary-brand');
    const sModel = document.getElementById('summary-model');
    const sSpecs = document.getElementById('summary-specs');
    const sPickup = document.getElementById('summary-pickup');
    const sDropoff = document.getElementById('summary-dropoff');
    const sCapacity = document.getElementById('summary-capacity');
    const sVisual = document.getElementById('summary-visual-img');

    const preTitle = document.getElementById('preselect-title');
    const preSub = document.getElementById('preselect-subtitle');

    if (sBrand) sBrand.textContent = brand.toUpperCase();
    if (sModel) sModel.textContent = model;

    // Resolve accurate vehicle body category dynamically
    let resolvedCategory = cat.toUpperCase();
    if (model.toLowerCase().includes('fortuner') || model.toLowerCase().includes('revo')) resolvedCategory = 'SUV / 4X4';
    else if (model.toLowerCase().includes('hiace')) resolvedCategory = 'VAN';
    else if (model.toLowerCase().includes('coaster')) resolvedCategory = 'COASTER BUS';
    else if (model.toLowerCase().includes('alto') || model.toLowerCase().includes('swift')) resolvedCategory = 'HATCHBACK';
    else if (model.toLowerCase().includes('corolla') || model.toLowerCase().includes('civic') || model.toLowerCase().includes('yaris') || model.toLowerCase().includes('city') || model.toLowerCase().includes('a6')) resolvedCategory = 'SEDAN';

    if (sSpecs) sSpecs.textContent = trans + ' • ' + mode + ' • ' + resolvedCategory;
    if (sPickup) sPickup.textContent = pickup;
    if (sDropoff) sDropoff.textContent = dest;
    if (sCapacity) sCapacity.textContent = pCount + ' Passengers, ' + lCount + ' Bags';
    const imageInfo = window.getVehicleImageInfo ? window.getVehicleImageInfo(model) : null;
    if (sVisual && imageInfo) {
      sVisual.src = imageInfo.imageUrl;
      sVisual.setAttribute('data-fallback', imageInfo.fallbackUrl || '');
      sVisual.onerror = function() {
        if (sVisual.src !== sVisual.getAttribute('data-fallback')) {
          sVisual.src = sVisual.getAttribute('data-fallback') || '';
        }
      };
    }
    const sLabel = document.getElementById('summary-visual-label');
    if (sLabel && imageInfo) {
      sLabel.textContent = imageInfo.label;
    }

    if (preTitle) preTitle.textContent = model;
    if (preSub) preSub.textContent = cat.toUpperCase() + ' • ' + trans + ' • ' + mode;

    calculateRouteDistance();
    calculateDatesDuration();
    checkTripFit();
  };

  // Toggle Vehicle Picker Container
  const toggleVehiclePickerBtn = document.getElementById('btn-toggle-vehicle-picker');
  const vehiclePickerContainer = document.getElementById('vehicle-picker-container');
  toggleVehiclePickerBtn?.addEventListener('click', () => {
    if (vehiclePickerContainer) {
      vehiclePickerContainer.classList.toggle('hidden');
    }
  });

  // Dynamic Vehicle Cascade Dropdown & Filter Manager
  const brandSelect = document.getElementById('field-brand');
  const modelSelect = document.getElementById('field-model');
  const catInput = document.getElementById('field-category');
  const catButtons = document.querySelectorAll('.cat-btn');

  const populateVehicleCascade = (trigger, targetVal) => {
    const vehicles = window.fullVehicleList || [];
    let selectedCat = (catInput && catInput.value) ? catInput.value.toLowerCase() : 'all';
    let selectedBrand = (brandSelect && brandSelect.value) ? brandSelect.value : 'all';
    let selectedModel = (modelSelect && modelSelect.value) ? modelSelect.value : '';

    // Handle Category Trigger
    if (trigger === 'category' && targetVal) {
      selectedCat = targetVal.toLowerCase();
      if (catInput) catInput.value = selectedCat;
    }

    // Highlight Category UI Buttons
    catButtons.forEach(btn => {
      const attrVal = btn.getAttribute('data-val');
      const bVal = attrVal ? attrVal.toLowerCase() : '';
      if (bVal === selectedCat) {
        btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
        btn.classList.add('bg-red-600', 'text-white', 'border-red-500');
      } else {
        btn.classList.remove('bg-red-600', 'text-white', 'border-red-500');
        btn.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
      }
    });

    // Populate Brand Select Options
    let availableVehicles = vehicles;
    if (selectedCat && selectedCat !== 'all') {
      availableVehicles = vehicles.filter(v => {
        if (selectedCat === 'van') return v.category === 'van';
        if (selectedCat === 'coaster') return v.category === 'coaster' || v.category === 'bus';
        if (selectedCat === 'suv') return v.category === 'suv' || v.category === 'crossover' || v.category === 'pickup' || v.category === 'phev';
        if (selectedCat === 'luxury') return v.category === 'luxury';
        if (selectedCat === 'hatchback') return v.category === 'hatchback';
        if (selectedCat === 'sedan') return v.category === 'sedan';
        return v.category === selectedCat;
      });
    }

    const availableBrands = Array.from(new Set(availableVehicles.map(v => v.brand)));

    // Refresh Brand Options
    const currBrand = brandSelect ? brandSelect.value : '';
    if (brandSelect) {
      brandSelect.innerHTML = '';
      availableBrands.forEach(b => {
        const opt = document.createElement('option');
        opt.value = b;
        opt.textContent = b;
        brandSelect.appendChild(opt);
      });

      if (availableBrands.includes(currBrand) && trigger !== 'category') {
        brandSelect.value = currBrand;
      } else if (availableBrands.length > 0) {
        brandSelect.value = availableBrands[0];
      }
      selectedBrand = brandSelect.value;
    }

    // Filter Models for current Brand and Category
    let modelVehicles = availableVehicles.filter(v => v.brand.toLowerCase() === selectedBrand.toLowerCase());
    if (modelVehicles.length === 0) {
      modelVehicles = vehicles.filter(v => v.brand.toLowerCase() === selectedBrand.toLowerCase());
    }

    const currModel = modelSelect ? modelSelect.value : '';
    if (modelSelect) {
      modelSelect.innerHTML = '';
      modelVehicles.forEach(v => {
        const opt = document.createElement('option');
        opt.value = v.brand + ' ' + v.model;
        opt.textContent = v.brand + ' ' + v.model + ' (' + (v.variant || v.category.toUpperCase()) + ')';
        modelSelect.appendChild(opt);
      });

      if (trigger === 'model' && targetVal) {
        let found = false;
        for (let i = 0; i < modelSelect.options.length; i++) {
          if (modelSelect.options[i].value.toLowerCase().includes(targetVal.toLowerCase())) {
            modelSelect.selectedIndex = i;
            found = true;
            break;
          }
        }
        if (!found && targetVal) {
          const opt = document.createElement('option');
          opt.value = targetVal;
          opt.textContent = targetVal;
          modelSelect.appendChild(opt);
          modelSelect.value = targetVal;
        }
      } else if (modelSelect.options.length > 0) {
        let matchedIdx = -1;
        for (let i = 0; i < modelSelect.options.length; i++) {
          if (modelSelect.options[i].value.toLowerCase() === currModel.toLowerCase()) {
            matchedIdx = i;
            break;
          }
        }
        if (matchedIdx >= 0) modelSelect.selectedIndex = matchedIdx;
        else modelSelect.selectedIndex = 0;
      }
    }

    updateSummary();
  };

  // Category Buttons Event Listeners
  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      if (val) populateVehicleCascade('category', val);
    });
  });

  // Brand Dropdown Listener
  brandSelect?.addEventListener('change', () => {
    populateVehicleCascade('brand');
  });

  // Model Dropdown Listener
  modelSelect?.addEventListener('change', () => {
    const selectedM = modelSelect.value;
    const v = (window.fullVehicleList || []).find(veh => (veh.brand + ' ' + veh.model).toLowerCase() === selectedM.toLowerCase());
    if (v) {
      if (catInput) catInput.value = v.category;
      catButtons.forEach(b => {
        const attrVal = b.getAttribute('data-val');
        const bVal = attrVal ? attrVal.toLowerCase() : '';
        if (bVal === v.category) {
          b.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
          b.classList.add('bg-red-600', 'text-white', 'border-red-500');
        } else {
          b.classList.remove('bg-red-600', 'text-white', 'border-red-500');
          b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        }
      });
    }
    updateSummary();
  });

  // Transmission Switch Buttons
  const transButtons = document.querySelectorAll('.trans-btn');
  const transInput = document.getElementById('field-transmission');
  transButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      if (val && transInput) {
        transInput.value = val;
        transButtons.forEach(b => {
          b.classList.remove('bg-red-600', 'text-white', 'border-red-500');
          b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        });
        btn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
        btn.classList.add('bg-red-600', 'text-white', 'border-red-500');
        updateSummary();
      }
    });
  });

  // Dates Calculation Logic
  const startDateInput = document.getElementById('field-start-date');
  const endDateInput = document.getElementById('field-end-date');
  const durationDisplay = document.getElementById('display-duration');
  const sumDuration = document.getElementById('summary-duration');

  const today = new Date();
  const tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);

  if (startDateInput && endDateInput) {
    startDateInput.min = today.toISOString().split('T')[0];
    startDateInput.value = today.toISOString().split('T')[0];
    endDateInput.min = startDateInput.value;
    endDateInput.value = tomorrow.toISOString().split('T')[0];
  }

  const calculateDatesDuration = () => {
    if (!startDateInput || !endDateInput) return;
    const start = new Date(startDateInput.value);
    const end = new Date(endDateInput.value);
    if (end < start) {
      endDateInput.value = startDateInput.value;
    }
    const diffTime = Math.abs(new Date(endDateInput.value).getTime() - new Date(startDateInput.value).getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) || 1;
    const text = diffDays + ' Rental Day' + (diffDays > 1 ? 's' : '');

    if (durationDisplay) durationDisplay.textContent = text;
    if (sumDuration) sumDuration.textContent = text;
  };

  startDateInput?.addEventListener('change', () => {
    if (endDateInput && startDateInput) endDateInput.min = startDateInput.value;
    calculateDatesDuration();
  });
  endDateInput?.addEventListener('change', calculateDatesDuration);

  // Stepper Capacity Controls & Fit Check
  const pInput = document.getElementById('field-passengers');
  const lInput = document.getElementById('field-luggage');

  const seatingDiagramMap = {
    'corolla': '/vehicles/seating/corolla-5-seat.svg',
    'civic': '/vehicles/seating/corolla-5-seat.svg',
    'fortuner': '/vehicles/seating/fortuner-7-seat.svg',
    'hiace': '/vehicles/seating/hiace-13-seat.svg',
    'coaster': '/vehicles/seating/coaster-22-seat.svg',
    'alto': '/vehicles/seating/alto-4-seat.svg'
  };

  const getSeatingDiagramForModel = (modelName) => {
    const k = (modelName || '').toLowerCase();
    for (const key in seatingDiagramMap) {
      if (k.includes(key)) return seatingDiagramMap[key];
    }
    return '/vehicles/seating/corolla-5-seat.svg';
  };

  const checkTripFit = () => {
    const pCount = parseInt(pInput ? pInput.value : '4', 10);
    const lCount = parseInt(lInput ? lInput.value : '2', 10);
    const modelElem = document.getElementById('field-model');
    const model = modelElem ? modelElem.value : '';

    const fitTitle = document.getElementById('trip-fit-title');
    const fitDesc = document.getElementById('trip-fit-desc');
    const fitIcon = document.getElementById('trip-fit-icon');
    const seatingImg = document.getElementById('configurator-seating-img');
    const seatingText = document.getElementById('configurator-seating-text');
    const bootNote = document.getElementById('configurator-boot-note');
    const altBox = document.getElementById('alt-vehicle-recommendation');
    const tripBox = document.getElementById('trip-fit-box');

    if (seatingImg) {
      seatingImg.src = getSeatingDiagramForModel(model);
    }

    if (pCount > 12) {
      if (fitTitle) fitTitle.textContent = 'CONSIDER A LARGER VEHICLE (COASTER BUS)';
      if (fitDesc) fitDesc.textContent = pCount + ' passengers require a 22-seater Toyota Coaster or bus.';
      if (fitIcon) fitIcon.textContent = '🚌';
      if (seatingText) seatingText.textContent = 'Toyota Coaster Executive 22-seat layout required.';
      if (bootNote) bootNote.textContent = 'Heavy luggage capacity with rear cargo deck.';
      if (altBox) altBox.classList.remove('hidden');
      if (tripBox) {
        tripBox.className = 'bg-amber-950/80 border border-amber-800 p-4 rounded-xl space-y-3';
      }
    } else if (pCount > 5 || lCount >= 4) {
      if (fitTitle) fitTitle.textContent = '⚠ LUGGAGE MAY BE TIGHT (CONSIDER SUV / VAN)';
      if (fitDesc) fitDesc.textContent = pCount + ' passengers and ' + lCount + ' large bags fit best in 7-seat Fortuner or HiAce Van.';
      if (fitIcon) fitIcon.textContent = '⚠️';
      if (seatingText) seatingText.textContent = 'Standard sedan luggage space may be tight for this cargo volume.';
      if (bootNote) bootNote.textContent = 'Consider 3rd row SUV or Grand Cabin Van.';
      if (altBox) altBox.classList.remove('hidden');
      if (tripBox) {
        tripBox.className = 'bg-amber-950/80 border border-amber-800 p-4 rounded-xl space-y-3';
      }
    } else {
      if (fitTitle) fitTitle.textContent = '✓ GOOD FIT';
      if (fitDesc) fitDesc.textContent = pCount + ' passengers and ' + lCount + ' bags fit comfortably in ' + model + '.';
      if (fitIcon) fitIcon.textContent = '✓';
      if (seatingText) seatingText.textContent = 'Top-down cabin layout with verified seating positions.';
      if (bootNote) bootNote.textContent = 'Boot space verified for standard baggage.';
      if (altBox) altBox.classList.add('hidden');
      if (tripBox) {
        tripBox.className = 'bg-emerald-950/60 border border-emerald-800/80 p-4 rounded-xl space-y-3';
      }
    }
  };

  document.getElementById('btn-inc-passengers')?.addEventListener('click', () => {
    if (pInput) { pInput.value = (parseInt(pInput.value) + 1).toString(); updateSummary(); }
  });
  document.getElementById('btn-dec-passengers')?.addEventListener('click', () => {
    if (pInput && parseInt(pInput.value) > 1) { pInput.value = (parseInt(pInput.value) - 1).toString(); updateSummary(); }
  });
  document.getElementById('btn-inc-luggage')?.addEventListener('click', () => {
    if (lInput) { lInput.value = (parseInt(lInput.value) + 1).toString(); updateSummary(); }
  });
  document.getElementById('btn-dec-luggage')?.addEventListener('click', () => {
    if (lInput && parseInt(lInput.value) > 0) { lInput.value = (parseInt(lInput.value) - 1).toString(); updateSummary(); }
  });

  document.getElementById('field-brand')?.addEventListener('change', updateSummary);
  document.getElementById('field-model')?.addEventListener('change', updateSummary);
  document.getElementById('field-mode')?.addEventListener('change', updateSummary);
  document.getElementById('field-pickup')?.addEventListener('input', updateSummary);
  document.getElementById('field-destination')?.addEventListener('input', updateSummary);

  // URL Parameter Pre-filling & Initial Dynamic Cascade Hydration
  const urlParams = new URLSearchParams(window.location.search);
  const paramVehicle = urlParams.get('vehicle');
  const paramBrand = urlParams.get('brand');
  const paramModel = urlParams.get('model');
  const paramCategory = urlParams.get('category');

  if (paramCategory && catInput) {
    catInput.value = paramCategory.toLowerCase();
  }

  populateVehicleCascade('init');

  if (paramBrand && brandSelect) {
    for (let i = 0; i < brandSelect.options.length; i++) {
      if (brandSelect.options[i].value.toLowerCase().includes(paramBrand.toLowerCase())) {
        brandSelect.selectedIndex = i;
        populateVehicleCascade('brand');
        break;
      }
    }
  }

  if (paramModel || paramVehicle) {
    const targetModel = (paramModel || paramVehicle || '').replace(/-/g, ' ');
    populateVehicleCascade('model', targetModel);
  }

  // Populate Review Screen
  const populateReviewScreen = () => {
    const brandElem = document.getElementById('field-brand');
    const modelElem = document.getElementById('field-model');
    const transElem = document.getElementById('field-transmission');
    const modeElem = document.getElementById('field-mode');
    const catElem = document.getElementById('field-category');
    const pickupElem = document.getElementById('field-pickup');
    const destElem = document.getElementById('field-destination');
    const startElem = document.getElementById('field-start-date');
    const endElem = document.getElementById('field-end-date');
    const pElem = document.getElementById('field-passengers');
    const lElem = document.getElementById('field-luggage');
    const nameElem = document.getElementById('field-name');
    const phoneElem = document.getElementById('field-phone');

    const brand = brandElem ? brandElem.value : '';
    const model = modelElem ? modelElem.value : '';
    const trans = transElem ? transElem.value : '';
    const mode = modeElem ? modeElem.value : '';
    const cat = catElem ? catElem.value : '';

    const pickup = pickupElem ? pickupElem.value : '';
    const dest = destElem ? destElem.value : '';
    const distText = document.getElementById('route-calc-distance')?.textContent || '375 km';
    const durText = document.getElementById('route-calc-duration')?.textContent || '4 hrs 30 mins';

    const start = startElem ? startElem.value : '';
    const end = endElem ? endElem.value : '';
    const daysText = durationDisplay?.textContent || '1 Day';

    const pCount = pElem ? pElem.value : '';
    const lCount = lElem ? lElem.value : '';

    const name = nameElem ? nameElem.value : '';
    const phone = phoneElem ? phoneElem.value : '';

    const rVehicle = document.getElementById('review-vehicle-title');
    const rTrans = document.getElementById('review-transmission');
    const rMode = document.getElementById('review-mode');
    const rCat = document.getElementById('review-category');

    const rPickup = document.getElementById('review-pickup');
    const rDest = document.getElementById('review-destination');
    const rDist = document.getElementById('review-distance');
    const rDurRoute = document.getElementById('review-duration-route');

    const rStart = document.getElementById('review-start-date');
    const rEnd = document.getElementById('review-end-date');
    const rDur = document.getElementById('review-duration');
    const rCap = document.getElementById('review-capacity');

    const rName = document.getElementById('review-name');
    const rPhone = document.getElementById('review-phone');

    if (rVehicle) rVehicle.textContent = `${brand} ${model}`;
    if (rTrans) rTrans.textContent = trans;
    if (rMode) rMode.textContent = mode;
    if (rCat) rCat.textContent = cat;

    if (rPickup) rPickup.textContent = pickup;
    if (rDest) rDest.textContent = dest;
    if (rDist) rDist.textContent = distText;
    if (rDurRoute) rDurRoute.textContent = durText;

    if (rStart) rStart.textContent = start;
    if (rEnd) rEnd.textContent = end;
    if (rDur) rDur.textContent = daysText;
    if (rCap) rCap.textContent = `${pCount} Pax, ${lCount} Bags`;

    if (rName) rName.textContent = name;
    if (rPhone) rPhone.textContent = phone;
  };

  // Structured WhatsApp Message Builder
  const buildWhatsAppMessage = () => {
    const brandElem = document.getElementById('field-brand');
    const modelElem = document.getElementById('field-model');
    const transElem = document.getElementById('field-transmission');
    const modeElem = document.getElementById('field-mode');
    const catElem = document.getElementById('field-category');
    const pickupElem = document.getElementById('field-pickup');
    const destElem = document.getElementById('field-destination');
    const startElem = document.getElementById('field-start-date');
    const endElem = document.getElementById('field-end-date');
    const pElem = document.getElementById('field-passengers');
    const lElem = document.getElementById('field-luggage');
    const purposeElem = document.getElementById('field-purpose');
    const nameElem = document.getElementById('field-name');
    const phoneElem = document.getElementById('field-phone');
    const companyElem = document.getElementById('field-company');
    const notesElem = document.getElementById('field-notes');

    const brand = brandElem ? brandElem.value : '';
    const model = modelElem ? modelElem.value : '';
    const trans = transElem ? transElem.value : '';
    const mode = modeElem ? modeElem.value : '';
    const cat = catElem ? catElem.value : '';

    const pickup = pickupElem ? pickupElem.value : '';
    const dest = destElem ? destElem.value : '';
    const distText = document.getElementById('route-calc-distance')?.textContent || '375 km';
    const durText = document.getElementById('route-calc-duration')?.textContent || '4 hrs 30 mins';

    const start = startElem ? startElem.value : '';
    const end = endElem ? endElem.value : '';
    const daysText = durationDisplay?.textContent || '1 Day';

    const pCount = pElem ? pElem.value : '';
    const lCount = lElem ? lElem.value : '';
    const purpose = purposeElem ? purposeElem.value : '';

    const name = nameElem ? nameElem.value : '';
    const phone = phoneElem ? phoneElem.value : '';
    const company = companyElem ? companyElem.value : '';
    const notes = notesElem ? notesElem.value : '';

    return (
      'Hello 4WHEELS, I would like to send a configured rental inquiry.\n\n' +
      '🚗 VEHICLE SELECTION\n' +
      '• Model: ' + brand + ' ' + model + '\n' +
      '• Category: ' + cat.toUpperCase() + '\n' +
      '• Transmission: ' + trans + '\n' +
      '• Rental Mode: ' + mode + '\n\n' +
      '📍 ROUTE & DATES\n' +
      '• Pickup: ' + pickup + '\n' +
      '• Drop-off: ' + dest + '\n' +
      '• Estimated Distance: ' + distText + ' (' + durText + ')\n' +
      '• Start Date: ' + start + '\n' +
      '• End Date: ' + end + '\n' +
      '• Total Duration: ' + daysText + '\n\n' +
      '👥 TRAVELERS & PURPOSE\n' +
      '• Passengers: ' + pCount + ' Occupants\n' +
      '• Luggage: ' + lCount + ' Large Bags\n' +
      '• Trip Purpose: ' + purpose + '\n\n' +
      '👤 CUSTOMER INFORMATION\n' +
      '• Name: ' + name + '\n' +
      '• Phone: ' + phone + '\n' +
      (company ? '• Company: ' + company + '\n' : '') +
      (notes ? '• Special Notes: ' + notes + '\n' : '') +
      '\nPlease confirm vehicle availability and current rental quotation. Thank you.'
    );
  };

  // WhatsApp Button Trigger
  document.getElementById('btn-send-whatsapp')?.addEventListener('click', () => {
    const text = buildWhatsAppMessage();
    window.open(`https://wa.me/923216616644?text=${encodeURIComponent(text)}`, '_blank');
  });

  // Copy Inquiry Button Trigger
  const copyToast = document.getElementById('copy-toast');
  document.getElementById('btn-copy-inquiry')?.addEventListener('click', () => {
    const text = buildWhatsAppMessage();
    navigator.clipboard.writeText(text).then(() => {
      if (copyToast) {
        copyToast.classList.remove('hidden');
        setTimeout(() => copyToast.classList.add('hidden'), 3000);
      }
    });
  });

  // Mobile Summary Drawer Toggle
  const toggleDrawerBtn = document.getElementById('btn-toggle-mobile-drawer');
  const summaryDrawer = document.getElementById('summary-drawer');
  const arrowIcon = document.getElementById('drawer-arrow-icon');

  toggleDrawerBtn?.addEventListener('click', () => {
    if (summaryDrawer) {
      summaryDrawer.classList.toggle('hidden');
      if (summaryDrawer.classList.contains('hidden')) {
        if (arrowIcon) arrowIcon.textContent = '▲';
      } else {
        if (arrowIcon) arrowIcon.textContent = '▼';
        summaryDrawer.scrollIntoView({ behavior: 'smooth' });
      }
    }
  });

  updateSummary();
</script>
