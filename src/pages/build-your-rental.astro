---
import Layout from '../layouts/Layout.astro';
import { FLEET_VEHICLES } from '../data/fleet';
import { PAKISTAN_VEHICLE_CATALOG, type CatalogVehicle } from '../data/pakistanVehicles';
import { PAKISTAN_BRANDS, type Brand } from '../data/brands';
import { GROUP_TRANSPORT_VEHICLES } from '../data/groupTransport';
import { VERIFIED_ROUTE_DATABASE } from '../data/routes';
import { BUSINESS_INFO } from '../data/business';
import { resolveVehicleImage } from '../utils/vehicleImageProvider';

// Combine fleet and request catalog into unified list
const allCatalogVehicles = [...PAKISTAN_VEHICLE_CATALOG];

// Build brand vehicle count maps per category
const brandCategoryCountMap: Record<string, Record<string, number>> = {};
PAKISTAN_BRANDS.forEach(b => {
  brandCategoryCountMap[b.slug] = { all: 0 };
});

allCatalogVehicles.forEach(v => {
  const bSlug = v.brandSlug.toLowerCase();
  if (!brandCategoryCountMap[bSlug]) {
    brandCategoryCountMap[bSlug] = { all: 0 };
  }
  brandCategoryCountMap[bSlug].all = (brandCategoryCountMap[bSlug].all || 0) + 1;
  const cat = v.category.toLowerCase();
  brandCategoryCountMap[bSlug][cat] = (brandCategoryCountMap[bSlug][cat] || 0) + 1;
});

// Pre-resolved image map for client JS hydration
const resolvedVehicleMap: Record<string, any> = {};

allCatalogVehicles.forEach(v => {
  const resolved = resolveVehicleImage(v);
  const brandName = v.brand || '';
  const keys = [
    v.id.toLowerCase(),
    v.slug.toLowerCase(),
    v.model.toLowerCase(),
    `${brandName} ${v.model}`.toLowerCase(),
    `${brandName}-${v.model}`.toLowerCase().replace(/\s+/g, '-')
  ];
  keys.forEach(k => {
    if (k && k.trim()) {
      resolvedVehicleMap[k.trim()] = resolved;
    }
  });
});

const title = "Build Your Rental - 4WHEELS Rent a Car Lahore";
const description = "Modern visual rental selection experience. Choose category, brand, model, and route for instant verified quote and direct WhatsApp reservation.";
const canonicalPath = "/build-your-rental/";

// Category definitions with real representative imagery
const CATEGORIES = [
  {
    id: 'sedan',
    name: 'Car / Sedan',
    tagline: 'Family trips • Outstation travel • Everyday luxury',
    image: '/vehicles/fleet/toyota-corolla/hero.jpg',
    popularModel: 'Toyota Corolla / Honda Civic'
  },
  {
    id: 'suv',
    name: 'SUV / 4x4',
    tagline: 'Northern tours • Tough roads • Generous luggage',
    image: '/vehicles/fleet/toyota-fortuner/hero.jpg',
    popularModel: 'Toyota Fortuner / Kia Sportage'
  },
  {
    id: 'hatchback',
    name: 'Hatchback / Economy',
    tagline: 'City commuting • Fuel efficient • Easy parking',
    image: '/vehicles/fleet/suzuki-alto/hero.jpg',
    popularModel: 'Suzuki Alto / Swift'
  },
  {
    id: 'luxury',
    name: 'Luxury / Executive',
    tagline: 'VIP protocol • Wedding motorcades • Executive events',
    image: '/vehicles/fleet/audi-a6/hero.jpg',
    popularModel: 'Audi A6 / Hyundai Sonata'
  },
  {
    id: 'van',
    name: 'Van / MPV',
    tagline: 'Group travel • Airport protocol • 11-13 passengers',
    image: '/vehicles/fleet/toyota-hiace/hero.jpg',
    popularModel: 'Toyota HiAce / Kia Carnival'
  },
  {
    id: 'coaster',
    name: 'Coaster',
    tagline: '22 Seater mini bus • With Driver • Family & tour groups',
    image: '/vehicles/fleet/toyota-coaster/hero.jpg',
    popularModel: 'Toyota Coaster 22-Seater'
  },
  {
    id: 'bus',
    name: 'Bus / Coach',
    tagline: 'Large tour groups • Conferences • 28 to 51 seats',
    image: '/vehicles/fleet/toyota-coaster/hero.jpg',
    popularModel: 'Yutong & Daewoo Coaches'
  },
  {
    id: 'pickup',
    name: 'Pickup / 4x4',
    tagline: 'Off-road double cab • Field projects • Rugged terrain',
    image: '/vehicles/fleet/toyota-revo/hero.jpg',
    popularModel: 'Toyota Hilux Revo / BYD Shark 6'
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Header Banner -->
  <section class="bg-slate-900 text-white py-8 sm:py-10 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e0121a_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="bg-red-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-widest mb-3 inline-block shadow-md">
        4WHEELS Rental Booking Experience
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-2">
        Build & Reserve Your Rental
      </h1>
      <p class="text-slate-300 text-xs sm:text-base max-w-2xl mx-auto leading-relaxed">
        Visual vehicle selection. Choose your vehicle type, brand, and model for instant WhatsApp reservation with 4WHEELS Rent a Car Lahore.
      </p>
    </div>
  </section>

  <!-- Main Configurator Section -->
  <section class="py-8 sm:py-12 bg-slate-950 text-white min-h-[90vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Step Indicator Bar -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 mb-8 shadow-xl">
        <!-- Desktop Stepper Labels -->
        <div class="hidden md:flex items-center justify-between text-xs font-extrabold text-slate-400">
          <div id="step-tab-1" class="step-tab flex items-center gap-2 text-red-500">
            <span class="w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center text-xs">1</span>
            <span>Category</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-2" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">2</span>
            <span>Brand</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-3" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">3</span>
            <span>Model</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-4" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">4</span>
            <span>Route</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-5" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">5</span>
            <span>Dates</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-6" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">6</span>
            <span>Details</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-7" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">7</span>
            <span>Review</span>
          </div>
        </div>

        <!-- Mobile Stepper Header -->
        <div class="md:hidden flex items-center justify-between">
          <div>
            <span class="text-[10px] font-black text-red-500 uppercase tracking-widest block">Booking Flow</span>
            <span id="mobile-step-title" class="text-sm font-extrabold text-white">Step 1: Choose Category</span>
          </div>
          <span id="mobile-step-counter" class="text-xs font-black bg-red-600 text-white px-3 py-1 rounded-full">
            1 of 7
          </span>
        </div>
      </div>

      <!-- Split Screen Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- LEFT (7 cols): Interactive Visual Selection Steps -->
        <div class="lg:col-span-7 bg-slate-900 rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-xl">

          <!-- STEP 1: CHOOSE VEHICLE CATEGORY -->
          <div id="step-panel-1" class="step-panel space-y-6">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white">What type of vehicle do you need?</h2>
                <p class="text-xs text-slate-400">Select a category to view matching brands and real vehicle models.</p>
              </div>
              <span class="text-xs text-slate-400">Step 1 of 7</span>
            </div>

            <!-- Visual Category Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="category-cards-grid">
              {CATEGORIES.map(cat => (
                <div
                  class="cat-card group relative bg-slate-950 border border-slate-800 hover:border-red-500 rounded-2xl p-4 cursor-pointer transition-all duration-300 hover:shadow-lg flex flex-col justify-between"
                  data-cat-id={cat.id}
                >
                  <div class="aspect-[16/9] w-full rounded-xl overflow-hidden bg-slate-900 border border-slate-800/80 mb-3 relative">
                    <img
                      src={cat.image}
                      alt={`${cat.name} rental in Lahore`}
                      loading="eager"
                      class="w-full h-full object-contain p-2 transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute bottom-1 right-2 text-[10px] text-slate-400 font-semibold bg-slate-950/80 px-2 py-0.5 rounded">
                      Real Photography
                    </div>
                  </div>
                  <div>
                    <h3 class="text-base font-black text-white group-hover:text-red-400 transition-colors">
                      {cat.name}
                    </h3>
                    <p class="text-xs text-slate-400 mt-1 leading-snug">
                      {cat.tagline}
                    </p>
                    <p class="text-[11px] text-amber-400/90 font-medium mt-2">
                      Popular: {cat.popularModel}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- STEP 2: CHOOSE BRAND -->
          <div id="step-panel-2" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-xl font-black text-white">Choose a Brand</h2>
                <p class="text-xs text-slate-400">Filtered for <span id="selected-cat-label" class="text-red-400 font-bold uppercase">All Categories</span></p>
              </div>
              <button type="button" class="btn-change-cat text-xs text-red-400 font-bold hover:underline">
                ← Change Category
              </button>
            </div>

            <!-- Brand Search Bar -->
            <div class="relative">
              <input
                type="text"
                id="brand-search-input"
                placeholder="Search brands (e.g. BYD, Toyota, Haval, Deepal)..."
                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none"
              />
            </div>

            <!-- Horizontal / Grid Brand Tiles Container -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="brand-tiles-container">
              <div
                class="brand-tile bg-red-600/20 border-red-500 border rounded-xl p-3.5 cursor-pointer transition-all flex items-center justify-between"
                data-brand-slug="all"
              >
                <div>
                  <div class="text-sm font-extrabold text-white">ALL BRANDS</div>
                  <div class="text-[11px] text-slate-300">Show all matching vehicles</div>
                </div>
                <span class="text-xs font-black bg-red-600 text-white px-2 py-0.5 rounded">
                  All
                </span>
              </div>

              {PAKISTAN_BRANDS.map(b => (
                <div
                  class="brand-tile bg-slate-950 border border-slate-800 hover:border-red-500 rounded-xl p-3.5 cursor-pointer transition-all flex items-center justify-between group"
                  data-brand-slug={b.slug}
                  data-brand-categories={b.categories.join(',')}
                >
                  <div>
                    <div class="text-sm font-extrabold text-white group-hover:text-red-400 transition-colors">
                      {b.name}
                    </div>
                    <div class="text-[10px] text-slate-400">
                      {b.country}
                    </div>
                  </div>
                  <span class="brand-count-badge text-[10px] font-black bg-slate-800 text-slate-300 group-hover:bg-red-600 group-hover:text-white px-2 py-0.5 rounded">
                    {b.vehicleCount} models
                  </span>
                </div>
              ))}
            </div>

            <div class="pt-2 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-2.5 rounded-xl border border-slate-700">
                ← Back
              </button>
            </div>
          </div>

          <!-- STEP 3: CHOOSE MODEL -->
          <div id="step-panel-3" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between flex-wrap gap-2">
              <div>
                <h2 class="text-xl font-black text-white">Choose a Vehicle Model</h2>
                <p class="text-xs text-slate-400">Select model to continue booking with 4WHEELS.</p>
              </div>
              <button type="button" class="btn-change-brand text-xs text-red-400 font-bold hover:underline">
                ← Change Brand
              </button>
            </div>

            <!-- Model Cards Grid Container -->
            <div class="grid grid-cols-1 gap-4" id="model-cards-container">
              <!-- Dynamically populated via JS -->
            </div>

            <div class="pt-2 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-2.5 rounded-xl border border-slate-700">
                ← Back
              </button>
            </div>
          </div>

          <!-- STEP 4: ROUTE & RENTAL TYPE -->
          <div id="step-panel-4" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white">4. Pickup & Drop-off Route</h2>
                <p class="text-xs text-slate-400">Set route locations for verified distance and travel time estimate.</p>
              </div>
              <span class="text-xs text-slate-400">Step 4 of 7</span>
            </div>

            <!-- Selected Vehicle Pre-Selected Banner with CHANGE VEHICLE button -->
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-red-500 uppercase tracking-wider block">Selected Vehicle</span>
                <h3 id="preselect-title" class="text-lg font-black text-white">Toyota Corolla</h3>
                <p id="preselect-subtitle" class="text-xs text-slate-400">Sedan • Automatic • Petrol</p>
              </div>
              <button type="button" id="btn-change-vehicle-main" class="text-xs font-bold text-red-400 hover:text-red-300 underline">
                CHANGE VEHICLE
              </button>
            </div>

            <div class="space-y-4">
              <div>
                <label for="field-mode" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Rental Mode</label>
                <select id="field-mode" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none">
                  <option value="With Driver">With Driver (Chauffeur Service Included)</option>
                  <option value="Self Drive">Self Drive (CNIC & Verification Required)</option>
                </select>
              </div>

              <div>
                <label for="field-pickup" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  📍 Pickup Location <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-pickup" required placeholder="Search area, address, airport or landmark (e.g. Johar Town, Lahore)" value="Johar Town Phase 1, Lahore" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <div>
                <label for="field-destination" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  🏁 Drop-off Destination <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-destination" required placeholder="Search destination (e.g. Islamabad F-7 / Lahore Airport / Murree)" value="Islamabad F-7" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <!-- Route Calculation Display Box -->
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <span class="text-xs font-extrabold text-red-500 uppercase tracking-wider flex items-center gap-1.5">
                    <span>⚡ Route Distance Estimation</span>
                  </span>
                  <span id="calc-status-badge" class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold px-2 py-0.5 rounded">
                    4WHEELS Verified Route Database
                  </span>
                </div>
                <div class="grid grid-cols-2 gap-4 pt-1">
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Estimated Distance</span>
                    <span id="route-calc-distance" class="text-lg font-black text-white">Approx. 375 km</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Driving Duration</span>
                    <span id="route-calc-duration" class="text-lg font-black text-amber-400">4 hrs 30 mins</span>
                  </div>
                </div>

                <p id="route-source-note" class="text-[11px] text-slate-400 font-medium italic border-t border-slate-800/80 pt-2">
                  Planning distance from 4WHEELS verified route database.
                </p>

                <div class="pt-1 flex flex-col gap-2">
                  <a
                    id="btn-google-maps-check"
                    href="https://www.google.com/maps/dir/?api=1&origin=Johar+Town+Lahore&destination=Islamabad+F-7&travelmode=driving"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold text-xs py-2 px-3 rounded-lg border border-slate-700 transition-colors"
                  >
                    <span>🗺️ CHECK ROUTE ON GOOGLE MAPS</span>
                    <span>↗</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm px-6 py-3 rounded-xl border border-slate-700">
                ← Back
              </button>
              <button type="button" class="btn-next bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm px-7 py-3 rounded-xl shadow-lg transition-all flex items-center gap-2">
                <span>Next: Dates</span>
                <span>→</span>
              </button>
            </div>
          </div>

          <!-- STEP 5: DATES -->
          <div id="step-panel-5" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white">5. Select Rental Dates</h2>
                <p class="text-xs text-slate-400">Pick start date and expected end date.</p>
              </div>
              <span class="text-xs text-slate-400">Step 5 of 7</span>
            </div>

            <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="field-start-date" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Start Date <span class="text-red-500">*</span></label>
                  <input type="date" id="field-start-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
                </div>
                <div>
                  <label for="field-end-date" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">End Date <span class="text-red-500">*</span></label>
                  <input type="date" id="field-end-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
                </div>
              </div>

              <div class="bg-red-950/60 border border-red-800/80 rounded-xl p-3.5 flex items-center justify-between">
                <span class="text-xs font-bold text-red-200">Total Rental Duration:</span>
                <span id="display-duration" class="text-sm font-black text-white bg-red-600 px-3 py-1 rounded-lg shadow-md">
                  1 Rental Day
                </span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm px-6 py-3 rounded-xl border border-slate-700">
                ← Back
              </button>
              <button type="button" class="btn-next bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm px-7 py-3 rounded-xl shadow-lg transition-all flex items-center gap-2">
                <span>Next: Passengers & Details</span>
                <span>→</span>
              </button>
            </div>
          </div>

          <!-- STEP 6: TRIP DETAILS & CAPACITY -->
          <div id="step-panel-6" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-xl font-black text-white">6. Trip Requirements & Passengers</h2>
                <p class="text-xs text-slate-400">Specify group size, luggage, and trip purpose.</p>
              </div>
              <span class="text-xs text-slate-400">Step 6 of 7</span>
            </div>

            <!-- Group Size Selector for Bus / Coaster -->
            <div id="bus-group-size-container" class="hidden bg-slate-950 p-4 rounded-xl border border-amber-800/80 space-y-3">
              <label class="block text-xs font-extrabold uppercase tracking-wider text-amber-300">
                🚌 Group Size / Seating Requirement
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="group-size-buttons">
                <button type="button" class="group-size-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-amber-600 text-white border-amber-500" data-size="20">Up to 20</button>
                <button type="button" class="group-size-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-size="30">21–30</button>
                <button type="button" class="group-size-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-size="40">31–40</button>
                <button type="button" class="group-size-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-size="50">41–50</button>
