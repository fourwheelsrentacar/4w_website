  window.getVehicleImageInfo = (modelName) => {
    const key = (modelName || '').toLowerCase();
    for (const k in window.vehicleMapData) {
      if (key.includes(k) || k.includes(key)) return window.vehicleMapData[k];
    }
    return {
      imageUrl: '/vehicles/fleet/toyota-corolla/hero.jpg',
