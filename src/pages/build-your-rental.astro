---
import Layout from '../layouts/Layout.astro';
import { FLEET_VEHICLES, FLEET_VEHICLES as FLEET } from '../data/fleet';
import { PAKISTAN_VEHICLE_CATALOG } from '../data/pakistanVehicles';
import { VERIFIED_ROUTE_DATABASE } from '../data/routes';
import { BUSINESS_INFO } from '../data/business';
import { resolveVehicleImage } from '../utils/vehicleImageProvider';

// Pre-compute resolved vehicle images and full structured vehicle list for client-side JS filtering
const allVehicles = [...PAKISTAN_VEHICLE_CATALOG, ...FLEET_VEHICLES];
const resolvedVehicleMap: Record<string, any> = {};

const fullVehicleList = PAKISTAN_VEHICLE_CATALOG.map(v => ({
  id: v.id,
  brand: v.brand,
  model: v.model,
  slug: v.slug,
  category: v.category.toLowerCase(),
  variant: v.variant || '',
  transmission: v.transmission,
  fuelType: v.fuelType,
  isFleetConfirmed: v.isFleetConfirmed
}));

allVehicles.forEach(v => {
  const resolved = resolveVehicleImage(v);
  const brandName = (v as any).manufacturer || (v as any).brand || '';
  const keys = [
    v.slug.toLowerCase(),
    v.slug.replace(/-/g, ' ').toLowerCase(),
    v.model.toLowerCase(),
    `${brandName} ${v.model}`.toLowerCase(),
    `${brandName}-${v.model}`.toLowerCase().replace(/\s+/g, '-')
  ];
  keys.forEach(k => {
    if (k && k.trim()) {
      resolvedVehicleMap[k.trim()] = resolved;
    }
  });
});

const title = "Build Your Rental - 4WHEELS Rent a Car Lahore Configurator";
const description = "Configure your rental car booking online with live vehicle visual preview, Pakistan route duration estimation, passenger/luggage fit check, and instant WhatsApp inquiry.";
const canonicalPath = "/build-your-rental/";
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <!-- Header Banner -->
  <section class="bg-slate-900 text-white py-8 sm:py-12 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e0121a_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="bg-red-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-widest mb-3 inline-block shadow-md">
        Automotive Smart Configurator
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-3">
        Build & Reserve Your Rental
      </h1>
      <p class="text-slate-300 text-xs sm:text-base max-w-2xl mx-auto leading-relaxed">
        Modern 6-step configurator. Live vehicle preview, automatic trip capacity fit check, route distance estimate, and direct WhatsApp customer care connection.
      </p>
    </div>
  </section>

  <!-- Main Configurator Split-Screen Section -->
  <section class="py-8 sm:py-12 bg-slate-950 text-white min-h-[90vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Progress Bar (Desktop & Mobile Responsive) -->
      <div class="bg-slate-900 rounded-2xl border border-slate-800 p-4 mb-8 shadow-xl">
        <!-- Desktop Stepper Labels -->
        <div class="hidden md:flex items-center justify-between text-xs font-extrabold text-slate-400">
          <div id="step-tab-1" class="step-tab flex items-center gap-2 text-red-500">
            <span class="w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center text-xs">1</span>
            <span>Vehicle</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-2" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">2</span>
            <span>Route</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-3" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">3</span>
            <span>Dates</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-4" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">4</span>
            <span>Trip</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-5" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">5</span>
            <span>Details</span>
          </div>
          <div class="h-0.5 flex-1 bg-slate-800 mx-2"></div>
          <div id="step-tab-6" class="step-tab flex items-center gap-2">
            <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">6</span>
            <span>Review</span>
          </div>
        </div>

        <!-- Mobile Responsive Progress Bar -->
        <div class="md:hidden flex items-center justify-between">
          <div>
            <span class="text-[10px] font-black text-red-500 uppercase tracking-widest block">Step Progress</span>
            <span id="mobile-step-title" class="text-sm font-extrabold text-white">Step 1: Vehicle Selection</span>
          </div>
          <span id="mobile-step-counter" class="text-xs font-black bg-red-600 text-white px-3 py-1 rounded-full">
            1 of 6
          </span>
        </div>
      </div>

      <!-- Split Layout Container -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- LEFT 65%: Interactive Step Forms -->
        <div class="lg:col-span-7 bg-slate-900 rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-xl">

          <!-- STEP 1: VEHICLE SELECTION -->
          <div id="step-panel-1" class="step-panel space-y-6">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <h2 class="text-xl font-black text-white">1. Choose Your Vehicle</h2>
              <span class="text-xs text-slate-400">Step 1 of 6</span>
            </div>

            <!-- Preselected Vehicle Highlight Banner -->
            <div id="vehicle-preselected-banner" class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-red-500 uppercase">Selected Vehicle</span>
                <h3 id="preselect-title" class="text-lg font-black text-white">Toyota Corolla</h3>
                <p id="preselect-subtitle" class="text-xs text-slate-400">Sedan • Automatic • Petrol</p>
              </div>
              <button type="button" id="btn-toggle-vehicle-picker" class="text-xs font-bold text-red-400 hover:text-red-300 underline">
                CHANGE VEHICLE
              </button>
            </div>

            <!-- Vehicle Selection Controls -->
            <div id="vehicle-picker-container" class="space-y-4">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                Select Model Category
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="category-buttons">
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-red-600 text-white border-red-500 shadow-sm" data-val="sedan">Sedan</button>
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="suv">SUV / 4x4</button>
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="hatchback">Hatchback</button>
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="van">Van / HiAce</button>
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="coaster">Coaster Bus</button>
                <button type="button" class="cat-btn border rounded-xl p-3 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="luxury">Luxury / Executive</button>
              </div>
              <input type="hidden" id="field-category" value="sedan" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div>
                  <label for="field-brand" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Brand</label>
                  <select id="field-brand" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none">
                    <option value="Toyota">Toyota</option>
                    <option value="Honda">Honda</option>
                    <option value="Suzuki">Suzuki</option>
                    <option value="Audi">Audi</option>
                    <option value="Hyundai">Hyundai</option>
                    <option value="BYD">BYD</option>
                    <option value="Deepal">Deepal</option>
                    <option value="Changan">Changan</option>
                    <option value="MG">MG</option>
                    <option value="Haval">Haval</option>
                  </select>
                </div>

                <div>
                  <label for="field-model" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Model</label>
                  <select id="field-model" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none">
                    <option value="Toyota Corolla">Toyota Corolla (Grandi / Altis)</option>
                    <option value="Toyota Yaris">Toyota Yaris</option>
                    <option value="Toyota Fortuner">Toyota Fortuner SUV</option>
                    <option value="Toyota Hilux Revo">Toyota Hilux Revo 4x4</option>
                    <option value="Toyota HiAce">Toyota HiAce Grand Cabin</option>
                    <option value="Toyota Coaster">Toyota Coaster Saloon (22-Seat)</option>
                    <option value="Honda Civic">Honda Civic (Oriel / RS)</option>
                    <option value="Honda City">Honda City</option>
                    <option value="Suzuki Alto">Suzuki Alto</option>
                    <option value="Suzuki Swift">Suzuki Swift</option>
                    <option value="Audi A6">Audi A6 Executive</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="field-mode" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Rental Mode</label>
                  <select id="field-mode" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none">
                    <option value="With Driver">With Driver (Chauffeur Service)</option>
                    <option value="Self Drive">Self Drive (CNIC & Verification Required)</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Transmission</label>
                  <div class="grid grid-cols-2 gap-2" id="transmission-buttons">
                    <button type="button" class="trans-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-red-600 text-white border-red-500" data-val="Automatic">Automatic</button>
                    <button type="button" class="trans-btn border rounded-xl p-2.5 text-center text-xs font-bold bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750" data-val="Manual">Manual</button>
                  </div>
                  <input type="hidden" id="field-transmission" value="Automatic" />
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-end">
              <button type="button" class="btn-next bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm px-7 py-3 rounded-xl shadow-lg transition-all flex items-center gap-2">
                <span>Next: Pickup & Drop-off</span>
                <span>→</span>
              </button>
            </div>
          </div>

          <!-- STEP 2: PICKUP & DROP-OFF -->
          <div id="step-panel-2" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <h2 class="text-xl font-black text-white">2. Pickup & Drop-off Location</h2>
              <span class="text-xs text-slate-400">Step 2 of 6</span>
            </div>

            <div class="space-y-4">
              <div>
                <label for="field-pickup" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  📍 Pickup Location <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-pickup" required placeholder="Search area, address, airport or landmark (e.g. Johar Town, Lahore)" value="Johar Town Phase 1, Lahore" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <div>
                <label for="field-destination" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
                  🏁 Drop-off Destination <span class="text-red-500">*</span>
                </label>
                <input type="text" id="field-destination" required placeholder="Search destination (e.g. Islamabad F-7 / Lahore Airport / Murree)" value="Islamabad F-7" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3.5 text-sm font-semibold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
              </div>

              <!-- Route Calculation Display Box -->
              <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <span class="text-xs font-extrabold text-red-500 uppercase tracking-wider flex items-center gap-1.5">
                    <span>⚡ Route Distance Estimation</span>
                  </span>
                  <span id="calc-status-badge" class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold px-2 py-0.5 rounded">
                    4WHEELS Verified Route Database
                  </span>
                </div>
                <div class="grid grid-cols-2 gap-4 pt-1">
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Estimated Distance</span>
                    <span id="route-calc-distance" class="text-lg font-black text-white">Approx. 375 km</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-500 uppercase font-bold block">Driving Duration</span>
                    <span id="route-calc-duration" class="text-lg font-black text-amber-400">4 hrs 30 mins</span>
                  </div>
                </div>

                <p id="route-source-note" class="text-[11px] text-slate-400 font-medium italic border-t border-slate-800/80 pt-2">
                  Planning distance from 4WHEELS verified route database. Last verified: 2026-08-18
                </p>

                <!-- Google Maps External Link & Unknown Route Custom Input -->
                <div class="pt-1 flex flex-col gap-2">
                  <a
                    id="btn-google-maps-check"
                    href="https://www.google.com/maps/dir/?api=1&origin=Johar+Town+Lahore&destination=Islamabad+F-7&travelmode=driving"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold text-xs py-2 px-3 rounded-lg border border-slate-700 transition-colors"
                  >
                    <span>🗺️ CHECK ROUTE ON GOOGLE MAPS</span>
                    <span>↗</span>
                  </a>

                  <div id="custom-distance-container" class="hidden space-y-1.5 pt-1">
                    <label for="field-custom-distance" class="block text-[11px] font-bold text-amber-300">
                      I checked Google Maps. Distance shown by Google:
                    </label>
                    <div class="flex items-center gap-2">
                      <input
                        type="number"
                        id="field-custom-distance"
                        placeholder="e.g. 240"
                        class="w-32 bg-slate-800 border border-slate-700 rounded-lg p-2 text-xs font-bold text-white focus:ring-1 focus:ring-red-500"
                      />
                      <span class="text-xs text-slate-400 font-semibold">km</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm px-6 py-3 rounded-xl border border-slate-700">
                ← Back
              </button>
              <button type="button" class="btn-next bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm px-7 py-3 rounded-xl shadow-lg transition-all flex items-center gap-2">
                <span>Next: Dates</span>
                <span>→</span>
              </button>
            </div>
          </div>

          <!-- STEP 3: DATES -->
          <div id="step-panel-3" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <h2 class="text-xl font-black text-white">3. Select Rental Dates</h2>
              <span class="text-xs text-slate-400">Step 3 of 6</span>
            </div>

            <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="field-start-date" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Start Date <span class="text-red-500">*</span></label>
                  <input type="date" id="field-start-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
                </div>
                <div>
                  <label for="field-end-date" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">End Date <span class="text-red-500">*</span></label>
                  <input type="date" id="field-end-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm font-bold text-white focus:ring-1 focus:ring-red-500 focus:outline-none" />
                </div>
              </div>

              <div class="bg-red-950/60 border border-red-800/80 rounded-xl p-3.5 flex items-center justify-between">
                <span class="text-xs font-bold text-red-200">Total Rental Duration:</span>
                <span id="display-duration" class="text-sm font-black text-white bg-red-600 px-3 py-1 rounded-lg shadow-md">
                  1 Rental Day
                </span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800 flex justify-between">
              <button type="button" class="btn-prev bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm px-6 py-3 rounded-xl border border-slate-700">
                ← Back
              </button>
              <button type="button" class="btn-next bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm px-7 py-3 rounded-xl shadow-lg transition-all flex items-center gap-2">
                <span>Next: Trip & Capacity</span>
                <span>→</span>
              </button>
            </div>
          </div>

          <!-- STEP 4: TRIP & CAPACITY -->
          <div id="step-panel-4" class="step-panel space-y-6 hidden">
            <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
              <h2 class="text-xl font-black text-white">4. Passengers & Luggage Capacity</h2>
              <span class="text-xs text-slate-400">Step 4 of 6</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="field-passengers" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Passengers</label>
                <div class="flex items-center gap-3 bg-slate-800 p-2 rounded-xl border border-slate-700">
                  <button type="button" id="btn-dec-passengers" class="w-10 h-10 bg-slate-700 text-white font-black text-lg rounded-lg hover:bg-slate-600">-</button>
                  <input type="number" id="field-passengers" min="1" max="50" value="4" readonly class="w-full bg-transparent text-center font-black text-lg text-white focus:outline-none" />
                  <button type="button" id="btn-inc-passengers" class="w-10 h-10 bg-slate-700 text-white font-black text-lg rounded-lg hover:bg-slate-600">+</button>
                </div>
              </div>

              <div>
                <label for="field-luggage" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Large Bags</label>
                <div class="flex items-center gap-3 bg-slate-800 p-2 rounded-xl border border-slate-700">
                  <button type="button" id="btn-dec-luggage" class="w-10 h-10 bg-slate-700 text-white font-black text-lg rounded-lg hover:bg-slate-600">-</button>
                  <input type="number" id="field-luggage" min="0" max="30" value="2" readonly class="w-full bg-transparent text-center font-black text-lg text-white focus:outline-none" />
                  <button type="button" id="btn-inc-luggage" class="w-10 h-10 bg-slate-700 text-white font-black text-lg rounded-lg hover:bg-slate-600">+</button>
                </div>
              </div>
            </div>

            <!-- Dynamic Trip Fit Indicator Box with Capacity Visual Diagram -->
            <div id="trip-fit-box" class="bg-emerald-950/60 border border-emerald-800/80 p-4 rounded-xl space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span id="trip-fit-icon" class="text-lg">✓</span>
                  <div>
                    <span id="trip-fit-title" class="text-xs font-black text-emerald-400 block uppercase tracking-wider">✓ GOOD FIT</span>
                    <span id="trip-fit-desc" class="text-[11px] text-slate-300">4 passengers and 2 bags fit comfortably in selected vehicle.</span>
                  </div>
                </div>
                <span id="trip-fit-badge" class="text-[10px] font-bold bg-emerald-900 text-emerald-200 px-2.5 py-1 rounded">
                  VERIFIED CAPACITY
                </span>
              </div>

              <!-- Top-Down Seating Visual Preview in Configurator -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex items-center gap-4">
                <img id="configurator-seating-img" src="/vehicles/seating/corolla-5-seat.svg" alt="Seating Layout" class="w-24 h-24 object-contain" />
                <div class="text-xs space-y-1">
                  <div class="font-bold text-slate-200">2D Seating & Cargo Arrangement</div>
                  <div class="text-[11px] text-slate-400" id="configurator-seating-text">Top-down cabin diagram with driver & passenger positions.</div>
                  <div class="text-[10px] text-emerald-400 font-semibold" id="configurator-boot-note">Boot space verified for suitcases.</div>
                </div>
              </div>

              <!-- Alternative Vehicle Recommendation (if capacity tight) -->
              <div id="alt-vehicle-recommendation" class="hidden bg-slate-900 p-3 rounded-lg border border-slate-700 space-y-2">
                <div class="text-xs font-bold text-amber-300">💡 Recommended Alternative Vehicles with Higher Capacity:</div>
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <a href="/vehicles/toyota/fortuner/" class="bg-slate-950 p-2 rounded border border-slate-800 hover:border-red-500 block">
                    <span class="font-black text-white block">Toyota Fortuner</span>
                    <span class="text-[10px] text-slate-400">7 Seats • 4 Large Bags</span>
                  </a>
                  <a href="/vehicles/toyota/hiace/" class="bg-slate-950 p-2 rounded border border-slate-800 hover:border-red-500 block">
                    <span class="font-black text-white block">Toyota HiAce</span>
                    <span class="text-[10px] text-slate-400">13 Seats • 8 Large Bags</span>
                  </a>
                </div>
              </div>
            </div>

            <div>
