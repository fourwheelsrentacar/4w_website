---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import { BUSINESS_INFO } from '../data/business';

const pageTitle = `Official Brand Guidelines & Press Assets - ${BUSINESS_INFO.name}`;
const pageDescription = `Official brand guidelines, typography, color tokens, logo downloads, and acceptable usage rules for ${BUSINESS_INFO.name}.`;
---

<html lang="en">
  <head>
    <SEOHead title={pageTitle} description={pageDescription} canonicalUrl={`${BUSINESS_INFO.siteUrl}/brand/`} />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-12">
      <!-- Breadcrumb -->
      <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-red-600 transition">Home</a></li>
          <li><span>/</span></li>
          <li><a href="/press/" class="hover:text-red-600 transition">Press Centre</a></li>
          <li><span>/</span></li>
          <li class="font-medium text-slate-800">Brand Guidelines</li>
        </ol>
      </nav>

      <div class="border-b border-slate-200 pb-8 mb-12">
        <span class="inline-block px-3 py-1 bg-red-100 text-red-700 text-xs font-bold uppercase tracking-wider rounded-full mb-3">Brand Identity System</span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">4WHEELS Brand Guidelines</h1>
        <p class="mt-4 text-xl text-slate-600 max-w-3xl">
          Official standards for representing 4WHEELS Rent a Car across media, digital publications, and customer communications.
        </p>
      </div>

      <!-- Section 1: Official Brand Name -->
      <section class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">1. Brand Name & Approved Spelling</h2>
        <p class="text-slate-600 mb-6">
          To maintain legal integrity and prevent customer confusion with third-party entities, always use the approved exact brand name.
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6">
            <h3 class="text-emerald-800 font-bold text-lg mb-2">✓ Approved Usage</h3>
            <ul class="space-y-2 text-emerald-900 font-medium">
              <li>• <strong>4WHEELS Rent a Car</strong> (Primary)</li>
              <li>• <strong>4WHEELS</strong> (Short Form / Local Context)</li>
            </ul>
          </div>
          <div class="bg-red-50 border border-red-200 rounded-xl p-6">
            <h3 class="text-red-800 font-bold text-lg mb-2">✗ Incorrect Usage (Do Not Use)</h3>
            <ul class="space-y-2 text-red-900 font-medium">
              <li>• 4 Wheels Rental</li>
              <li>• 4wheel rental</li>
              <li>• Four Wheels Rental</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 2: Logo System -->
      <section class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">2. Official Logo System</h2>
        <p class="text-slate-600 mb-6">
          Download vector SVG and high-resolution PNG logo assets for publication.
        </p>
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="bg-slate-100 rounded-xl p-6 text-center border border-slate-200">
            <div class="h-24 flex items-center justify-center mb-4">
              <img src="/brand/logo-primary.svg" alt="4WHEELS Primary Logo" class="max-h-16" />
            </div>
            <h3 class="font-bold text-slate-800 mb-1">Primary Light Background</h3>
            <p class="text-xs text-slate-500 mb-4">For white and light grey layouts.</p>
            <a href="/brand/logo-primary.svg" download class="inline-block text-xs font-bold px-3 py-2 bg-slate-800 text-white rounded hover:bg-slate-700 transition">Download SVG</a>
          </div>

          <div class="bg-slate-900 rounded-xl p-6 text-center border border-slate-800">
            <div class="h-24 flex items-center justify-center mb-4">
              <img src="/brand/logo-dark.svg" alt="4WHEELS Dark Logo" class="max-h-16" />
            </div>
            <h3 class="font-bold text-white mb-1">Dark Background</h3>
            <p class="text-xs text-slate-400 mb-4">For dark backgrounds & footers.</p>
            <a href="/brand/logo-dark.svg" download class="inline-block text-xs font-bold px-3 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition">Download SVG</a>
          </div>

          <div class="bg-slate-100 rounded-xl p-6 text-center border border-slate-200">
            <div class="h-24 flex items-center justify-center mb-4">
              <img src="/brand/logo-mark.svg" alt="4WHEELS Brand Mark" class="max-h-16" />
            </div>
            <h3 class="font-bold text-slate-800 mb-1">Brand Mark / Icon</h3>
            <p class="text-xs text-slate-500 mb-4">For avatars, app icons, and social media.</p>
            <a href="/brand/logo-mark.svg" download class="inline-block text-xs font-bold px-3 py-2 bg-slate-800 text-white rounded hover:bg-slate-700 transition">Download SVG</a>
          </div>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
          <h3 class="font-bold text-slate-800 mb-2">Clear Space & Minimum Sizing Rules</h3>
          <p class="text-slate-600 text-sm">
            Maintain a minimum clear margin equal to the height of the '4' mark around the logo. Minimum digital display width for the primary logo lockup is 140px.
          </p>
        </div>
      </section>

      <!-- Section 3: Brand Colors -->
      <section class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">3. Brand Color Tokens</h2>
        <p class="text-slate-600 mb-6">
          Central CSS variable tokens define the visual palette across all digital surfaces.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-4 rounded-xl border border-slate-200 bg-white">
            <div class="h-16 rounded-lg mb-3 shadow-inner" style="background-color: #e0121a;"></div>
            <h4 class="font-bold text-slate-800 text-sm">Primary Brand Red</h4>
            <p class="text-xs font-mono text-slate-500">HEX: #e0121a</p>
            <p class="text-xs text-slate-400 mt-1">var(--color-primary)</p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 bg-white">
            <div class="h-16 rounded-lg mb-3 shadow-inner" style="background-color: #111827;"></div>
            <h4 class="font-bold text-slate-800 text-sm">Dark Neutral</h4>
            <p class="text-xs font-mono text-slate-500">HEX: #111827</p>
            <p class="text-xs text-slate-400 mt-1">var(--color-secondary)</p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 bg-white">
            <div class="h-16 rounded-lg mb-3 shadow-inner" style="background-color: #f8fafc;"></div>
            <h4 class="font-bold text-slate-800 text-sm">Subtle Surface</h4>
            <p class="text-xs font-mono text-slate-500">HEX: #f8fafc</p>
            <p class="text-xs text-slate-400 mt-1">var(--color-surface-subtle)</p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 bg-white">
            <div class="h-16 rounded-lg mb-3 shadow-inner" style="background-color: #16a34a;"></div>
            <h4 class="font-bold text-slate-800 text-sm">Success Green</h4>
            <p class="text-xs font-mono text-slate-500">HEX: #16a34a</p>
            <p class="text-xs text-slate-400 mt-1">var(--color-success)</p>
          </div>
        </div>
      </section>

      <!-- Section 4: Tone of Voice & Photography -->
      <section class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">4. Tone of Voice</h2>
          <ul class="space-y-3 text-slate-600 text-sm">
            <li class="flex items-start"><span class="text-emerald-600 font-bold mr-2">✓</span> <strong>Direct & Helpful:</strong> Provide clear, transparent answers regarding rental options in Lahore.</li>
            <li class="flex items-start"><span class="text-emerald-600 font-bold mr-2">✓</span> <strong>Local Knowledge:</strong> Speak accurately about Lahore roads, airports, and commercial centers.</li>
            <li class="flex items-start"><span class="text-red-600 font-bold mr-2">✗</span> <strong>Avoid Sensational Claims:</strong> Do not make up unverified "No.1" market share statistics or fake certifications.</li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">5. Photography & Assets</h2>
          <p class="text-slate-600 text-sm mb-4">
            Imagery must portray real, clean vehicles in authentic automotive settings.
          </p>
          <ul class="space-y-2 text-slate-600 text-sm">
            <li>• Prefer clean photography of actual fleet vehicles (Corolla, Civic, Sportage, Prado).</li>
            <li>• Avoid stock photos showing foreign license plates or exotic supercars not offered in Lahore.</li>
            <li>• Attribute third-party media sources in <code>IMAGE_SOURCES.md</code>.</li>
          </ul>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
