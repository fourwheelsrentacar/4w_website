---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = 'Frequently Asked Questions', items } = Astro.props;
---

<section class="py-12 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 my-8 shadow-sm">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-8 text-center">{title}</h2>
    <div class="space-y-6">
      {items.map((item) => (
        <div class="border-b border-slate-100 pb-6 last:border-0 last:pb-0">
          <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-start gap-2">
            <span class="text-red-600 font-extrabold">Q:</span>
            <span>{item.question}</span>
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed pl-6">
            {item.answer}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
