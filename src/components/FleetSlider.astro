---
import { FLEET_VEHICLES, type Vehicle } from '../data/fleet';
import { BUSINESS_INFO } from '../data/business';

interface Props {
  title?: string;
  subtitle?: string;
  vehicles?: any[];
  autoplay?: boolean;
}

const {
  title = "POPULAR 4WHEELS VEHICLES",
  subtitle = "Directly available from 4WHEELS Johar Town headquarters in Lahore",
  vehicles = FLEET_VEHICLES.slice(0, 8),
  autoplay = false
} = Astro.props;

const sliderItems = vehicles.map((v: any) => ({
  id: v.id,
  slug: v.slug,
  brand: v.manufacturer || v.brand,
  model: v.model,
  variant: v.variant || '',
  img: v.heroImage || v.vehicleImage?.imageUrl || v.images?.[0] || `/vehicles/fleet/${v.slug}/hero.webp`,
  year: v.yearRange || v.modelYear || '2024–2026',
  tagline: v.headline || v.tagline || v.description || 'Verified 4WHEELS core rental fleet vehicle.',
  seats: v.seatingCapacity || v.seats || 5,
  transmission: v.transmission || 'Automatic',
  fuelType: v.fuelType || 'Petrol',
  alt: v.imageAlt || `${v.manufacturer || v.brand} ${v.model} ${v.variant || ''} rental in Lahore with driver or self-drive`
}));
---

<section class="py-14 bg-slate-50/70 border-y border-slate-200 text-slate-900 overflow-hidden" id="fleet-slider-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header & Controls -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 border border-red-200 text-red-600 text-xs font-black uppercase tracking-wider mb-2">
          <span>🚗 Verified Core Fleet</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight">
          {title}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">
          {subtitle}
        </p>
      </div>

      <!-- Arrow Controls & Pagination -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          id="embla-prev"
          aria-label="Previous Vehicle Slide"
          class="w-10 h-10 rounded-xl bg-white hover:bg-red-600 text-slate-700 hover:text-white border border-slate-200 flex items-center justify-center font-black text-lg transition-all shadow-sm hover:shadow-md disabled:opacity-40 cursor-pointer"
        >
          ‹
        </button>
        <button
          type="button"
          id="embla-next"
          aria-label="Next Vehicle Slide"
          class="w-10 h-10 rounded-xl bg-white hover:bg-red-600 text-slate-700 hover:text-white border border-slate-200 flex items-center justify-center font-black text-lg transition-all shadow-sm hover:shadow-md disabled:opacity-40 cursor-pointer"
        >
          ›
        </button>
      </div>
    </div>

    <!-- Embla Carousel Viewport -->
    <div class="embla overflow-hidden" id="fleet-embla-viewport">
      <div class="embla__container flex gap-4 sm:gap-6 py-2">
        {sliderItems.map((v) => (
          <div class="embla__slide shrink-0 w-[86%] sm:w-[47%] lg:w-[31%] bg-white border border-slate-200/90 hover:border-red-500 rounded-2xl p-5 flex flex-col justify-between transition-all duration-300 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.06)] hover:shadow-[0_12px_32px_-4px_rgba(224,18,26,0.12)] hover:-translate-y-1 group">
            <div>
              <!-- Vehicle Image Stage -->
              <div class="aspect-[16/9] bg-gradient-to-b from-slate-50 via-white to-slate-100/60 rounded-xl overflow-hidden border border-slate-200/80 p-3 mb-4 relative flex items-center justify-center">
                <img
                  src={v.img}
                  alt={v.alt}
                  loading="lazy"
                  class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                />
                <span class="absolute top-2 left-2 text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full uppercase tracking-wider">
                  ✓ AVAILABLE
                </span>
                <span class="absolute bottom-2 right-2 text-[10px] font-bold bg-white/90 text-slate-700 px-2 py-0.5 rounded-full border border-slate-200 shadow-xs">
                  {v.year}
                </span>
              </div>

              <!-- Specs & Details -->
              <div class="space-y-2">
                <span class="text-[10px] font-extrabold text-red-600 uppercase tracking-wider block">
                  {v.brand}
                </span>
                <h3 class="text-lg font-black text-slate-900 group-hover:text-red-600 transition-colors">
                  {v.brand} {v.model}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 font-medium">
                  {v.tagline}
                </p>

                <!-- Spec Chips (Instrument Cluster Gauges) -->
                <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-bold">
                  <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg border border-slate-200/80 flex items-center gap-1">
                    👥 {v.seats} Seats
                  </span>
                  <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg border border-slate-200/80 flex items-center gap-1">
                    ⚙️ {v.transmission}
                  </span>
                  <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg border border-slate-200/80 flex items-center gap-1">
                    ⛽ {v.fuelType}
                  </span>
                </div>
              </div>
            </div>

            <!-- STRICT CTA COMPLIANCE: BOOK YOUR TRIP & CALL ONLY -->
            <div class="pt-5 border-t border-slate-100 mt-4 space-y-2">
              <a
                href={`/booking/?vehicle=${v.slug}&brand=${encodeURIComponent(v.brand)}&model=${encodeURIComponent(v.model)}`}
                class="w-full bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs py-3 rounded-xl block text-center uppercase tracking-wider shadow-md transition-all active:scale-98"
              >
                🚗 BOOK YOUR TRIP
              </a>
              <a
                href={BUSINESS_INFO.telLink}
                class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-2.5 rounded-xl block text-center border border-slate-200 transition-colors"
              >
                📞 CALL {BUSINESS_INFO.phoneDisplay}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Dots Pagination Indicator -->
    <div class="flex justify-center items-center gap-2 mt-6" id="embla-dots"></div>

  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  const viewportNode = document.getElementById('fleet-embla-viewport');
  const prevBtn = document.getElementById('embla-prev');
  const nextBtn = document.getElementById('embla-next');
  const dotsContainer = document.getElementById('embla-dots');

  if (viewportNode) {
    const embla = EmblaCarousel(viewportNode as HTMLElement, {
      loop: true,
      align: 'start',
      skipSnaps: false,
      dragFree: false
    });

    const updateDots = () => {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      const snapList = embla.scrollSnapList();
      const selectedSnap = embla.selectedScrollSnap();

      snapList.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.ariaLabel = `Go to slide ${index + 1}`;
        dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${
          index === selectedSnap ? 'bg-red-600 w-6' : 'bg-slate-300 hover:bg-slate-400'
        }`;
        dot.addEventListener('click', () => embla.scrollTo(index));
        dotsContainer.appendChild(dot);
      });
    };

    prevBtn?.addEventListener('click', () => embla.scrollPrev());
    nextBtn?.addEventListener('click', () => embla.scrollNext());

    embla.on('select', updateDots);
    embla.on('init', updateDots);
    updateDots();
  }
</script>
