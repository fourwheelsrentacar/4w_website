---
import { BUSINESS_INFO } from '../data/business';

export interface Props {
  heading?: string;
  subheading?: string;
  ctaType?: 'price' | 'trip' | 'general';
}

const {
  heading = 'Need the Latest Rental Price?',
  subheading = 'Quotations vary based on vehicle selection, duration, fuel, route, and driver requirements. Contact 4WHEELS directly for an accurate quote.',
  ctaType = 'price',
} = Astro.props;

let whatsappLink = BUSINESS_INFO.whatsappPriceLink;
let whatsappText = '💬 WhatsApp for Latest Price';

if (ctaType === 'trip') {
  whatsappLink = BUSINESS_INFO.whatsappTripLink;
  whatsappText = '💬 WhatsApp for Trip Information';
} else if (ctaType === 'general') {
  whatsappLink = BUSINESS_INFO.whatsappLink;
  whatsappText = '💬 WhatsApp to Book';
}
---

<section class="bg-gradient-to-br from-slate-900 to-slate-800 text-white py-12 md:py-16 px-4 rounded-2xl my-8 text-center max-w-7xl mx-auto shadow-xl border border-slate-700/50">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="inline-block bg-slate-800 text-red-400 text-xs font-semibold px-3 py-1 rounded-full border border-slate-700">
      {BUSINESS_INFO.trustBadge}
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight">
      {heading}
    </h2>
    <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
      {subheading}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a
        href={BUSINESS_INFO.telLink}
        class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white text-base font-bold px-8 py-3.5 rounded-xl transition-all shadow-lg hover:shadow-red-600/30 text-center flex items-center justify-center gap-2"
      >
        <span>📞 Call {BUSINESS_INFO.phoneDisplay}</span>
      </a>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white text-base font-bold px-8 py-3.5 rounded-xl transition-all shadow-lg hover:shadow-emerald-600/30 text-center flex items-center justify-center gap-2"
      >
        <span>{whatsappText}</span>
      </a>
    </div>
  </div>
</section>
