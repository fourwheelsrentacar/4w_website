---
export interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  ctaText?: string;
}

const { title, description, href, icon = '🚗', ctaText = 'Learn More & Book' } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-slate-200 p-6 flex flex-col justify-between">
  <div>
    <div class="text-3xl mb-3">{icon}</div>
    <h3 class="text-xl font-bold text-slate-900 mb-2">{title}</h3>
    <p class="text-slate-600 text-sm leading-relaxed mb-6">{description}</p>
  </div>
  <div>
    <a
      href={href}
      class="inline-flex items-center text-sm font-bold text-red-600 hover:text-red-700 transition-colors group"
    >
      <span>{ctaText}</span>
      <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</div>
