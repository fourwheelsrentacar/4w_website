---
import type { Vehicle } from '../data/fleet';
import { resolveVehicleImage, type ResolvedVehicleImage } from '../utils/vehicleImageProvider';

interface Props {
  vehicle: any;
  loading?: 'lazy' | 'eager';
  className?: string;
  showLabel?: boolean;
  aspectRatio?: 'auto' | 'video' | 'square' | 'wide';
}

const {
  vehicle,
  loading = 'lazy',
  className = '',
  showLabel = true,
  aspectRatio = 'wide'
} = Astro.props;

const resolved: ResolvedVehicleImage = resolveVehicleImage(vehicle);

const altText = vehicle?.imageAlt || `${resolved.make} ${resolved.model} ${resolved.generation} - 4WHEELS Rent a Car Lahore`;

let aspectClass = 'aspect-[16/9]';
if (aspectRatio === 'video') aspectClass = 'aspect-video';
if (aspectRatio === 'square') aspectClass = 'aspect-square';
if (aspectRatio === 'auto') aspectClass = 'aspect-auto';

---

<div class={`vehicle-image-stage relative overflow-hidden rounded-xl bg-gradient-to-b from-slate-100 via-slate-50 to-slate-200/50 border border-slate-200 group ${aspectClass} ${className}`}>
  <!-- Subtle Floor Reflection Stage -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-slate-300/30 via-white/40 to-transparent pointer-events-none"></div>

  <!-- Vehicle Artwork Container -->
  <div class="relative z-10 w-full h-full flex items-center justify-center p-3 sm:p-4">
    <img
      src={resolved.imageUrl}
      alt={altText}
      loading={loading}
      data-fallback={resolved.fallbackUrl}
      onerror={`if (this.src !== this.getAttribute('data-fallback')) { this.src = this.getAttribute('data-fallback'); }`}
      class="w-[88%] sm:w-[85%] md:w-[82%] max-h-[85%] object-contain drop-shadow-[0_12px_20px_rgba(15,23,42,0.18)] transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>

  <!-- Floor Contact Shadow Effect -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[70%] h-3 bg-slate-900/10 blur-md rounded-full pointer-events-none"></div>

  <!-- Disclaimer Compliance Label -->
  {showLabel && (
    <div class="absolute bottom-1.5 left-2 right-2 text-center z-20 pointer-events-none">
      <p class="text-[10px] sm:text-xs text-slate-500 font-medium tracking-tight truncate bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded border border-slate-200 inline-block max-w-full shadow-xs">
        {resolved.label}
      </p>
    </div>
  )}

  <!-- Quality Verification Badge if Actual Fleet -->
  {resolved.type === 'actual-fleet' && (
    <div class="absolute top-2 left-2 z-20">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        Actual Fleet Unit
      </span>
    </div>
  )}
</div>
