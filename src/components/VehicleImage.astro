---
import type { Vehicle } from '../data/fleet';
import { resolveVehicleImage, type ResolvedVehicleImage } from '../utils/vehicleImageProvider';

interface Props {
  vehicle: any;
  loading?: 'lazy' | 'eager';
  className?: string;
  showLabel?: boolean;
  aspectRatio?: 'auto' | 'video' | 'square' | 'wide';
  enableInteractiveGallery?: boolean;
}

const {
  vehicle,
  loading = 'lazy',
  className = '',
  showLabel = true,
  aspectRatio = 'wide',
  enableInteractiveGallery = true
} = Astro.props;

const resolved: ResolvedVehicleImage = resolveVehicleImage(vehicle);

// Aggregate multi-image views if available (hero + gallery + interior)
const galleryList: string[] = [resolved.imageUrl];
if (vehicle?.images && Array.isArray(vehicle.images)) {
  vehicle.images.forEach((img: string) => {
    if (img && !galleryList.includes(img)) galleryList.push(img);
  });
}
if (vehicle?.interiorImages && Array.isArray(vehicle.interiorImages)) {
  vehicle.interiorImages.forEach((img: string) => {
    if (img && !galleryList.includes(img)) galleryList.push(img);
  });
}

const altText = vehicle?.imageAlt || `${resolved.make} ${resolved.model} ${resolved.generation} - 4WHEELS Rent a Car Lahore`;

let aspectClass = 'aspect-[16/9]';
if (aspectRatio === 'video') aspectClass = 'aspect-video';
if (aspectRatio === 'square') aspectClass = 'aspect-square';
if (aspectRatio === 'auto') aspectClass = 'aspect-auto';

const uniqueId = `stage-${Math.random().toString(36).substring(2, 9)}`;
---

<div id={uniqueId} class={`vehicle-image-stage relative overflow-hidden rounded-xl bg-gradient-to-b from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800/80 group ${aspectClass} ${className}`}>
  <!-- Glowing Automotive Radial Floor Backdrop -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-red-950/25 via-slate-900/40 to-slate-950 pointer-events-none"></div>

  <!-- Vehicle Artwork Stage Container -->
  <div class="relative z-10 w-full h-full flex items-center justify-center p-3 sm:p-4">
    <img
      id={`${uniqueId}-img`}
      src={resolved.imageUrl}
      alt={altText}
      loading={loading}
      data-fallback={resolved.fallbackUrl}
      onerror={`if (this.src !== this.getAttribute('data-fallback')) { this.src = this.getAttribute('data-fallback'); }`}
      class="vehicle-stage-img w-[88%] sm:w-[85%] md:w-[82%] max-h-[85%] object-contain drop-shadow-[0_14px_28px_rgba(0,0,0,0.7)] transition-all duration-500 group-hover:scale-[1.03]"
    />
  </div>

  <!-- Multi-Image Dots / Carousel Preview (If multiple views available) -->
  {enableInteractiveGallery && galleryList.length > 1 && (
    <div class="absolute top-2 right-2 z-30 flex items-center gap-1.5 bg-slate-950/80 backdrop-blur-md px-2 py-1 rounded-full border border-slate-700/60 shadow-lg">
      {galleryList.map((imgUrl, idx) => (
        <button
          type="button"
          class={`gallery-preview-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-red-500 ring-2 ring-red-400/50 scale-110' : 'bg-slate-600 hover:bg-slate-400'}`}
          data-stage={uniqueId}
          data-img={imgUrl}
          aria-label={`View photo ${idx + 1}`}
        ></button>
      ))}
    </div>
  )}

  <!-- Floor Contact Shadow Effect -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[70%] h-3 bg-black/60 blur-md rounded-full pointer-events-none"></div>

  <!-- Disclaimer Compliance Label -->
  {showLabel && (
    <div class="absolute bottom-1.5 left-2 right-2 text-center z-20 pointer-events-none">
      <p class="text-[10px] sm:text-xs text-slate-400/90 font-medium tracking-tight truncate bg-slate-950/80 backdrop-blur-sm px-2 py-0.5 rounded border border-slate-800/60 inline-block max-w-full">
        {resolved.label}
      </p>
    </div>
  )}

  <!-- Quality Verification Badge if Actual Fleet -->
  {resolved.type === 'actual-fleet' && (
    <div class="absolute top-2 left-2 z-20">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 backdrop-blur-sm">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        Actual Fleet Unit
      </span>
    </div>
  )}
</div>

<script>
  document.querySelectorAll('.gallery-preview-dot').forEach(dot => {
    dot.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      const targetStageId = dot.getAttribute('data-stage');
      const targetImgUrl = dot.getAttribute('data-img');

      if (!targetStageId || !targetImgUrl) return;

      const imgEl = document.getElementById(`${targetStageId}-img`) as HTMLImageElement;
      if (imgEl) {
        imgEl.style.opacity = '0.3';
        setTimeout(() => {
          imgEl.src = targetImgUrl;
          imgEl.style.opacity = '1';
        }, 150);
      }

      // Update active state among siblings
      const parent = dot.parentElement;
      if (parent) {
        parent.querySelectorAll('.gallery-preview-dot').forEach(d => {
          d.classList.remove('bg-red-500', 'ring-2', 'ring-red-400/50', 'scale-110');
          d.classList.add('bg-slate-600');
        });
        dot.classList.remove('bg-slate-600');
        dot.classList.add('bg-red-500', 'ring-2', 'ring-red-400/50', 'scale-110');
      }
    });
  });
</script>
