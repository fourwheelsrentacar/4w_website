---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category: string;
  relatedSlugs?: string[];
}

const { currentSlug, category, relatedSlugs = [] } = Astro.props;

const allPosts = await getCollection('blog');

let related = allPosts.filter(
  (p) => p.data.slug !== currentSlug && (relatedSlugs.includes(p.data.slug) || p.data.category === category)
);

if (related.length < 3) {
  const remaining = allPosts.filter(
    (p) => p.data.slug !== currentSlug && !related.some((r) => r.data.slug === p.data.slug)
  );
  related = [...related, ...remaining];
}

const displayPosts = related.slice(0, 3);
---

{displayPosts.length > 0 && (
  <section class="mt-12 pt-8 border-t border-slate-200">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Continue Reading</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {displayPosts.map((post) => (
        <a href={`/blog/${post.data.slug}/`} class="group bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:border-red-500 hover:shadow-md transition flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-600 bg-red-50 px-2 py-0.5 rounded inline-block mb-2">
              {post.data.category}
            </span>
            <h3 class="font-bold text-slate-900 text-sm group-hover:text-red-600 transition line-clamp-2 mb-2">
              {post.data.title}
            </h3>
            <p class="text-slate-500 text-xs line-clamp-2 mb-4 leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <span class="text-[11px] font-semibold text-slate-400 group-hover:text-red-600 flex items-center transition">
            Read Guide &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
)}
