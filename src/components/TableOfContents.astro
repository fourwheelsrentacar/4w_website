---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav class="toc-container text-sm" aria-label="Table of Contents">
    <!-- Desktop Sticky TOC -->
    <div class="hidden lg:block bg-white rounded-2xl p-6 border border-slate-200 shadow-sm sticky top-8">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">On This Page</h2>
      <ul class="space-y-2 text-slate-600 max-h-[70vh] overflow-y-auto pr-2">
        {tocHeadings.map((heading) => (
          <li class={`leading-snug transition hover:text-red-600 ${heading.depth === 3 ? 'ml-3 text-xs' : 'font-medium'}`}>
            <a href={`#${heading.slug}`} class="block py-0.5">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile Collapsible TOC -->
    <div class="block lg:hidden bg-slate-50 rounded-xl border border-slate-200 p-4 mb-8">
      <details class="group">
        <summary class="flex justify-between items-center font-bold text-slate-800 cursor-pointer list-none">
          <span>On this page</span>
          <span class="transition group-open:rotate-180">▼</span>
        </summary>
        <ul class="mt-3 pt-3 border-t border-slate-200 space-y-2 text-slate-600 text-xs">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'ml-3' : 'font-medium'}>
              <a href={`#${heading.slug}`} class="block py-1 hover:text-red-600">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
)}
