---
import { BUSINESS_INFO } from '../data/business';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Rent a Car', href: '/rent-a-car-lahore/' },
  { name: 'Self Drive', href: '/self-drive-car-rental-lahore/' },
  { name: 'With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Airport Rental', href: '/lahore-airport-car-rental/' },
  { name: 'Monthly Rental', href: '/monthly-car-rental-lahore/' },
  { name: 'Guides', href: '/blog/' },
  { name: 'Verify', href: '/verify-4wheels/' },
  { name: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-slate-900 text-white shadow-md border-b border-slate-800">
  <!-- Top bar with contact info -->
  <div class="bg-slate-950 py-1.5 px-4 text-xs font-medium border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center space-x-4">
        <span>📍 {BUSINESS_INFO.address.locality}, {BUSINESS_INFO.address.city}</span>
        <span class="hidden sm:inline">|</span>
        <span class="hidden sm:inline">Self Drive & Driver Service</span>
      </div>
      <div class="flex items-center space-x-4">
        <a href={BUSINESS_INFO.telLink} class="hover:text-red-400 transition-colors flex items-center gap-1 font-semibold">
          📞 Call: {BUSINESS_INFO.phoneDisplay}
        </a>
        <a href={BUSINESS_INFO.whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1 font-semibold">
          💬 WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main navigation header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 focus:outline-none focus:ring-2 focus:ring-red-500 rounded-md">
        <div class="bg-red-600 text-white font-extrabold text-xl px-3 py-1 rounded tracking-wider">
          4WHEELS
        </div>
        <div class="hidden sm:flex flex-col">
          <span class="text-sm font-bold tracking-tight text-slate-100 uppercase leading-none">Rent a Car</span>
          <span class="text-xs text-slate-400 leading-tight">Lahore</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2 text-sm font-medium">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-md transition-colors ${
                isActive
                  ? 'bg-red-600 text-white font-semibold'
                  : 'text-slate-200 hover:bg-slate-800 hover:text-white'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Header Call CTA -->
      <div class="hidden sm:flex items-center space-x-3">
        <a
          href={BUSINESS_INFO.telLink}
          class="bg-red-600 hover:bg-red-700 text-white text-sm font-bold px-4 py-2.5 rounded-lg transition-colors shadow-sm flex items-center gap-1.5"
        >
          <span>Call / Book Now</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-red-500"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="menu-icon-open" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div class="lg:hidden hidden border-t border-slate-800 bg-slate-900" id="mobile-menu">
    <div class="px-4 pt-2 pb-6 space-y-1 sm:px-3">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-md text-base font-medium ${
              isActive
                ? 'bg-red-600 text-white font-semibold'
                : 'text-slate-200 hover:bg-slate-800 hover:text-white'
            }`}
          >
            {link.name}
          </a>
        );
      })}

      <div class="pt-4 border-t border-slate-800 space-y-2">
        <a
          href={BUSINESS_INFO.telLink}
          class="w-full text-center bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg block transition-colors shadow-sm"
        >
          📞 Call Now ({BUSINESS_INFO.phoneDisplay})
        </a>
        <a
          href={BUSINESS_INFO.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-lg block transition-colors shadow-sm"
        >
          💬 WhatsApp to Book
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuButton && mobileMenu && iconOpen && iconClose) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
