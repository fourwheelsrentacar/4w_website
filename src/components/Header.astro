---
import { BUSINESS_INFO } from '../data/business';
import SiteSearch from './SiteSearch.astro';

const currentPath = Astro.url.pathname;

// Mega Menu items structure
const rentMegaMenu = {
  title: 'Rent a Vehicle',
  href: '/fleet/',
  sections: [
    {
      heading: 'FIND A VEHICLE',
      links: [
        { name: 'All Fleet', href: '/fleet/' },
        { name: 'Cars & Sedans', href: '/fleet/' },
        { name: 'SUVs & 4x4', href: '/fleet/' },
        { name: 'Luxury Cars', href: '/fleet/' },
        { name: 'Vans & Hiace', href: '/fleet/' },
        { name: 'Coasters & Buses', href: '/fleet/buses-coasters/' },
      ]
    },
    {
      heading: 'RENTAL TYPE',
      links: [
        { name: 'Self Drive Rental', href: '/self-drive-car-rental-lahore/' },
        { name: 'Car With Driver', href: '/car-with-driver-lahore/' },
        { name: 'Daily Rental', href: '/daily-car-rental-lahore/' },
        { name: 'Monthly Rental', href: '/monthly-car-rental-lahore/' },
      ]
    },
    {
      heading: 'BY TRANSMISSION & FUEL',
      links: [
        { name: 'Automatic Cars', href: '/fleet/' },
        { name: 'Manual Cars', href: '/fleet/' },
        { name: 'Petrol / Hybrid', href: '/fleet/' },
        { name: 'Diesel / EV', href: '/fleet/' },
      ]
    },
    {
      heading: 'POPULAR NEEDS',
      links: [
        { name: 'Airport Rental', href: '/lahore-airport-car-rental/' },
        { name: 'Outstation Travel', href: '/outstation-car-rental-lahore/' },
        { name: 'Corporate Travel', href: '/corporate-car-rental-lahore/' },
        { name: 'Wedding Transport', href: '/wedding-car-rental-lahore/' },
      ]
    }
  ],
  cta: { name: 'VIEW COMPLETE FLEET', href: '/fleet/' }
};

const planMegaMenu = {
  title: 'Plan a Trip',
  href: '/trip-planner/',
  sections: [
    {
      heading: 'PLAN',
      links: [
        { name: 'Trip Planner', href: '/trip-planner/' },
        { name: 'Trip Cost Estimator', href: '/trip-planner/' },
        { name: 'Find My Vehicle', href: '/find-my-vehicle/' },
        { name: 'Vehicle Comparison', href: '/compare-vehicles/' },
      ]
    },
    {
      heading: 'TRAVEL & ROUTES',
      links: [
        { name: 'Airport Transfers', href: '/lahore-airport-car-rental/' },
        { name: 'Outstation Travel', href: '/outstation-car-rental-lahore/' },
        { name: 'Pakistan Tours', href: '/tour-operator-transport-pakistan/' },
        { name: 'Popular Routes', href: '/routes/' },
        { name: 'Destination Guides', href: '/guides/' },
      ]
    },
    {
      heading: 'EVENTS',
      links: [
        { name: 'Wedding Transport', href: '/wedding-car-rental-lahore/' },
        { name: 'Event Transport', href: '/event-transport-lahore/' },
        { name: 'Group Travel', href: '/fleet/buses-coasters/' },
      ]
    },
    {
      heading: 'TOOLS',
      links: [
        { name: 'Fuel Estimate', href: '/trip-planner/' },
        { name: 'Toll Estimate', href: '/trip-planner/' },
        { name: 'Passenger/Luggage Fit', href: '/find-my-vehicle/' },
      ]
    }
  ],
  cta: { name: 'PLAN MY TRIP', href: '/trip-planner/' }
};

const businessMegaMenu = {
  title: 'Business & Groups',
  href: '/business-car-rental-lahore/',
  sections: [
    {
      heading: 'BUSINESS',
      links: [
        { name: 'Corporate Car Rental', href: '/corporate-car-rental-lahore/' },
        { name: 'Monthly Business Rental', href: '/monthly-car-rental-lahore/' },
        { name: 'Executive Transport', href: '/business-car-rental-lahore/' },
      ]
    },
    {
      heading: 'STAFF',
      links: [
        { name: 'Staff Pick & Drop', href: '/corporate-staff-pick-drop-lahore/' },
        { name: 'Employee Transportation', href: '/corporate-staff-pick-drop-lahore/' },
      ]
    },
    {
      heading: 'GROUPS',
      links: [
        { name: 'Coaster Rental', href: '/fleet/buses-coasters/' },
        { name: 'Bus Rental', href: '/fleet/buses-coasters/' },
        { name: 'Tour Operator Transport', href: '/tour-operator-transport-pakistan/' },
        { name: 'Event Transport', href: '/event-transport-lahore/' },
      ]
    }
  ],
  cta: { name: 'REQUEST BUSINESS TRANSPORT', href: '/corporate-car-rental-lahore/' }
};

const exploreMegaMenu = {
  title: 'Explore',
  href: '/guides/',
  sections: [
    {
      heading: 'LEARN',
      links: [
        { name: 'Knowledge Hub', href: '/guides/' },
        { name: 'Rental Guides', href: '/guides/' },
        { name: 'Rental Rules & FAQ', href: '/faq/' },
        { name: 'Rental Terms', href: '/rental-terms/' },
      ]
    },
    {
      heading: 'DISCOVER',
      links: [
        { name: 'Locations', href: '/locations/' },
        { name: 'Popular Routes', href: '/routes/' },
      ]
    },
    {
      heading: 'COMPANY',
      links: [
        { name: 'About 4WHEELS', href: '/about/' },
        { name: 'Official 4WHEELS', href: '/official/' },
        { name: 'Official Locations', href: '/locations/official/' },
        { name: 'Press Centre', href: '/press/' },
        { name: 'Contact Us', href: '/contact/' },
      ]
    }
  ],
  cta: { name: 'VERIFY 4WHEELS', href: '/official/' }
};
---

<!-- Site Search Modal -->
<SiteSearch />

<header id="main-site-header" class="sticky top-0 z-40 bg-slate-900 text-white shadow-md border-b border-slate-800 transition-all duration-200">
  <!-- Top Utility Bar (Thin 28-34px) -->
  <div id="utility-bar" class="bg-slate-950 py-1 px-4 text-[11px] sm:text-xs font-medium border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto flex justify-between items-center gap-2">
      <div class="flex items-center space-x-2 sm:space-x-3 text-slate-300">
        <span class="truncate">📍 {BUSINESS_INFO.address.locality}, {BUSINESS_INFO.address.city}</span>
        <span class="hidden sm:inline text-slate-600">|</span>
        <span class="hidden sm:inline text-slate-400 font-normal">Serving Lahore Since 2008</span>
      </div>
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a href={BUSINESS_INFO.telLink} class="text-slate-200 hover:text-red-400 transition-colors flex items-center gap-1 font-semibold">
          📞 <span class="hidden xs:inline">Call</span> {BUSINESS_INFO.phoneDisplay}
        </a>
        <a href={BUSINESS_INFO.whatsappLink} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-1 font-semibold">
          💬 <span class="hidden xs:inline">WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Header Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 transition-all duration-200" id="header-nav-bar">
      <!-- Logo -> Home -->
      <a href="/" class="flex items-center space-x-2.5 focus:outline-none focus:ring-2 focus:ring-red-500 rounded-md py-1" aria-label="4WHEELS Rent a Car Home">
        <div class="bg-red-600 text-white font-extrabold text-lg sm:text-xl px-2.5 py-0.5 rounded tracking-wider shadow-sm">
          4WHEELS
        </div>
        <div class="hidden sm:flex flex-col">
          <span class="text-xs font-bold tracking-tight text-slate-100 uppercase leading-none">Rent a Car</span>
          <span class="text-[10px] text-slate-400 leading-tight">Lahore</span>
        </div>
      </a>

      <!-- Desktop Primary Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2 text-sm font-medium" aria-label="Primary navigation">

        <!-- Dropdown 1: Rent a Vehicle -->
        <div class="relative group">
          <button
            type="button"
            class={`px-3 py-2 rounded-md transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-red-500 ${
              currentPath.startsWith('/fleet') || currentPath.includes('rental') ? 'bg-red-600 text-white font-semibold' : 'text-slate-200 hover:bg-slate-800 hover:text-white'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Rent a Vehicle</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Desktop Mega Dropdown Menu -->
          <div class="absolute left-0 top-full pt-2 w-[680px] hidden group-hover:block group-focus-within:block z-50">
            <div class="bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-6 grid grid-cols-4 gap-6 text-xs">
              {rentMegaMenu.sections.map(sec => (
                <div>
                  <p class="font-bold text-red-500 uppercase tracking-wider text-[11px] mb-3">{sec.heading}</p>
                  <ul class="space-y-2">
                    {sec.links.map(link => (
                      <li>
                        <a href={link.href} class="text-slate-300 hover:text-white hover:underline transition-colors block py-0.5">
                          {link.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="col-span-4 pt-3 border-t border-slate-800 flex justify-between items-center">
                <span class="text-slate-400 text-xs">Serving all areas of Lahore & intercity travel.</span>
                <a href={rentMegaMenu.cta.href} class="inline-flex items-center gap-1 font-bold text-red-400 hover:text-red-300 text-xs">
                  {rentMegaMenu.cta.name} →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Dropdown 2: Plan a Trip -->
        <div class="relative group">
          <button
            type="button"
            class={`px-3 py-2 rounded-md transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-red-500 ${
              currentPath.startsWith('/trip-planner') || currentPath.startsWith('/routes') ? 'bg-red-600 text-white font-semibold' : 'text-slate-200 hover:bg-slate-800 hover:text-white'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Plan a Trip</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="absolute left-0 top-full pt-2 w-[640px] hidden group-hover:block group-focus-within:block z-50">
            <div class="bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-6 grid grid-cols-4 gap-6 text-xs">
              {planMegaMenu.sections.map(sec => (
                <div>
                  <p class="font-bold text-amber-400 uppercase tracking-wider text-[11px] mb-3">{sec.heading}</p>
                  <ul class="space-y-2">
                    {sec.links.map(link => (
                      <li>
                        <a href={link.href} class="text-slate-300 hover:text-white hover:underline transition-colors block py-0.5">
                          {link.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="col-span-4 pt-3 border-t border-slate-800 flex justify-between items-center">
                <span class="text-slate-400 text-xs">Calculate fuel, tolls, and rental budget.</span>
                <a href={planMegaMenu.cta.href} class="inline-flex items-center gap-1 font-bold text-amber-400 hover:text-amber-300 text-xs">
                  {planMegaMenu.cta.name} →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Dropdown 3: Business & Groups -->
        <div class="relative group">
          <button
            type="button"
            class={`px-3 py-2 rounded-md transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-red-500 ${
              currentPath.includes('business') || currentPath.includes('corporate') ? 'bg-red-600 text-white font-semibold' : 'text-slate-200 hover:bg-slate-800 hover:text-white'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Business & Groups</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="absolute left-0 top-full pt-2 w-[540px] hidden group-hover:block group-focus-within:block z-50">
            <div class="bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-6 grid grid-cols-3 gap-6 text-xs">
              {businessMegaMenu.sections.map(sec => (
                <div>
                  <p class="font-bold text-blue-400 uppercase tracking-wider text-[11px] mb-3">{sec.heading}</p>
                  <ul class="space-y-2">
                    {sec.links.map(link => (
                      <li>
                        <a href={link.href} class="text-slate-300 hover:text-white hover:underline transition-colors block py-0.5">
                          {link.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="col-span-3 pt-3 border-t border-slate-800 flex justify-between items-center">
                <span class="text-slate-400 text-xs">Monthly, corporate fleet & group coasters.</span>
                <a href={businessMegaMenu.cta.href} class="inline-flex items-center gap-1 font-bold text-blue-400 hover:text-blue-300 text-xs">
                  {businessMegaMenu.cta.name} →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Dropdown 4: Explore -->
        <div class="relative group">
          <button
            type="button"
            class={`px-3 py-2 rounded-md transition-colors flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-red-500 ${
              currentPath.startsWith('/guides') || currentPath.startsWith('/official') || currentPath.startsWith('/locations') ? 'bg-red-600 text-white font-semibold' : 'text-slate-200 hover:bg-slate-800 hover:text-white'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Explore</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="absolute right-0 top-full pt-2 w-[540px] hidden group-hover:block group-focus-within:block z-50">
            <div class="bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-6 grid grid-cols-3 gap-6 text-xs">
              {exploreMegaMenu.sections.map(sec => (
                <div>
                  <p class="font-bold text-emerald-400 uppercase tracking-wider text-[11px] mb-3">{sec.heading}</p>
                  <ul class="space-y-2">
                    {sec.links.map(link => (
                      <li>
                        <a href={link.href} class="text-slate-300 hover:text-white hover:underline transition-colors block py-0.5">
                          {link.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="col-span-3 pt-3 border-t border-slate-800 flex justify-between items-center">
                <span class="text-slate-400 text-xs">Guides, official branch verification & news.</span>
                <a href={exploreMegaMenu.cta.href} class="inline-flex items-center gap-1 font-bold text-emerald-400 hover:text-emerald-300 text-xs">
                  {exploreMegaMenu.cta.name} →
                </a>
              </div>
            </div>
          </div>
        </div>

      </nav>

      <!-- Desktop Header CTAs & Search -->
      <div class="hidden lg:flex items-center space-x-3">
        <!-- Site Search Icon Button -->
        <button
          type="button"
          data-open-search
          class="p-2 text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-red-500"
          aria-label="Open Site Search"
        >
          🔍
        </button>

        <!-- Dominant Commercial CTA -->
        <a
          href="/build-your-rental/"
          class="bg-red-600 hover:bg-red-700 text-white text-xs sm:text-sm font-extrabold px-5 py-2.5 rounded-lg transition-all shadow-md hover:shadow-red-600/20 active:scale-95 uppercase tracking-wide"
        >
          BOOK YOUR TRIP
        </a>
      </div>

      <!-- Mobile Right Utility Controls -->
      <div class="flex items-center lg:hidden space-x-2">
        <button
          type="button"
          data-open-search
          class="p-2 text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
          aria-label="Search site"
        >
          🔍
        </button>
        <a
          href={BUSINESS_INFO.telLink}
          class="p-2 text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
          aria-label="Call 4WHEELS"
        >
          ☎
        </a>
        <button
          type="button"
          id="mobile-drawer-toggle"
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500"
          aria-controls="mobile-drawer"
          aria-expanded="false"
          aria-label="Toggle Navigation Drawer"
        >
          <svg id="drawer-icon-hamburger" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Side Panel (85–92vw) -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity">
    <div id="mobile-drawer" class="fixed top-0 right-0 h-full w-[88vw] max-w-md bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col justify-between overflow-y-auto">

      <!-- Drawer Top Bar -->
      <div>
        <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950">
          <div class="flex items-center space-x-2">
            <div class="bg-red-600 text-white font-black text-base px-2 py-0.5 rounded">4WHEELS</div>
            <span class="text-xs font-bold text-slate-200">Rent a Car</span>
          </div>
          <button
            type="button"
            id="close-mobile-drawer"
            class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg text-sm font-bold"
            aria-label="Close Navigation Menu"
          >
            ✕
          </button>
        </div>

        <!-- Primary Drawer CTA -->
        <div class="p-4 border-b border-slate-800 bg-slate-900/50">
          <a
            href="/build-your-rental/"
            class="w-full text-center bg-red-600 hover:bg-red-700 text-white font-black py-3 px-4 rounded-xl block transition-all shadow-md text-sm uppercase tracking-wide"
          >
            🚗 BOOK YOUR TRIP
          </a>
        </div>

        <!-- Mobile Accordion Menu -->
        <div class="p-4 space-y-3 text-sm">

          <!-- Accordion 1: Rent a Vehicle -->
          <div class="border-b border-slate-800 pb-2">
            <button
              type="button"
              class="w-full flex justify-between items-center py-2 text-left font-bold text-slate-100 focus:outline-none"
              data-accordion="acc-rent"
              aria-expanded="false"
            >
              <span>Rent a Vehicle</span>
              <span class="chevron text-slate-400 text-xs transition-transform">▼</span>
            </button>
            <div id="acc-rent" class="hidden pl-3 py-2 space-y-2 text-xs text-slate-300">
              <a href="/fleet/" class="block py-1 hover:text-white font-semibold text-red-400">All Fleet</a>
              <a href="/self-drive-car-rental-lahore/" class="block py-1 hover:text-white">Self Drive Rental</a>
              <a href="/car-with-driver-lahore/" class="block py-1 hover:text-white">Car With Driver</a>
              <a href="/daily-car-rental-lahore/" class="block py-1 hover:text-white">Daily Rental</a>
              <a href="/monthly-car-rental-lahore/" class="block py-1 hover:text-white">Monthly Rental</a>
              <a href="/lahore-airport-car-rental/" class="block py-1 hover:text-white">Airport Rental</a>
              <a href="/fleet/buses-coasters/" class="block py-1 hover:text-white">Coasters & Buses</a>
            </div>
          </div>

          <!-- Accordion 2: Plan a Trip -->
          <div class="border-b border-slate-800 pb-2">
            <button
              type="button"
              class="w-full flex justify-between items-center py-2 text-left font-bold text-slate-100 focus:outline-none"
              data-accordion="acc-plan"
              aria-expanded="false"
            >
              <span>Plan a Trip</span>
              <span class="chevron text-slate-400 text-xs transition-transform">▼</span>
            </button>
            <div id="acc-plan" class="hidden pl-3 py-2 space-y-2 text-xs text-slate-300">
              <a href="/trip-planner/" class="block py-1 hover:text-white font-semibold text-amber-400">Trip Planner & Cost Estimator</a>
              <a href="/find-my-vehicle/" class="block py-1 hover:text-white">Find My Vehicle Fit</a>
              <a href="/compare-vehicles/" class="block py-1 hover:text-white">Vehicle Comparison</a>
              <a href="/routes/" class="block py-1 hover:text-white">Popular Pakistan Routes</a>
              <a href="/guides/" class="block py-1 hover:text-white">Destination Guides</a>
              <a href="/wedding-car-rental-lahore/" class="block py-1 hover:text-white">Wedding Transport</a>
            </div>
          </div>

          <!-- Accordion 3: Business & Groups -->
          <div class="border-b border-slate-800 pb-2">
            <button
              type="button"
              class="w-full flex justify-between items-center py-2 text-left font-bold text-slate-100 focus:outline-none"
              data-accordion="acc-business"
              aria-expanded="false"
            >
              <span>Business & Groups</span>
              <span class="chevron text-slate-400 text-xs transition-transform">▼</span>
            </button>
            <div id="acc-business" class="hidden pl-3 py-2 space-y-2 text-xs text-slate-300">
              <a href="/corporate-car-rental-lahore/" class="block py-1 hover:text-white font-semibold text-blue-400">Corporate Car Rental</a>
              <a href="/monthly-car-rental-lahore/" class="block py-1 hover:text-white">Monthly Business Fleet</a>
              <a href="/corporate-staff-pick-drop-lahore/" class="block py-1 hover:text-white">Staff Pick & Drop</a>
              <a href="/fleet/buses-coasters/" class="block py-1 hover:text-white">Coaster & Bus Rental</a>
              <a href="/tour-operator-transport-pakistan/" class="block py-1 hover:text-white">Tour Operators Transport</a>
            </div>
          </div>

          <!-- Accordion 4: Explore -->
          <div class="border-b border-slate-800 pb-2">
            <button
              type="button"
              class="w-full flex justify-between items-center py-2 text-left font-bold text-slate-100 focus:outline-none"
              data-accordion="acc-explore"
              aria-expanded="false"
            >
              <span>Explore</span>
              <span class="chevron text-slate-400 text-xs transition-transform">▼</span>
            </button>
