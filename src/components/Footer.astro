---
import { BUSINESS_INFO } from '../data/business';

const rentLinks = [
  { name: 'Vehicle Fleet', href: '/fleet/' },
  { name: 'Self Drive Cars', href: '/self-drive-car-rental-lahore/' },
  { name: 'Cars With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Daily Rentals', href: '/daily-car-rental-lahore/' },
  { name: 'Monthly Rentals', href: '/monthly-car-rental-lahore/' },
  { name: 'Airport Transfers', href: '/lahore-airport-car-rental/' },
];

const planLinks = [
  { name: 'Trip Planner', href: '/trip-planner/' },
  { name: 'Trip Cost Estimator', href: '/trip-planner/' },
  { name: 'Popular Routes', href: '/routes/' },
  { name: 'Service Locations', href: '/locations/' },
  { name: 'Find My Vehicle', href: '/find-my-vehicle/' },
];

const businessLinks = [
  { name: 'Corporate Car Rental', href: '/corporate-car-rental-lahore/' },
  { name: 'Business Rentals', href: '/business-car-rental-lahore/' },
  { name: 'Staff Pick & Drop', href: '/corporate-staff-pick-drop-lahore/' },
  { name: 'Buses & Coasters', href: '/fleet/buses-coasters/' },
  { name: 'Wedding Transport', href: '/wedding-car-rental-lahore/' },
  { name: 'Event Logistics', href: '/event-transport-lahore/' },
];

const learnLinks = [
  { name: 'Knowledge Hub Guides', href: '/guides/' },
  { name: 'Rental Terms & Rules', href: '/rental-terms/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Press Centre', href: '/press/' },
  { name: 'Customer Support', href: '/rental-support/' },
];

const companyLinks = [
  { name: 'About 4WHEELS', href: '/about/' },
  { name: 'Official Verification', href: '/official/' },
  { name: 'Official Locations', href: '/locations/official/' },
  { name: 'Website Sitemap', href: '/sitemap/' },
  { name: 'Contact Us', href: '/contact/' },
];
---

<footer class="bg-slate-50 text-slate-600 pt-14 pb-24 md:pb-14 border-t border-slate-200 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- 5-Column Desktop Layout / Mobile Accordion Groups -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">

      <!-- Column 1: Rent -->
      <div>
        <h3 class="text-slate-900 font-black text-sm mb-4 tracking-wider uppercase border-b border-slate-200 pb-2 text-red-600 flex items-center gap-1.5">
          <span>🚗 Rent</span>
        </h3>
        <ul class="space-y-2 text-xs">
          {rentLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-red-600 font-medium transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Plan -->
      <div>
        <h3 class="text-slate-900 font-black text-sm mb-4 tracking-wider uppercase border-b border-slate-200 pb-2 text-amber-600 flex items-center gap-1.5">
          <span>🧭 Plan</span>
        </h3>
        <ul class="space-y-2 text-xs">
          {planLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-amber-600 font-medium transition-colors flex items-center gap-1.5">
                <span class="text-amber-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Business -->
      <div>
        <h3 class="text-slate-900 font-black text-sm mb-4 tracking-wider uppercase border-b border-slate-200 pb-2 text-blue-600 flex items-center gap-1.5">
          <span>🏢 Business</span>
        </h3>
        <ul class="space-y-2 text-xs">
          {businessLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-blue-600 font-medium transition-colors flex items-center gap-1.5">
                <span class="text-blue-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Learn -->
      <div>
        <h3 class="text-slate-900 font-black text-sm mb-4 tracking-wider uppercase border-b border-slate-200 pb-2 text-emerald-600 flex items-center gap-1.5">
          <span>📚 Learn</span>
        </h3>
        <ul class="space-y-2 text-xs">
          {learnLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-emerald-600 font-medium transition-colors flex items-center gap-1.5">
                <span class="text-emerald-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 5: 4WHEELS Hub -->
      <div>
        <h3 class="text-slate-900 font-black text-sm mb-4 tracking-wider uppercase border-b border-slate-200 pb-2 flex items-center gap-1.5">
          <span>⚡ 4WHEELS</span>
        </h3>
        <ul class="space-y-2 text-xs mb-6">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-600 hover:text-slate-900 font-medium transition-colors flex items-center gap-1.5">
                <span class="text-slate-400 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-2 border-t border-slate-200 space-y-2">
          <a
            href="/booking/"
            class="block w-full bg-red-600 hover:bg-red-700 text-white font-extrabold py-2.5 px-4 rounded-xl text-center transition-all text-xs shadow-sm uppercase tracking-wider"
          >
            BOOK YOUR TRIP
          </a>
        </div>
      </div>

    </div>

    <!-- Official Contact Card Block -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-6 mb-8 text-xs text-slate-600 grid grid-cols-1 md:grid-cols-3 gap-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)]">
      <div>
        <p class="font-extrabold text-slate-900 text-sm mb-1 flex items-center gap-1.5">
          <span>📍 Head Office Branch</span>
        </p>
        <p class="text-slate-500 leading-relaxed font-medium">{BUSINESS_INFO.address.fullAddress}</p>
      </div>
      <div>
        <p class="font-extrabold text-slate-900 text-sm mb-1 flex items-center gap-1.5">
          <span>📞 Customer Care Line</span>
        </p>
        <a href={BUSINESS_INFO.telLink} class="text-red-600 font-bold hover:underline text-sm block">
          {BUSINESS_INFO.phoneDisplay}
        </a>
        <p class="text-slate-500 font-medium">Direct phone bookings & assistance</p>
      </div>
      <div>
        <p class="font-extrabold text-slate-900 text-sm mb-1 flex items-center gap-1.5">
          <span>💬 Official WhatsApp</span>
        </p>
        <a href={BUSINESS_INFO.whatsappGeneralLink} target="_blank" class="text-emerald-700 font-bold hover:underline text-sm block">
          Chat on WhatsApp
        </a>
        <p class="text-slate-500 font-medium">General support: "Hi 4WHEELS, I need assistance."</p>
      </div>
    </div>

    <!-- Bottom Copyright & Social -->
    <div class="pt-6 border-t border-slate-200 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <div>
        © {new Date().getFullYear()} {BUSINESS_INFO.name}. {BUSINESS_INFO.trustBadge}. All rights reserved.
      </div>
      <div class="flex items-center gap-4 font-medium">
        <a href={BUSINESS_INFO.facebookUrl} target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition-colors">
          Official Facebook
        </a>
        <span>•</span>
        <a href="/official/" class="hover:text-red-600 transition-colors">
          Verify Official Branch
        </a>
      </div>
    </div>

  </div>
</footer>
