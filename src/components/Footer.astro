---
import { BUSINESS_INFO } from '../data/business';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Rent a Car Lahore', href: '/rent-a-car-lahore/' },
  { name: 'Self Drive Cars', href: '/self-drive-car-rental-lahore/' },
  { name: 'Cars With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Airport Rental', href: '/lahore-airport-car-rental/' },
  { name: 'Monthly Rental', href: '/monthly-car-rental-lahore/' },
  { name: 'Corporate Rental', href: '/corporate-car-rental-lahore/' },
  { name: 'About Us', href: '/about/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Contact', href: '/contact/' },
];
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Business Overview -->
      <div>
        <div class="flex items-center space-x-2 mb-3">
          <span class="bg-red-600 text-white font-extrabold text-xl px-3 py-1 rounded tracking-wider">
            4WHEELS
          </span>
          <span class="text-sm font-bold text-white uppercase tracking-tight">Rent a Car</span>
        </div>
        <div class="inline-block bg-slate-800 text-red-400 text-xs font-semibold px-2.5 py-1 rounded mb-3 border border-slate-700">
          {BUSINESS_INFO.trustBadge}
        </div>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          Self-drive and with-driver car rental options in Lahore. Serving Johar Town, Lahore Airport, and all surrounding areas with reliable vehicles.
        </p>
        <div class="text-xs text-slate-400 leading-relaxed">
          📍 {BUSINESS_INFO.address.fullAddress}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide border-b border-slate-800 pb-2">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          {navLinks.slice(0, 5).map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Rental Services -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide border-b border-slate-800 pb-2">Rental Options</h3>
        <ul class="space-y-2 text-sm">
          {navLinks.slice(5).map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Direct Contact -->
      <div>
        <h3 class="text-white font-bold text-base mb-4 tracking-wide border-b border-slate-800 pb-2">Contact 4WHEELS</h3>
        <div class="space-y-3 text-sm">
          <p class="text-slate-400">
            Reach out via phone or WhatsApp to get the latest price quote and confirm vehicle availability.
          </p>
          <div class="pt-2">
            <a
              href={BUSINESS_INFO.telLink}
              class="block w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-2.5 px-4 rounded-lg text-center transition-colors border border-slate-700 mb-2"
            >
              📞 Call: {BUSINESS_INFO.phoneDisplay}
            </a>
            <a
              href={BUSINESS_INFO.whatsappPriceLink}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-lg text-center transition-colors"
            >
              💬 WhatsApp for Latest Price
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <div>
        © {new Date().getFullYear()} {BUSINESS_INFO.name}. {BUSINESS_INFO.trustBadge}. All rights reserved.
      </div>
      <div>
        Johar Town Phase 1, Lahore, Pakistan
      </div>
    </div>
  </div>
</footer>
