---
import { BUSINESS_INFO } from '../data/business';

const fleetLinks = [
  { name: 'Vehicle Fleet', href: '/fleet/' },
  { name: 'Self Drive Cars', href: '/self-drive-car-rental-lahore/' },
  { name: 'Cars With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Daily Rentals', href: '/daily-car-rental-lahore/' },
  { name: 'Monthly Rentals', href: '/monthly-car-rental-lahore/' },
  { name: 'Airport Transfers', href: '/lahore-airport-car-rental/' },
];

const commercialLinks = [
  { name: 'Business Rental', href: '/business-car-rental-lahore/' },
  { name: 'Corporate Fleet', href: '/corporate-car-rental-lahore/' },
  { name: 'Staff Pick & Drop', href: '/corporate-staff-pick-drop-lahore/' },
  { name: 'Wedding Transport', href: '/wedding-car-rental-lahore/' },
  { name: 'Event Logistics', href: '/event-transport-lahore/' },
  { name: 'Outstation Travel', href: '/outstation-car-rental-lahore/' },
  { name: 'Tour Operators', href: '/tour-operator-transport-pakistan/' },
];

const policyLinks = [
  { name: 'Rental Terms & Rules', href: '/rental-terms/' },
  { name: 'Customer Support', href: '/rental-support/' },
  { name: 'Trip Information', href: '/trip-information/' },
  { name: 'Knowledge Hub Guides', href: '/guides/' },
  { name: 'Service Locations', href: '/locations/' },
  { name: 'Official Locations', href: '/locations/official/' },
  { name: 'Verify 4WHEELS', href: '/official/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'About 4WHEELS', href: '/about/' },
  { name: 'Contact Us', href: '/contact/' },
];
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">

      <!-- Business Overview & Contact Details -->
      <div>
        <div class="flex items-center space-x-2 mb-3">
          <span class="bg-red-600 text-white font-extrabold text-xl px-3 py-1 rounded tracking-wider">
            4WHEELS
          </span>
          <span class="text-sm font-bold text-white uppercase tracking-tight">Rent a Car</span>
        </div>
        <div class="inline-block bg-slate-800 text-red-400 text-xs font-semibold px-2.5 py-1 rounded mb-3 border border-slate-700">
          {BUSINESS_INFO.trustBadge}
        </div>
        <p class="text-xs text-slate-400 mb-4 leading-relaxed">
          {BUSINESS_INFO.trustWording} Self-drive and chauffeur-driven car rentals across Lahore, Johar Town, and outstation trips.
        </p>
        <div class="space-y-1.5 text-xs text-slate-400 leading-relaxed border-t border-slate-800 pt-3">
          <div>📍 <strong>Address:</strong> {BUSINESS_INFO.address.fullAddress}</div>
          <div>📞 <strong>Phone:</strong> <a href={BUSINESS_INFO.telLink} class="text-slate-200 hover:text-red-400">{BUSINESS_INFO.phoneDisplay}</a></div>
          <div>💬 <strong>WhatsApp:</strong> <a href={BUSINESS_INFO.whatsappLink} target="_blank" class="text-slate-200 hover:text-emerald-400">{BUSINESS_INFO.phoneDisplay}</a></div>
          <div>✉️ <strong>Email:</strong> <a href={BUSINESS_INFO.mailtoLink} class="text-slate-200 hover:text-red-400">{BUSINESS_INFO.email}</a></div>
        </div>
      </div>

      <!-- Fleet & Services -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2">Vehicle Fleet</h3>
        <ul class="space-y-2 text-xs">
          {fleetLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Commercial & Specialty -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2">Business & Groups</h3>
        <ul class="space-y-2 text-xs">
          {commercialLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Policies & Direct Contact -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2">Policies & Support</h3>
        <ul class="space-y-2 text-xs mb-6">
          {policyLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-2 border-t border-slate-800">
          <a
            href={BUSINESS_INFO.whatsappPriceLink}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-4 rounded-lg text-center transition-colors text-xs"
          >
            💬 WhatsApp for Price Quote
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Social -->
    <div class="pt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <div>
        © {new Date().getFullYear()} {BUSINESS_INFO.name}. {BUSINESS_INFO.trustBadge}. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href={BUSINESS_INFO.facebookUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Official Facebook Page
        </a>
        <span>•</span>
        <span>Johar Town Phase 1, Lahore</span>
      </div>
    </div>
  </div>
</footer>
