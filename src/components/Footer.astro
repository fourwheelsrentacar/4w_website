---
import { BUSINESS_INFO } from '../data/business';

const rentLinks = [
  { name: 'Vehicle Fleet', href: '/fleet/' },
  { name: 'Self Drive Cars', href: '/self-drive-car-rental-lahore/' },
  { name: 'Cars With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Daily Rentals', href: '/daily-car-rental-lahore/' },
  { name: 'Monthly Rentals', href: '/monthly-car-rental-lahore/' },
  { name: 'Airport Transfers', href: '/lahore-airport-car-rental/' },
];

const planLinks = [
  { name: 'Trip Planner', href: '/trip-planner/' },
  { name: 'Trip Cost Estimator', href: '/trip-planner/' },
  { name: 'Popular Routes', href: '/routes/' },
  { name: 'Service Locations', href: '/locations/' },
  { name: 'Find My Vehicle', href: '/find-my-vehicle/' },
];

const businessLinks = [
  { name: 'Corporate Car Rental', href: '/corporate-car-rental-lahore/' },
  { name: 'Business Rentals', href: '/business-car-rental-lahore/' },
  { name: 'Staff Pick & Drop', href: '/corporate-staff-pick-drop-lahore/' },
  { name: 'Buses & Coasters', href: '/fleet/buses-coasters/' },
  { name: 'Wedding Transport', href: '/wedding-car-rental-lahore/' },
  { name: 'Event Logistics', href: '/event-transport-lahore/' },
];

const learnLinks = [
  { name: 'Knowledge Hub Guides', href: '/guides/' },
  { name: 'Rental Terms & Rules', href: '/rental-terms/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Press Centre', href: '/press/' },
  { name: 'Customer Support', href: '/rental-support/' },
];

const companyLinks = [
  { name: 'About 4WHEELS', href: '/about/' },
  { name: 'Official Verification', href: '/official/' },
  { name: 'Official Locations', href: '/locations/official/' },
  { name: 'Contact Us', href: '/contact/' },
];
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- 5-Column Desktop Layout / Mobile Accordion Groups -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">

      <!-- Column 1: Rent -->
      <div>
        <h3 class="text-white font-extrabold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2 text-red-500">
          Rent
        </h3>
        <ul class="space-y-2 text-xs">
          {rentLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Plan -->
      <div>
        <h3 class="text-white font-extrabold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2 text-amber-400">
          Plan
        </h3>
        <ul class="space-y-2 text-xs">
          {planLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
                <span class="text-amber-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Business -->
      <div>
        <h3 class="text-white font-extrabold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2 text-blue-400">
          Business
        </h3>
        <ul class="space-y-2 text-xs">
          {businessLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-blue-400 transition-colors flex items-center gap-1.5">
                <span class="text-blue-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Learn -->
      <div>
        <h3 class="text-white font-extrabold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2 text-emerald-400">
          Learn
        </h3>
        <ul class="space-y-2 text-xs">
          {learnLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
                <span class="text-emerald-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 5: 4WHEELS Hub -->
      <div>
        <h3 class="text-white font-extrabold text-sm mb-4 tracking-wide uppercase border-b border-slate-800 pb-2 text-slate-100">
          4WHEELS
        </h3>
        <ul class="space-y-2 text-xs mb-6">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors flex items-center gap-1.5">
                <span class="text-slate-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-2 border-t border-slate-800 space-y-2">
          <a
            href="/build-your-rental/"
            class="block w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-4 rounded-lg text-center transition-colors text-xs shadow-sm uppercase tracking-wider"
          >
            BOOK YOUR TRIP
          </a>
        </div>
      </div>

    </div>

    <!-- Official Contact Card Block -->
    <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 mb-8 text-xs text-slate-300 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <p class="font-extrabold text-white text-sm mb-1">📍 Head Office Branch</p>
        <p class="text-slate-400 leading-relaxed">{BUSINESS_INFO.address.fullAddress}</p>
      </div>
      <div>
        <p class="font-extrabold text-white text-sm mb-1">📞 Customer Care Line</p>
        <a href={BUSINESS_INFO.telLink} class="text-red-400 font-bold hover:underline text-sm block">
          {BUSINESS_INFO.phoneDisplay}
        </a>
        <p class="text-slate-400">Direct phone bookings & assistance</p>
      </div>
      <div>
        <p class="font-extrabold text-white text-sm mb-1">💬 Official WhatsApp</p>
        <a href={BUSINESS_INFO.whatsappGeneralLink} target="_blank" class="text-emerald-400 font-bold hover:underline text-sm block">
          Chat on WhatsApp
        </a>
        <p class="text-slate-400">General support: "Hi 4WHEELS, I need assistance."</p>
      </div>
    </div>

    <!-- Bottom Copyright & Social -->
    <div class="pt-6 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <div>
        © {new Date().getFullYear()} {BUSINESS_INFO.name}. {BUSINESS_INFO.trustBadge}. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href={BUSINESS_INFO.facebookUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Official Facebook
        </a>
        <span>•</span>
        <a href="/official/" class="hover:text-white transition-colors">
          Verify Official Branch
        </a>
      </div>
    </div>

  </div>
</footer>
