---
import { BUSINESS_INFO } from '../data/business';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Rent a Car Lahore', href: '/rent-a-car-lahore/' },
  { name: 'Self Drive Cars', href: '/self-drive-car-rental-lahore/' },
  { name: 'Cars With Driver', href: '/car-with-driver-lahore/' },
  { name: 'Airport Rental', href: '/lahore-airport-car-rental/' },
  { name: 'Monthly Rental', href: '/monthly-car-rental-lahore/' },
];

const knowledgeLinks = [
  { name: 'Car Rental Guide', href: '/blog/' },
  { name: 'Renting 101', href: '/blog/category/renting-101/' },
  { name: 'Choosing a Car', href: '/blog/category/choosing-a-car/' },
  { name: 'Rental Safety', href: '/blog/category/rental-safety/' },
];

const trustLinks = [
  { name: 'Verify 4WHEELS', href: '/verify-4wheels/' },
  { name: 'Public Notices', href: '/public-notices/' },
  { name: 'Editorial Policy', href: '/editorial-policy/' },
  { name: 'Press Centre', href: '/press/' },
  { name: 'Brand Guidelines', href: '/brand/' },
];
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Business Overview -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-2 mb-3">
          <span class="bg-red-600 text-white font-extrabold text-xl px-3 py-1 rounded tracking-wider">
            4WHEELS
          </span>
          <span class="text-sm font-bold text-white uppercase tracking-tight">Rent a Car</span>
        </div>
        <div class="inline-block bg-slate-800 text-red-400 text-xs font-semibold px-2.5 py-1 rounded mb-3 border border-slate-700">
          {BUSINESS_INFO.trustBadge}
        </div>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          Self-drive and with-driver car rental options in Lahore. Serving Johar Town, Lahore Airport, and all surrounding areas with reliable, clean vehicles.
        </p>
        <div class="text-xs text-slate-400 leading-relaxed">
          📍 {BUSINESS_INFO.address.fullAddress}
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide border-b border-slate-800 pb-2 uppercase">Services</h3>
        <ul class="space-y-2 text-xs">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Knowledge -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide border-b border-slate-800 pb-2 uppercase">Knowledge</h3>
        <ul class="space-y-2 text-xs">
          {knowledgeLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trust & Verification -->
      <div>
        <h3 class="text-white font-bold text-sm mb-4 tracking-wide border-b border-slate-800 pb-2 uppercase">Trust & Safety</h3>
        <ul class="space-y-2 text-xs">
          {trustLinks.map(link => (
            <li>
              <a href={link.href} class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                <span class="text-red-500 font-bold">›</span> {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Direct Contact CTA Banner -->
    <div class="bg-slate-950 rounded-2xl p-6 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4 mb-12">
      <div>
        <h4 class="text-white font-bold text-base">Direct Booking & Verification</h4>
        <p class="text-slate-400 text-xs">Official Phone / WhatsApp: <strong class="text-red-400 font-mono">{BUSINESS_INFO.phoneDisplay}</strong></p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={BUSINESS_INFO.telLink} class="px-4 py-2 bg-red-600 text-white font-bold text-xs rounded-lg hover:bg-red-700 transition">Call {BUSINESS_INFO.phoneDisplay}</a>
        <a href={BUSINESS_INFO.whatsappLink} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-emerald-600 text-white font-bold text-xs rounded-lg hover:bg-emerald-700 transition">WhatsApp Direct</a>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <div>
        © {new Date().getFullYear()} {BUSINESS_INFO.name}. {BUSINESS_INFO.trustBadge}. All rights reserved.
      </div>
      <div>
        Johar Town Phase 1, Lahore, Pakistan
      </div>
    </div>
  </div>
</footer>
