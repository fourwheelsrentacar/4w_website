---
import { getSeatLayoutBySlug } from '../data/seatLayouts';

const layout = getSeatLayoutBySlug('toyota-coaster');
---

<div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 space-y-6 shadow-xl">
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <span class="text-[10px] font-black uppercase tracking-widest text-red-500">INTERACTIVE SEAT & GROUP FIT MAP</span>
      <h3 class="text-xl font-black text-white">Toyota Coaster Saloon Executive (22-Seat)</h3>
    </div>
    <span class="text-xs font-bold bg-amber-500 text-slate-950 px-3 py-1 rounded-lg self-start sm:self-center">
      4WHEELS Customized Layout
    </span>
  </div>

  <p class="text-xs text-slate-300 leading-relaxed">
    Interactive seat map explaining 4WHEELS executive 22-seat saloon configuration. Hover or tap any seat to inspect capacity, position type, and legroom corridor.
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- Interactive SVG Container -->
    <div class="lg:col-span-7 bg-slate-950 rounded-2xl border border-slate-800 p-4 flex flex-col items-center relative overflow-hidden">

      <!-- Informational Seat Inspection Banner -->
      <div id="coaster-seat-inspector" class="w-full bg-slate-900 border border-slate-800 p-3 rounded-xl mb-4 flex items-center justify-between text-xs transition-all">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
          <span id="inspector-seat-no" class="font-black text-white">Select Any Seat</span>
        </div>
        <span id="inspector-seat-desc" class="text-slate-300 font-bold">Hover or tap a seat on diagram</span>
      </div>

      <!-- Inline Coaster Executive SVG Diagram -->
      <div class="w-full max-h-[580px] overflow-y-auto pr-1 scrollbar-thin flex justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 760" class="w-full max-w-[320px] h-auto drop-shadow-lg" role="img" aria-label="Toyota Coaster Saloon Executive 22-Seat Seating Diagram">
          <title>Toyota Coaster Saloon Executive 22-Seat Seating Diagram</title>

          <!-- Coaster Bus Body Outline -->
          <rect x="35" y="25" width="270" height="710" rx="28" fill="#0f172a" stroke="#dc2626" stroke-width="4"/>

          <!-- Front Road Header -->
          <text x="170" y="55" fill="#ef4444" font-size="12" font-weight="900" text-anchor="middle" letter-spacing="2">▲ FRONT / ROAD ▲</text>

          <!-- Front Cockpit -->
          <g transform="translate(185, 75)">
            <rect x="0" y="0" width="70" height="60" rx="8" fill="#7f1d1d" stroke="#ef4444" stroke-width="2" class="coaster-seat cursor-pointer" data-seat="01" data-type="Chauffeur / Driver Seat"/>
            <text x="35" y="35" fill="#fca5a5" font-size="9" font-weight="900" text-anchor="middle" class="pointer-events-none">DRIVER</text>
          </g>
          <g transform="translate(85, 75)">
            <rect x="0" y="0" width="60" height="60" rx="8" fill="#312e81" stroke="#6366f1" stroke-width="2" class="coaster-seat cursor-pointer" data-seat="G" data-type="Tour Guide / Co-Driver Seat"/>
            <text x="30" y="35" fill="#c7d2fe" font-size="9" font-weight="bold" text-anchor="middle" class="pointer-events-none">GUIDE</text>
          </g>

          <line x1="150" y1="150" x2="150" y2="590" stroke="#334155" stroke-width="2" stroke-dasharray="6 4"/>

          <!-- Row 1 -->
          <g transform="translate(50, 150)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="02" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 02</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="03" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 03</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="04" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 04</text>
          </g>

          <!-- Row 2 -->
          <g transform="translate(50, 220)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="05" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 05</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="06" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 06</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="07" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 07</text>
          </g>

          <!-- Row 3 -->
          <g transform="translate(50, 290)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="08" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 08</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="09" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 09</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="10" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 10</text>
          </g>

          <!-- Row 4 -->
          <g transform="translate(50, 360)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="11" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 11</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="12" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 12</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="13" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 13</text>
          </g>

          <!-- Row 5 -->
          <g transform="translate(50, 430)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="14" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 14</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="15" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 15</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="16" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 16</text>
          </g>

          <!-- Row 6 -->
          <g transform="translate(50, 500)">
            <rect x="0" y="0" width="55" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="17" data-type="Single Executive Recliner (Left)"/>
            <text x="27.5" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 17</text>

            <rect x="135" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="18" data-type="Double Executive Aisle Seat"/>
            <text x="161" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 18</text>

            <rect x="190" y="0" width="52" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="19" data-type="Window Executive Seat"/>
            <text x="216" y="33" fill="#93c5fd" font-size="9" font-weight="extrabold" text-anchor="middle" class="pointer-events-none">SEAT 19</text>
          </g>

          <!-- Rear Lounge Row -->
          <g transform="translate(50, 575)">
            <rect x="0" y="0" width="45" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="20" data-type="Rear Lounge Seat 1"/>
            <text x="22.5" y="33" fill="#93c5fd" font-size="8" font-weight="bold" text-anchor="middle" class="pointer-events-none">ST 20</text>

            <rect x="49" y="0" width="45" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="21" data-type="Rear Lounge Seat 2"/>
            <text x="71.5" y="33" fill="#93c5fd" font-size="8" font-weight="bold" text-anchor="middle" class="pointer-events-none">ST 21</text>

            <rect x="98" y="0" width="45" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="22" data-type="Rear Lounge Seat 3"/>
            <text x="120.5" y="33" fill="#93c5fd" font-size="8" font-weight="bold" text-anchor="middle" class="pointer-events-none">ST 22</text>

            <rect x="147" y="0" width="45" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="23" data-type="Rear Lounge Seat 4"/>
            <text x="169.5" y="33" fill="#93c5fd" font-size="8" font-weight="bold" text-anchor="middle" class="pointer-events-none">ST 23</text>

            <rect x="196" y="0" width="44" height="55" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="coaster-seat hover:fill-blue-900 cursor-pointer" data-seat="24" data-type="Rear Lounge Seat 5"/>
            <text x="218" y="33" fill="#93c5fd" font-size="8" font-weight="bold" text-anchor="middle" class="pointer-events-none">ST 24</text>
          </g>

          <g transform="translate(50, 645)">
            <rect x="0" y="0" width="240" height="75" rx="10" fill="#022c22" stroke="#10b981" stroke-dasharray="4 2" stroke-width="2"/>
            <text x="120" y="22" fill="#34d399" font-size="11" font-weight="900" text-anchor="middle" letter-spacing="1">HEAVY REAR LUGGAGE DECK</text>
            <text x="120" y="45" fill="#a7f3d0" font-size="10" font-weight="bold" text-anchor="middle">Approx. 12 - 15 Large Suitcases + Roof Rack Support</text>
          </g>
        </svg>
      </div>

      <div class="mt-3 text-[10px] text-slate-500 text-center italic">
        *Informational seating diagram only. Seats are not individually reserved online; capacity is reserved for your entire group.
      </div>
    </div>

    <!-- Right Side: Bus Capacity Specs & Group Fit Guidance -->
    <div class="lg:col-span-5 space-y-4">

      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-400 border-b border-slate-800 pb-2">
          Coaster Group Capacity Summary
        </h4>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
            <span class="text-[10px] text-slate-500 font-bold block uppercase">Maximum Occupants</span>
            <span class="text-2xl font-black text-white">22 Total</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">(21 Pax + 1 Chauffeur)</span>
          </div>

          <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
            <span class="text-[10px] text-slate-500 font-bold block uppercase">Aisle & Seating</span>
            <span class="text-xl font-black text-emerald-400">1 + 2 Saloon</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Wide Center Corridor</span>
          </div>
        </div>

        <div class="space-y-2 text-xs pt-1 text-slate-300">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-1.5">
            <span>Executive Leather Recliners</span>
            <span class="font-bold text-white">18 Seats</span>
          </div>
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-1.5">
            <span>Rear Lounge Seats</span>
            <span class="font-bold text-white">5 Seats</span>
          </div>
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-1.5">
            <span>Front Tour Guide Seat</span>
            <span class="font-bold text-indigo-400">1 Seat</span>
          </div>
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-1.5">
            <span>Dual High-Capacity Saloon AC</span>
            <span class="font-bold text-emerald-400">Included</span>
          </div>
        </div>
      </div>

      <!-- Luggage Deck Guidance -->
      <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-400 border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Coaster Baggage Allowance</span>
          <span class="text-[10px] font-bold text-emerald-400 bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800">
            GROUP BAGGAGE
          </span>
        </h4>

        <div class="flex items-center gap-3 bg-slate-900 p-3 rounded-xl border border-slate-800">
          <img src="/vehicles/seating/large-bag.svg" alt="Large Bags" class="w-8 h-8" />
          <div class="text-xs">
            <span class="font-black text-white block">12 to 15 Large Suitcases</span>
            <span class="text-slate-400 text-[11px]">Dedicated Rear Boot + Overhead Hand Baggage Racks</span>
          </div>
        </div>

        <p class="text-[11px] text-slate-400 leading-relaxed italic">
          "The 4WHEELS 22-seat executive saloon modification sacrifices 7 factory seats to maximize passenger legroom and expand rear trunk cargo space for weddings and tour groups."
        </p>
      </div>

      <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-[11px] text-slate-400">
        <strong>Source Verification:</strong> 4WHEELS Customized Executive Specification & Toyota Indus Official Coaster Datasheet.
      </div>

    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inspectorNo = document.getElementById('inspector-seat-no');
    const inspectorDesc = document.getElementById('inspector-seat-desc');

    const seats = document.querySelectorAll('.coaster-seat');
    seats.forEach(seat => {
      const updateInspector = () => {
        const no = seat.getAttribute('data-seat') || 'Seat';
        const type = seat.getAttribute('data-type') || 'Passenger Position';
        if (inspectorNo) inspectorNo.textContent = `Seat ${no}`;
        if (inspectorDesc) inspectorDesc.textContent = type;
      };

      seat.addEventListener('mouseenter', updateInspector);
      seat.addEventListener('click', updateInspector);
    });
  });
</script>
